// =====================================================================
// POLYGLOT - content/es.volt  ·  Spanish A1 (5 lessons)
// Written for learners with no Spanish. Each lesson: words, a grammar
// explanation that says WHY, and exercises that explain every answer.
// =====================================================================

// ---------- Lesson 1: Greetings and politeness ----------
defLesson("es", "es-a1-1", "A1", "First contact", 1, "Hello and thank you", "Greet people at any time of day and be polite.", "Why “buenos días” but “buenas noches”?", "Spanish greetings are short wishes: buenos días literally means “good days”. They are plural because you are wishing someone a whole day of good things. The ending of buenos/buenas must match the gender of the noun that follows it: días is masculine, so buenos; tardes and noches are feminine, so buenas. Learn the pairs as chunks and the endings will come naturally.", ["buenos + días|días is masculine and plural, so the adjective ends in -os.", "buenas + tardes / noches|tardes and noches are feminine and plural, so the adjective ends in -as.", "por favor / gracias|Say them freely: Spanish speakers use them often, and “de nada” (it is nothing) is the usual reply to thanks."], 12)
defWord("es", "es-a1-1", "hola", "OH-lah", "hello", "Hola, ¿qué tal?", "Hello, how are you?", "greetings", 1)
defWord("es", "es-a1-1", "buenos días", "BWEH-nohs DEE-ahs", "good morning", "Buenos días, señor.", "Good morning, sir.", "greetings", 1)
defWord("es", "es-a1-1", "buenas tardes", "BWEH-nahs TAR-dehs", "good afternoon", "Buenas tardes, señora.", "Good afternoon, madam.", "greetings", 1)
defWord("es", "es-a1-1", "buenas noches", "BWEH-nahs NOH-chehs", "good evening / good night", "Buenas noches, mamá.", "Good night, mum.", "greetings", 1)
defWord("es", "es-a1-1", "adiós", "ah-DYOHS", "goodbye", "Adiós, hasta mañana.", "Goodbye, see you tomorrow.", "greetings", 1)
defWord("es", "es-a1-1", "por favor", "por fah-VOR", "please", "Un café, por favor.", "A coffee, please.", "politeness", 1)
defWord("es", "es-a1-1", "gracias", "GRAH-syahs", "thank you", "Muchas gracias.", "Thank you very much.", "politeness", 1)
defWord("es", "es-a1-1", "de nada", "deh NAH-dah", "you're welcome", "—Gracias. —De nada.", "“Thanks.” “You're welcome.”", "politeness", 1)
defEx("es", "es-a1-1", "choice", "What does “gracias” mean?", "thank you", ["thank you", "please", "goodbye", "hello"], "Gracias = thank you. Por favor is please, and adiós is goodbye.", "gracias")
defEx("es", "es-a1-1", "choice", "Which greeting fits 9 a.m.?", "Buenos días", ["Buenos días", "Buenas noches", "Adiós", "De nada"], "Días means “days” and is used until about lunchtime. Noches is for evening and night; adiós says goodbye rather than hello.", "")
defEx("es", "es-a1-1", "match", "Match each word with its meaning", "", ["hola=hello", "adiós=goodbye", "gracias=thank you", "por favor=please"], "These four are the most useful words in any Spanish conversation.", "")
defEx("es", "es-a1-1", "fill", "Buenas ___. (good afternoon)", "tardes", ["tardes", "días", "noches"], "Tardes means “afternoons”. It is feminine, so it takes buenas. Días is masculine and would need buenos, and noches is night.", "Buenas tardes")
defEx("es", "es-a1-1", "fill", "—Gracias. —De ___.", "nada", ["nada", "favor", "tardes"], "“De nada” (literally “of nothing”) is the standard answer to thanks, like “it's nothing”. Por favor means please.", "De nada")
defEx("es", "es-a1-1", "translate", "Type “please” in Spanish", "por favor", [], "Please = por favor, two words. It goes at the end: “Un café, por favor.”", "")
defEx("es", "es-a1-1", "translate", "Type “thank you” in Spanish", "gracias", [], "Gracias is thank you. Add muchas for “thank you very much”.", "")
defEx("es", "es-a1-1", "arrange", "Build: Good night", "Buenas noches", ["Buenas", "noches"], "Buenas goes first and ends in -as because noches is feminine.", "")
defEx("es", "es-a1-1", "listen", "", "Good morning", ["Good morning", "Good night", "Goodbye"], "You heard “buenos días”: buenos = good, días = days, so the greeting for the morning.", "Buenos días")
defEx("es", "es-a1-1", "speak", "Say the “d” in tardes softly: TAR-des.", "Good afternoon", [], "Buenas tardes is used from lunchtime until it gets dark.", "Buenas tardes")
defEx("es", "es-a1-1", "convo", "At a café", "", ["Buenos días.|Good morning.|Buenos días.|Buenas noches.|Adiós.|Return the same greeting. Noches is for night, and adiós means goodbye.", "Aquí tiene su café.|Here is your coffee.|Gracias.|Adiós.|Buenas noches.|When someone hands you something, you thank them.", "De nada.|You're welcome.|Adiós.|Buenas noches.|Hola.|The conversation is over, so you say goodbye with adiós."], "You greeted, thanked and said goodbye: a complete polite exchange.", "")

// ---------- Lesson 2: Introducing yourself ----------
defLesson("es", "es-a1-2", "A1", "First contact", 2, "Who are you?", "Say your name, where you are from, and ask the same of someone else.", "“Ser”: the verb for who you are", "Spanish has two verbs for “to be”. Ser describes identity: who you are, where you are from, your job. Its forms change with the person: soy (I am), eres (you are), es (he/she is). Because each form already tells you who is speaking, Spanish usually drops the pronoun: say “Soy Ana”, not “Yo soy Ana”, unless you want to stress yourself. “Me llamo” literally means “I call myself”, which is why the name follows directly.", ["soy|I am. The -oy ending marks the first person: soy estudiante.", "eres|You are (informal, to a friend). Used with tú.", "es|He, she or it is.", "me llamo + name|“I call myself …”: the normal way to say your name."], 14)
defWord("es", "es-a1-2", "me llamo", "meh YAH-moh", "my name is", "Me llamo Ana.", "My name is Ana.", "introductions", 1)
defWord("es", "es-a1-2", "¿cómo te llamas?", "KOH-moh teh YAH-mahs", "what is your name?", "Hola, ¿cómo te llamas?", "Hi, what's your name?", "introductions", 1)
defWord("es", "es-a1-2", "mucho gusto", "MOO-choh GOOS-toh", "nice to meet you", "Mucho gusto, Luis.", "Nice to meet you, Luis.", "introductions", 1)
defWord("es", "es-a1-2", "soy", "soy", "I am", "Soy estudiante.", "I am a student.", "verbs", 1)
defWord("es", "es-a1-2", "eres", "EH-rehs", "you are", "¿Eres profesor?", "Are you a teacher?", "verbs", 1)
defWord("es", "es-a1-2", "¿de dónde eres?", "deh DOHN-deh EH-rehs", "where are you from?", "¿De dónde eres?", "Where are you from?", "introductions", 2)
defWord("es", "es-a1-2", "soy de", "soy deh", "I am from", "Soy de México.", "I am from Mexico.", "introductions", 1)
defWord("es", "es-a1-2", "estudiante", "ehs-too-DYAHN-teh", "student", "Soy estudiante.", "I am a student.", "people", 1)
defEx("es", "es-a1-2", "choice", "What does “mucho gusto” mean?", "nice to meet you", ["nice to meet you", "thank you very much", "good morning", "where are you from"], "Mucho gusto literally says “much pleasure”: you are pleased to meet the person.", "mucho gusto")
defEx("es", "es-a1-2", "choice", "Which word means “I am”?", "soy", ["soy", "eres", "es", "hola"], "Soy is the first-person form of ser. Eres is “you are”, and es is “he/she is”.", "")
defEx("es", "es-a1-2", "fill", "Yo ___ estudiante.", "soy", ["soy", "eres", "es"], "Yo means I, so the verb must be soy. Eres would go with tú (you).", "Yo soy estudiante")
defEx("es", "es-a1-2", "fill", "Tú ___ de México.", "eres", ["eres", "soy", "es"], "Tú means “you”, so the verb is eres.", "Tú eres de México")
defEx("es", "es-a1-2", "match", "Match the forms of ser", "", ["soy=I am", "eres=you are", "es=he/she is", "me llamo=my name is"], "Ser changes its ending with the person. Me llamo is a fixed phrase for names.", "")
defEx("es", "es-a1-2", "translate", "Say “I am a student” in Spanish", "soy estudiante", [], "The pronoun yo is optional because soy already means “I am”.", "yo soy estudiante|soy un estudiante|soy una estudiante")
defEx("es", "es-a1-2", "translate", "Say “My name is Ana” in Spanish", "me llamo ana", [], "Me llamo + name. Spanish does not use ser for names; it uses the reflexive “llamarse”.", "")
defEx("es", "es-a1-2", "arrange", "Build: What is your name?", "¿Cómo te llamas?", ["¿Cómo", "te", "llamas?"], "Cómo (how) + te (yourself) + llamas (you call): “how do you call yourself?”.", "")
defEx("es", "es-a1-2", "listen", "", "Where are you from?", ["Where are you from?", "What is your name?", "Nice to meet you"], "¿De dónde eres? — de = from, dónde = where, eres = you are.", "¿De dónde eres?")
defEx("es", "es-a1-2", "speak", "Stress the second syllable: gus-to.", "Nice to meet you", [], "Mucho gusto: the “ch” sounds like English “ch”, and the “g” in gusto is hard like “go”.", "Mucho gusto")
defEx("es", "es-a1-2", "read", "Ana introduces herself", "Ana says her name, where she is from and that she is a student.", ["Ana says her name, where she is from and that she is a student.", "Ana asks a stranger where the station is.", "Ana orders food in a café."], "Me llamo Ana = my name is Ana; soy de México = I am from Mexico; soy estudiante = I am a student.", "Hola. Me llamo Ana. Soy de México. Soy estudiante.")
defEx("es", "es-a1-2", "convo", "Meeting someone new", "", ["Hola, ¿cómo te llamas?|Hi, what's your name?|Me llamo Sam.|Soy de Sam.|Mucho gusto.|Use “me llamo” to give your name.", "Mucho gusto. ¿De dónde eres?|Nice to meet you. Where are you from?|Soy de Canadá.|Me llamo Canadá.|Eres de Canadá.|Soy de + place says where you are from.", "¡Qué bien! Adiós.|Great! Goodbye.|Adiós. Mucho gusto.|Me llamo Sam.|Soy estudiante.|You close with goodbye and a polite word."], "You introduced yourself and said where you are from.", "")

// ---------- Lesson 3: Food and drink ----------
defLesson("es", "es-a1-3", "A1", "Everyday life", 3, "At the café", "Order food and drink politely.", "Nouns have gender: el / la, un / una", "Every Spanish noun is masculine or feminine, and the little word before it has to agree. “The” is el for masculine and la for feminine; “a” is un or una. Most nouns ending in -o are masculine (el pan) and most ending in -a are feminine (la leche), so the ending is a good clue. Watch for el agua: agua is feminine, but it takes el because the stressed a- sound would clash with la. Say “Quiero un café” (I want a coffee) or add por favor to be polite.", ["el / un|Masculine: el café, un café.", "la / una|Feminine: la leche, una manzana.", "el agua|Feminine noun with el for sound reasons; the adjective would still be feminine.", "quiero + noun|“I want …”. Add por favor to order politely."], 15)
defWord("es", "es-a1-3", "el café", "el kah-FEH", "coffee", "Quiero un café.", "I want a coffee.", "food", 1)
defWord("es", "es-a1-3", "el agua", "el AH-gwah", "water", "Quiero agua, por favor.", "I want water, please.", "food", 1)
defWord("es", "es-a1-3", "el pan", "el pahn", "bread", "El pan es bueno.", "The bread is good.", "food", 1)
defWord("es", "es-a1-3", "la leche", "lah LEH-cheh", "milk", "Quiero una leche.", "I want a milk.", "food", 1)
defWord("es", "es-a1-3", "la manzana", "lah mahn-SAH-nah", "apple", "Una manzana, por favor.", "An apple, please.", "food", 1)
defWord("es", "es-a1-3", "quiero", "KYEH-roh", "I want", "Quiero un café.", "I want a coffee.", "verbs", 1)
defWord("es", "es-a1-3", "la cuenta", "lah KWEHN-tah", "the bill", "La cuenta, por favor.", "The bill, please.", "restaurant", 1)
defWord("es", "es-a1-3", "tengo hambre", "TEHN-goh AHM-breh", "I am hungry", "Tengo hambre. Quiero pan.", "I'm hungry. I want bread.", "restaurant", 2)
defEx("es", "es-a1-3", "choice", "What does “la leche” mean?", "milk", ["milk", "water", "bread", "apple"], "La leche is milk. Leche ends in -e, so you must learn its gender (feminine).", "la leche")
defEx("es", "es-a1-3", "choice", "Which article goes with “pan”?", "el", ["el", "la"], "Pan is masculine, so el pan. The -a ending in la belongs to feminine nouns like leche.", "")
defEx("es", "es-a1-3", "fill", "Quiero ___ café, por favor. (a)", "un", ["un", "una", "la"], "Café is masculine, so “a” is un. Una is for feminine nouns; la means “the”.", "Quiero un café, por favor")
defEx("es", "es-a1-3", "fill", "Quiero ___ leche, por favor. (a)", "una", ["una", "un", "el"], "Leche is feminine, so “a” is una.", "Quiero una leche, por favor")
defEx("es", "es-a1-3", "match", "Match food and drink to meaning", "", ["el café=coffee", "el pan=bread", "la leche=milk", "la manzana=apple"], "Notice the article: el for café and pan, la for leche and manzana.", "")
defEx("es", "es-a1-3", "translate", "Say “I want water” in Spanish", "quiero agua", [], "Quiero + noun. Agua often has no article when you order it in general.", "quiero el agua|quiero un agua|quiero agua por favor")
defEx("es", "es-a1-3", "translate", "Say “the bill” in Spanish", "la cuenta", [], "Cuenta ends in -a and is feminine, so la cuenta.", "")
defEx("es", "es-a1-3", "arrange", "Build: I want bread, please", "Quiero pan por favor", ["Quiero", "pan", "por favor"], "Verb first, then the thing you want, then por favor to finish politely.", "")
defEx("es", "es-a1-3", "listen", "", "I'm hungry", ["I'm hungry", "I want coffee", "The bill, please"], "Tengo hambre literally says “I have hunger”: Spanish uses tener (to have) for hunger.", "Tengo hambre")
defEx("es", "es-a1-3", "speak", "Roll the soft “r” lightly in “quiero” and “por”.", "I want a coffee, please", [], "Quiero un café, por favor: the stress in café is on the last syllable, which is why it carries an accent.", "Quiero un café, por favor")
defEx("es", "es-a1-3", "read", "At the café", "Someone orders coffee, bread and water, then asks for the bill.", ["Someone orders coffee, bread and water, then asks for the bill.", "Someone introduces their family.", "Someone asks for directions to a hotel."], "Quiero un café y pan = I want a coffee and bread; la cuenta, por favor = the bill, please.", "Buenas tardes. Quiero un café y pan. Quiero agua, por favor. La cuenta, por favor.")
defEx("es", "es-a1-3", "convo", "Ordering", "", ["Buenas tardes. ¿Qué quiere?|Good afternoon. What would you like?|Quiero un café, por favor.|De nada.|Mucho gusto.|You answer with quiero + what you want.", "¿Algo más?|Anything else?|Quiero pan, por favor.|Soy estudiante.|Buenos días.|Say what else you want with quiero.", "Aquí tiene.|Here you are.|Gracias.|Quiero.|Me llamo Ana.|When something is handed to you, you thank them."], "You ordered food politely using quiero and por favor.", "")

// ---------- Lesson 4: Family ----------
defLesson("es", "es-a1-4", "A1", "Everyday life", 4, "My family", "Talk about your family and say what you have.", "“Mi” and “mis”: possessives agree in number", "Possessive words (my, your) come before the noun in Spanish. Mi and tu only change for number: mi hermano, mis hermanos. Unlike el and la, mi does not care about gender: it is mi madre and mi padre. To say what you have, use tengo (I have) plus the noun: “Tengo una hermana”. Spanish drops the pronoun yo because tengo already means “I have”.", ["mi / mis|My. Use mi with one thing and mis with several: mi hermano, mis hermanos.", "tengo + noun|I have …: tengo una hermana.", "los padres|Means parents. The masculine plural covers a father and a mother together."], 14)
defWord("es", "es-a1-4", "la familia", "lah fah-MEE-lyah", "family", "Mi familia es grande.", "My family is big.", "family", 1)
defWord("es", "es-a1-4", "la madre", "lah MAH-dreh", "mother", "Mi madre es profesora.", "My mother is a teacher.", "family", 1)
defWord("es", "es-a1-4", "el padre", "el PAH-dreh", "father", "Mi padre es de México.", "My father is from Mexico.", "family", 1)
defWord("es", "es-a1-4", "el hermano", "el ehr-MAH-noh", "brother", "Tengo un hermano.", "I have a brother.", "family", 1)
defWord("es", "es-a1-4", "la hermana", "lah ehr-MAH-nah", "sister", "Tengo una hermana.", "I have a sister.", "family", 1)
defWord("es", "es-a1-4", "los padres", "lohs PAH-drehs", "parents", "Mis padres son de México.", "My parents are from Mexico.", "family", 2)
defWord("es", "es-a1-4", "mi", "mee", "my", "Mi familia.", "My family.", "grammar", 1)
defWord("es", "es-a1-4", "tengo", "TEHN-goh", "I have", "Tengo una familia.", "I have a family.", "verbs", 1)
defEx("es", "es-a1-4", "choice", "What does “la hermana” mean?", "sister", ["sister", "brother", "mother", "parents"], "Hermana ends in -a: the feminine form. Hermano ends in -o: brother.", "la hermana")
defEx("es", "es-a1-4", "choice", "Which means “my brothers”?", "mis hermanos", ["mis hermanos", "mi hermanos", "mi hermano", "mis hermano"], "Hermanos is plural, so the possessive must be plural too: mis. Mi is for one thing.", "")
defEx("es", "es-a1-4", "fill", "Tengo una ___. (sister)", "hermana", ["hermana", "hermano", "padre"], "Una is feminine, so the noun must be feminine: hermana.", "Tengo una hermana")
defEx("es", "es-a1-4", "fill", "___ padres son de México. (my)", "Mis", ["Mis", "Mi", "Una"], "Padres is plural, so “my” is mis.", "Mis padres son de México")
defEx("es", "es-a1-4", "match", "Match the family words", "", ["la madre=mother", "el padre=father", "el hermano=brother", "la familia=family"], "El / la show gender: father and brother are masculine; mother and family are feminine.", "")
defEx("es", "es-a1-4", "translate", "Say “my family” in Spanish", "mi familia", [], "Mi stays the same for masculine and feminine; it only changes for plural.", "")
defEx("es", "es-a1-4", "translate", "Say “I have a sister” in Spanish", "tengo una hermana", [], "Tengo already means “I have”; una agrees with hermana.", "yo tengo una hermana")
defEx("es", "es-a1-4", "arrange", "Build: I have a brother", "Tengo un hermano", ["Tengo", "un", "hermano"], "Verb, article, noun. Un matches the masculine hermano.", "")
defEx("es", "es-a1-4", "listen", "", "I have a sister", ["I have a sister", "I have a brother", "I have a family"], "Una hermana is feminine: sister.", "Tengo una hermana")
defEx("es", "es-a1-4", "speak", "The “h” in hermana is silent.", "I have a sister", [], "Tengo una hermana: remember that h is never pronounced in Spanish.", "Tengo una hermana")
defEx("es", "es-a1-4", "read", "Luis and his family", "Luis talks about his name, his siblings and his parents.", ["Luis talks about his name, his siblings and his parents.", "Luis orders food at a café.", "Luis says goodbye to a teacher."], "Tengo una hermana y un hermano = I have a sister and a brother. Son is the plural of es: mi madre y mi padre son = my mother and father are.", "Me llamo Luis. Tengo una hermana y un hermano. Mi madre y mi padre son de México.")
defEx("es", "es-a1-4", "choice", "Which one is correct?", "mi madre", ["mi madre", "mis madre", "me madre"], "Madre is singular, so mi. Possessives never change for gender.", "")

// ---------- Lesson 5: Getting around ----------
defLesson("es", "es-a1-5", "A1", "Getting around", 5, "Where is it?", "Ask where something is and understand simple directions.", "“Estar”: the verb for where things are", "Besides ser, Spanish has estar. Use ser for who or what something is and estar for where it is. “¿Dónde está el hotel?” asks “Where is the hotel?”. Está is the he/she/it form, so it goes with a single thing; for several things you will later meet están. Directions use a: a la derecha (to the right) and a la izquierda (to the left), both with la because they are feminine. “Todo recto” means straight on.", ["¿Dónde está + el/la + noun?|Where is …? Está because we are asking about location.", "a la derecha / a la izquierda|To the right / to the left.", "todo recto|Straight ahead.", "cerca|Near. “La estación está cerca”: the station is near."], 15)
defWord("es", "es-a1-5", "¿dónde está…?", "DOHN-deh ehs-TAH", "where is…?", "¿Dónde está el hotel?", "Where is the hotel?", "directions", 1)
defWord("es", "es-a1-5", "la calle", "lah KAH-yeh", "street", "El hotel está en la calle Sol.", "The hotel is on Sol Street.", "places", 1)
defWord("es", "es-a1-5", "la estación", "lah ehs-tah-SYOHN", "station", "La estación está cerca.", "The station is near.", "places", 1)
defWord("es", "es-a1-5", "el hotel", "el oh-TEHL", "hotel", "¿Dónde está el hotel?", "Where is the hotel?", "places", 1)
defWord("es", "es-a1-5", "a la derecha", "ah lah deh-REH-chah", "to the right", "El hotel está a la derecha.", "The hotel is on the right.", "directions", 1)
defWord("es", "es-a1-5", "a la izquierda", "ah lah ees-KYEHR-dah", "to the left", "La calle está a la izquierda.", "The street is on the left.", "directions", 2)
defWord("es", "es-a1-5", "todo recto", "TOH-doh REHK-toh", "straight ahead", "Todo recto y a la derecha.", "Straight ahead then right.", "directions", 2)
defWord("es", "es-a1-5", "cerca", "SEHR-kah", "near", "La estación está cerca.", "The station is near.", "directions", 1)
defEx("es", "es-a1-5", "choice", "What does “a la izquierda” mean?", "to the left", ["to the left", "to the right", "straight ahead", "near"], "Izquierda = left; derecha = right. Both come after “a la”.", "a la izquierda")
defEx("es", "es-a1-5", "choice", "Which asks “Where is the station?”", "¿Dónde está la estación?", ["¿Dónde está la estación?", "¿Cómo te llamas?", "¿De dónde eres?"], "Dónde = where. “¿De dónde eres?” asks where you are from, not where something is.", "")
defEx("es", "es-a1-5", "fill", "¿Dónde ___ el hotel?", "está", ["está", "soy", "eres"], "For the location of a thing you need estar. Está is the form for one thing (it).", "¿Dónde está el hotel?")
defEx("es", "es-a1-5", "fill", "El hotel está a la ___. (right)", "derecha", ["derecha", "izquierda", "calle"], "A la derecha means to the right. Izquierda would be left.", "El hotel está a la derecha")
defEx("es", "es-a1-5", "match", "Match places and directions", "", ["la calle=street", "la estación=station", "cerca=near", "todo recto=straight ahead"], "Learn directions as chunks: todo recto, a la derecha, a la izquierda.", "")
defEx("es", "es-a1-5", "translate", "Say “straight ahead” in Spanish", "todo recto", [], "Todo recto is the usual phrase; todo derecho is also common in Latin America.", "todo derecho|recto")
defEx("es", "es-a1-5", "translate", "Say “Where is the hotel?” in Spanish", "dónde está el hotel", [], "Dónde está + el hotel. Está agrees with the single thing.", "donde esta el hotel")
defEx("es", "es-a1-5", "arrange", "Build: The station is near", "La estación está cerca", ["La", "estación", "está", "cerca"], "Subject (la estación), verb (está), then the place word (cerca).", "")
defEx("es", "es-a1-5", "listen", "", "Straight ahead and to the right", ["Straight ahead and to the right", "Left and then near", "The hotel is near"], "Todo recto y a la derecha: go straight on, then right.", "Todo recto y a la derecha")
defEx("es", "es-a1-5", "speak", "The “rr” is a short trill; “recto” starts with it.", "Where is the station?", [], "¿Dónde está la estación? The accent on dónde marks it as a question word.", "¿Dónde está la estación?")
defEx("es", "es-a1-5", "read", "Finding the hotel", "Directions to a hotel and a station.", ["Directions to a hotel and a station.", "A family introduction.", "A restaurant order."], "El hotel está en la calle Sol = the hotel is on Sol Street; todo recto y a la izquierda = straight ahead and left.", "El hotel está en la calle Sol. La estación está cerca. Está todo recto y a la izquierda.")
defEx("es", "es-a1-5", "convo", "Asking for directions", "", ["Hola. ¿Necesita ayuda?|Hi. Do you need help?|Sí. ¿Dónde está la estación?|Sí. ¿Cómo te llamas?|Quiero un café.|Sí means yes; you then ask where the station is.", "Está a la derecha.|It's on the right.|Gracias.|Mucho gusto.|Quiero pan.|You thank them for the answer.", "De nada. Adiós.|You're welcome. Goodbye.|Adiós.|Me llamo Ana.|Tengo hambre.|You close the exchange by saying goodbye."], "You asked for directions and finished politely.", "")

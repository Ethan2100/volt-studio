// =====================================================================

// ---------- Lesson 1: Greetings and politeness ----------
defLesson("nl", "nl-a1-1", "A1", "First contact", 1, "Hello and thank you", "Greet people at any time of day and be polite.", "Why “goede” in goedemorgen?", "Dutch greetings are written as one word: goedemorgen, goedemiddag, goedenavond, goedenacht. They began as wishes: “[Ik wens je een] goede morgen”. Dutch adjectives take an -e before most nouns, which is why the greeting contains goede, not goed. The -n you see in goedenavond and goedenacht is a leftover from older Dutch grammar; just learn it as part of the word. Dutch also keeps two ways of saying please: alsjeblieft (informal, with je) and alstublieft (formal, with u). Alsjeblieft also means “here you are” when you hand someone something.", ["goede + morgen|Adjectives take -e before a noun: goede morgen, written goedemorgen.", "goedenavond / goedenacht|The -n is a historical leftover. Learn the spelling as it is.", "alsjeblieft|Please, or “here you go” when handing something over. Formal: alstublieft.", "dank je wel|Thank you. Shorter: dank je, or bedankt."], 12)
defWord("nl", "nl-a1-1", "hallo", "HAH-loh", "hello", "Hallo, hoe gaat het?", "Hello, how are you?", "greetings", 1)
defWord("nl", "nl-a1-1", "goedemorgen", "KHOO-duh-MOR-khuh", "good morning", "Goedemorgen, mevrouw.", "Good morning, madam.", "greetings", 1)
defWord("nl", "nl-a1-1", "goedemiddag", "KHOO-duh-MID-dakh", "good afternoon", "Goedemiddag, meneer.", "Good afternoon, sir.", "greetings", 1)
defWord("nl", "nl-a1-1", "goedenavond", "KHOO-duh-NAH-vont", "good evening", "Goedenavond, Anna.", "Good evening, Anna.", "greetings", 1)
defWord("nl", "nl-a1-1", "goedenacht", "KHOO-duh-NAKHT", "good night", "Goedenacht, mama.", "Good night, mum.", "greetings", 1)
defWord("nl", "nl-a1-1", "doei", "dooy", "bye", "Doei, tot morgen!", "Bye, see you tomorrow!", "greetings", 1)
defWord("nl", "nl-a1-1", "alsjeblieft", "AL-shuh-bleeft", "please / here you are", "Een koffie, alsjeblieft.", "A coffee, please.", "politeness", 2)
defWord("nl", "nl-a1-1", "dank je wel", "dank yuh vel", "thank you", "Dank je wel!", "Thank you!", "politeness", 1)
defEx("nl", "nl-a1-1", "choice", "What does “dank je wel” mean?", "thank you", ["thank you", "please", "goodbye", "hello"], "Dank je wel = thank you. Alsjeblieft is please, and doei is bye.", "dank je wel")
defEx("nl", "nl-a1-1", "choice", "Which greeting is for the evening?", "Goedenavond", ["Goedenavond", "Goedemorgen", "Goedenacht", "Doei"], "Avond means evening. Goedemorgen is morning, and goedenacht is for going to bed.", "")
defEx("nl", "nl-a1-1", "match", "Match each word with its meaning", "", ["hallo=hello", "doei=bye", "dank je wel=thank you", "alsjeblieft=please"], "Four words you will use every day.", "")
defEx("nl", "nl-a1-1", "fill", "Goede___! (good morning)", "morgen", ["morgen", "nacht", "doei"], "Goede + morgen is written as one word: goedemorgen. Nacht would give goedenacht (good night).", "Goedemorgen")
defEx("nl", "nl-a1-1", "fill", "Goeden___! (good evening)", "avond", ["avond", "morgen", "middag"], "Avond means evening: goedenavond. Middag is afternoon, and morgen is morning.", "Goedenavond")
defEx("nl", "nl-a1-1", "translate", "Type “thank you” in Dutch", "dank je wel", [], "Dank je wel. You can shorten it to dank je, or say bedankt.", "dank je|bedankt|dankjewel|dank u wel")
defEx("nl", "nl-a1-1", "translate", "Type “please” in Dutch", "alsjeblieft", [], "Alsjeblieft is please. Use alstublieft with someone you address as u.", "alstublieft|alsjeblief")
defEx("nl", "nl-a1-1", "arrange", "Build: Thank you", "Dank je wel", ["Dank", "je", "wel"], "Dank (thanks) + je (you) + wel (well): the three words go in this order.", "")
defEx("nl", "nl-a1-1", "listen", "", "Good morning", ["Good morning", "Good night", "Goodbye"], "Goedemorgen is the greeting for the morning.", "Goedemorgen")
defEx("nl", "nl-a1-1", "speak", "Dutch “g” is a throaty “kh” sound, like clearing your throat gently.", "Good morning", [], "Goedemorgen: the “oe” sounds like English “oo”, and the g is the throaty Dutch g.", "Goedemorgen")
defRead("nl", "nl-a1-1", "A polite exchange", "Goedemorgen! Dank je wel. Alsjeblieft. Doei!", ["Two people greet each other, thank each other and say goodbye.", "Someone asks for directions to the station.", "Someone orders coffee and bread."], "Goedemorgen = good morning; dank je wel = thanks; alsjeblieft = here you are; doei = bye.")
defEx("nl", "nl-a1-1", "convo", "At the bakery", "", ["Goedemorgen!|Good morning!|Goedemorgen!|Goedenacht!|Doei!|Return the greeting. Goedenacht is for bedtime and doei is goodbye.", "Alsjeblieft.|Here you are.|Dank je wel.|Doei.|Goedenacht.|When something is handed to you, thank them.", "Graag gedaan. Doei!|You're welcome. Bye!|Doei!|Goedemorgen!|Hallo!|Finish with the matching goodbye."], "You greeted, thanked and said goodbye politely.", "")

// ---------- Lesson 2: Introducing yourself ----------
defLesson("nl", "nl-a1-2", "A1", "First contact", 2, "Who are you?", "Say your name and where you are from.", "“Zijn”: the verb for being", "The Dutch verb zijn (to be) is irregular: ik ben (I am), jij bent (you are), hij/zij is (he/she is). Dutch keeps the pronoun, and the verb takes the second place in a statement: “Ik kom uit Amsterdam.” When the verb comes before jij in a question, the -t drops: “Ben jij student?” but “Jij bent student.” “Ik heet” means “I am called”, the normal way to give your name. Je is the unstressed form of jij and is what you will hear most.", ["ik ben|I am: ik ben student.", "jij bent / je bent|You are. In a question with inversion the -t drops: Ben jij …?", "hij is / zij is|He is / she is.", "Ik heet …|“I am called …”: how to give your name.", "Verb in second place|Ik kom uit Amsterdam: the verb always comes second."], 14)
defWord("nl", "nl-a1-2", "ik heet", "ik hayt", "my name is", "Ik heet Anna.", "My name is Anna.", "introductions", 1)
defWord("nl", "nl-a1-2", "Hoe heet je?", "hoo hayt yuh", "what is your name?", "Hallo! Hoe heet je?", "Hi! What's your name?", "introductions", 1)
defWord("nl", "nl-a1-2", "aangenaam", "AHN-khuh-nahm", "nice to meet you", "Aangenaam, Max.", "Nice to meet you, Max.", "introductions", 2)
defWord("nl", "nl-a1-2", "ik ben", "ik ben", "I am", "Ik ben student.", "I am a student.", "verbs", 1)
defWord("nl", "nl-a1-2", "jij bent", "yay bent", "you are", "Jij bent uit Utrecht.", "You are from Utrecht.", "verbs", 1)
defWord("nl", "nl-a1-2", "Waar kom je vandaan?", "vahr kom yuh vahn-DAHN", "where are you from?", "Waar kom je vandaan?", "Where are you from?", "introductions", 2)
defWord("nl", "nl-a1-2", "ik kom uit", "ik kom owt", "I come from", "Ik kom uit Amsterdam.", "I come from Amsterdam.", "introductions", 1)
defWord("nl", "nl-a1-2", "de student", "duh stuh-DENT", "student", "Ik ben student.", "I am a student.", "people", 1)
defEx("nl", "nl-a1-2", "choice", "What does “aangenaam” mean?", "nice to meet you", ["nice to meet you", "thank you very much", "good morning", "where are you from"], "Aangenaam literally means “pleasant”: a polite response when you meet someone.", "aangenaam")
defEx("nl", "nl-a1-2", "choice", "Which means “you are”?", "jij bent", ["jij bent", "ik ben", "hij is", "ik heet"], "Jij bent: jij is “you”. Ik ben is I am, and hij is is he is.", "")
defEx("nl", "nl-a1-2", "fill", "Ik ___ student.", "ben", ["ben", "bent", "is"], "Ik (I) goes with ben. Bent belongs to jij, and is to hij/zij.", "Ik ben student")
defEx("nl", "nl-a1-2", "fill", "Jij ___ uit Utrecht.", "bent", ["bent", "ben", "is"], "In a normal statement, jij takes bent. Only when the verb comes first does the -t drop: Ben jij …?", "Jij bent uit Utrecht")
defEx("nl", "nl-a1-2", "match", "Match the forms of zijn", "", ["ik ben=I am", "jij bent=you are", "hij is=he is", "ik heet=my name is"], "Zijn is irregular, so learn each form. Heten is the verb used for names.", "")
defEx("nl", "nl-a1-2", "translate", "Say “I am a student” in Dutch", "ik ben student", [], "Dutch keeps the pronoun ik. With jobs you can leave out the article: Ik ben student.", "ik ben een student")
defEx("nl", "nl-a1-2", "translate", "Say “My name is Anna” in Dutch", "ik heet anna", [], "Ik heet + name. You can also say “Mijn naam is Anna”.", "mijn naam is anna")
defEx("nl", "nl-a1-2", "arrange", "Build: What is your name?", "Hoe heet je?", ["Hoe", "heet", "je?"], "Question word first, then the verb in second place, then the subject.", "")
defEx("nl", "nl-a1-2", "listen", "", "Where are you from?", ["Where are you from?", "What is your name?", "Nice to meet you"], "Waar kom je vandaan? — waar = where, kom = come, vandaan = from.", "Waar kom je vandaan?")
defEx("nl", "nl-a1-2", "speak", "The “ui” in uit is a Dutch-only sound, like “ow” with rounded lips.", "I come from Amsterdam", [], "Ik kom uit Amsterdam: keep the vowels short and clear.", "Ik kom uit Amsterdam")
defRead("nl", "nl-a1-2", "Max introduces himself", "Hallo! Ik heet Max. Ik kom uit Amsterdam. Ik ben student.", ["Max gives his name, where he is from and that he is a student.", "Max asks where the hotel is.", "Max orders food."], "Ik heet Max = my name is Max; ik kom uit Amsterdam = I come from Amsterdam; ik ben student = I am a student.")
defEx("nl", "nl-a1-2", "convo", "Meeting someone new", "", ["Hallo! Hoe heet je?|Hi! What's your name?|Ik heet Sam.|Ik ben Sam heet.|Aangenaam.|Ik heet + name gives your name.", "Aangenaam. Waar kom je vandaan?|Nice to meet you. Where are you from?|Ik kom uit Canada.|Ik heet Canada.|Jij komt uit Canada.|Ik kom uit + place says where you are from.", "Leuk! Doei!|Nice! Bye!|Doei! Aangenaam.|Ik heet Sam.|Ik ben student.|End with the matching goodbye."], "You introduced yourself and said where you come from.", "")

// ---------- Lesson 3: Food and drink ----------
defLesson("nl", "nl-a1-3", "A1", "Everyday life", 3, "At the café", "Order food and drink politely.", "De or het? And “een” for everything", "Dutch nouns are de-words or het-words. De-words (most nouns, from masculine and feminine) are common: de koffie, de melk, de appel. Het-words are neuter: het water, het brood. The gender is not predictable, so learn the article with the noun. There is good news: the word for “a” is always een, whatever the gender. “Ik wil graag …” literally means “I want gladly” and is the polite way to order. It is not rude, because graag softens the request.", ["de + noun|The common article: de koffie, de melk, de appel, de rekening.", "het + noun|The neuter article: het water, het brood.", "een + noun|“A” is always een: een koffie, een brood.", "Ik wil graag …|“I would like …”: the polite way to order."], 15)
defWord("nl", "nl-a1-3", "de koffie", "duh KOF-fee", "coffee", "Ik wil graag een koffie.", "I would like a coffee.", "food", 1)
defWord("nl", "nl-a1-3", "het water", "het VAH-tuhr", "water", "Ik wil graag water.", "I would like water.", "food", 1)
defWord("nl", "nl-a1-3", "het brood", "het BROHT", "bread", "Het brood is lekker.", "The bread is tasty.", "food", 1)
defWord("nl", "nl-a1-3", "de melk", "duh MELK", "milk", "Ik wil graag een melk.", "I would like a milk.", "food", 1)
defWord("nl", "nl-a1-3", "de appel", "duh AP-pul", "apple", "Ik wil graag een appel.", "I would like an apple.", "food", 1)
defWord("nl", "nl-a1-3", "ik wil graag", "ik vil khrahkh", "I would like", "Ik wil graag een koffie.", "I would like a coffee.", "verbs", 1)
defWord("nl", "nl-a1-3", "de rekening", "duh RAY-kuh-ning", "the bill", "De rekening, alsjeblieft.", "The bill, please.", "restaurant", 1)
defWord("nl", "nl-a1-3", "ik heb honger", "ik hep HONG-uhr", "I am hungry", "Ik heb honger. Ik wil graag brood.", "I'm hungry. I would like bread.", "restaurant", 2)
defEx("nl", "nl-a1-3", "choice", "What does “de melk” mean?", "milk", ["milk", "water", "bread", "apple"], "De melk is milk. De shows it is a de-word.", "de melk")
defEx("nl", "nl-a1-3", "choice", "Which article goes with “brood”?", "het", ["het", "de"], "Brood is a het-word (neuter). There is no rule for this, so learn each article with its noun.", "")
defEx("nl", "nl-a1-3", "fill", "Ik wil graag ___ koffie. (a)", "een", ["een", "de", "het"], "“A” is always een in Dutch. De and het both mean “the”.", "Ik wil graag een koffie")
defEx("nl", "nl-a1-3", "fill", "___ brood is lekker. (the)", "Het", ["Het", "De", "Een"], "Brood is a het-word, so “the” is het.", "Het brood is lekker")
defEx("nl", "nl-a1-3", "match", "Match food and drink to meaning", "", ["de koffie=coffee", "het water=water", "het brood=bread", "de melk=milk"], "Notice which are de-words and which are het-words.", "")
defEx("nl", "nl-a1-3", "translate", "Say “I would like water” in Dutch", "ik wil graag water", [], "Ik wil graag + noun. Water does not need an article when you order it in general.", "ik wil graag een water|ik wil graag het water")
defEx("nl", "nl-a1-3", "translate", "Say “the bill” in Dutch", "de rekening", [], "Rekening is a de-word, so de rekening.", "")
defEx("nl", "nl-a1-3", "arrange", "Build: I would like a bread", "Ik wil graag een brood", ["Ik", "wil", "graag", "een", "brood"], "Subject, verb, graag, then the article and the noun. Een works with every noun.", "")
defEx("nl", "nl-a1-3", "listen", "", "I'm hungry", ["I'm hungry", "I would like coffee", "The bill, please"], "Ik heb honger literally says “I have hunger”.", "Ik heb honger")
defEx("nl", "nl-a1-3", "speak", "Dutch “g” is throaty: khrahkh. Keep it light.", "I would like a coffee", [], "Ik wil graag een koffie: the stress in koffie is on the first syllable.", "Ik wil graag een koffie")
defRead("nl", "nl-a1-3", "At the café", "Goedemiddag. Ik wil graag een koffie en een brood. Ik wil graag water, alsjeblieft. De rekening, alsjeblieft.", ["Someone orders coffee, bread and water, then asks for the bill.", "Someone introduces their family.", "Someone asks where the station is."], "Ik wil graag een koffie en een brood = I would like a coffee and a bread; de rekening, alsjeblieft = the bill, please.")
defEx("nl", "nl-a1-3", "convo", "Ordering", "", ["Goedemiddag. Wat wilt u?|Good afternoon. What would you like?|Ik wil graag een koffie, alsjeblieft.|Doei.|Aangenaam.|Answer with ik wil graag + what you want.", "Nog iets anders?|Anything else?|Een brood, alsjeblieft.|Ik ben student.|Goedemorgen.|Say what else you want, politely.", "Alsjeblieft.|Here you are.|Dank je wel.|Ik wil graag.|Ik heet Anna.|Thank them when you are handed something."], "You ordered politely using ik wil graag and alsjeblieft.", "")

// ---------- Lesson 4: Family ----------
defLesson("nl", "nl-a1-4", "A1", "Everyday life", 4, "My family", "Talk about your family and say what you have.", "“Mijn” never changes", "The Dutch possessive for “my” is mijn, and it never changes: mijn vader, mijn moeder, mijn ouders. There is no gender or plural to worry about, unlike German or French. To say what you have, use hebben: ik heb (I have). As in English, the plural of family members just adds an ending: ouders (parents). The indefinite article een works with every noun, so “a sister” is een zus and “a brother” is een broer.", ["mijn + noun|Always mijn, for every noun: mijn vader, mijn moeder, mijn ouders.", "ik heb + noun|I have …: ik heb een zus.", "de ouders|Parents. The plural uses de."], 14)
defWord("nl", "nl-a1-4", "de familie", "duh fah-MEE-lee", "family", "Mijn familie is groot.", "My family is big.", "family", 1)
defWord("nl", "nl-a1-4", "de moeder", "duh MOO-duhr", "mother", "Mijn moeder is lerares.", "My mother is a teacher.", "family", 1)
defWord("nl", "nl-a1-4", "de vader", "duh VAH-duhr", "father", "Mijn vader komt uit Amsterdam.", "My father comes from Amsterdam.", "family", 1)
defWord("nl", "nl-a1-4", "de broer", "duh BROOR", "brother", "Ik heb een broer.", "I have a brother.", "family", 1)
defWord("nl", "nl-a1-4", "de zus", "duh ZUS", "sister", "Ik heb een zus.", "I have a sister.", "family", 1)
defWord("nl", "nl-a1-4", "de ouders", "duh OW-duhrs", "parents", "Mijn ouders zijn aardig.", "My parents are nice.", "family", 2)
defWord("nl", "nl-a1-4", "mijn", "mine", "my", "Mijn zus, mijn broer.", "My sister, my brother.", "grammar", 1)
defWord("nl", "nl-a1-4", "ik heb", "ik hep", "I have", "Ik heb een familie.", "I have a family.", "verbs", 1)
defEx("nl", "nl-a1-4", "choice", "What does “de zus” mean?", "sister", ["sister", "brother", "mother", "parents"], "De zus is sister. De broer is brother.", "de zus")
defEx("nl", "nl-a1-4", "choice", "Which means “my sister”?", "mijn zus", ["mijn zus", "mijne zus", "mij zus"], "Mijn is the only form of “my”. It does not change with gender or number.", "")
defEx("nl", "nl-a1-4", "fill", "Ik heb een ___. (sister)", "zus", ["zus", "broer", "vader"], "Zus means sister. Broer is brother and vader is father.", "Ik heb een zus")
defEx("nl", "nl-a1-4", "fill", "___ ouders komen uit Amsterdam. (my)", "Mijn", ["Mijn", "Mijne", "Een"], "Mijn is the possessive for every noun, even plurals.", "Mijn ouders komen uit Amsterdam")
defEx("nl", "nl-a1-4", "match", "Match the family words", "", ["de moeder=mother", "de vader=father", "de broer=brother", "de familie=family"], "All four are de-words.", "")
defEx("nl", "nl-a1-4", "translate", "Say “my family” in Dutch", "mijn familie", [], "Mijn never changes.", "")
defEx("nl", "nl-a1-4", "translate", "Say “I have a brother” in Dutch", "ik heb een broer", [], "Ik heb = I have; een works with every noun.", "")
defEx("nl", "nl-a1-4", "arrange", "Build: I have a sister", "Ik heb een zus", ["Ik", "heb", "een", "zus"], "Subject, verb, article, noun.", "")
defEx("nl", "nl-a1-4", "listen", "", "I have a sister", ["I have a sister", "I have a brother", "I have a family"], "Een zus: a sister.", "Ik heb een zus")
defEx("nl", "nl-a1-4", "speak", "Short vowels: ik hep un BROOR.", "I have a brother", [], "Ik heb een broer: the b in heb sounds like p at the end of the word.", "Ik heb een broer")
defRead("nl", "nl-a1-4", "Max and his family", "Ik heet Max. Ik heb een zus en een broer. Mijn ouders komen uit Amsterdam.", ["Max talks about his name, his siblings and where his parents are from.", "Max orders a coffee.", "Max says goodbye."], "Ik heb een zus en een broer = I have a sister and a brother. Komen is the plural of kom (they come).")
defEx("nl", "nl-a1-4", "choice", "Which one is correct?", "mijn vader", ["mijn vader", "mijne vader", "mij vader"], "Mijn is the only possessive form for “my”.", "")

// ---------- Lesson 5: Getting around ----------
defLesson("nl", "nl-a1-5", "A1", "Getting around", 5, "Where is it?", "Ask where something is and follow simple directions.", "“Waar is …?” and directions", "To ask where something is, use waar (where) + is: “Waar is het station?”. The article shows whether it is a de-word or het-word: de straat, het station, het hotel. Directions are short words with no article: rechts (right), links (left), rechtdoor (straight ahead, written as one word). “Dichtbij” means nearby and is also a single word. Because the verb stays in second place, the question word always comes first.", ["Waar is + article + place?|Where is …? The question word goes first.", "rechts / links|Right and left. No article.", "rechtdoor|Straight ahead: one word.", "dichtbij|Nearby: one word."], 15)
defWord("nl", "nl-a1-5", "Waar is …?", "vahr is", "where is …?", "Waar is het hotel?", "Where is the hotel?", "directions", 1)
defWord("nl", "nl-a1-5", "de straat", "duh STRAHT", "street", "Het hotel is in de straat.", "The hotel is in the street.", "places", 1)
defWord("nl", "nl-a1-5", "het station", "het stah-SHON", "train station", "Waar is het station?", "Where is the train station?", "places", 1)
defWord("nl", "nl-a1-5", "het hotel", "het hoh-TEL", "hotel", "Het hotel is links.", "The hotel is on the left.", "places", 1)
defWord("nl", "nl-a1-5", "rechts", "rekhts", "right", "Het hotel is rechts.", "The hotel is on the right.", "directions", 1)
defWord("nl", "nl-a1-5", "links", "links", "left", "Het station is links.", "The station is on the left.", "directions", 1)
defWord("nl", "nl-a1-5", "rechtdoor", "REKHT-dohr", "straight ahead", "Rechtdoor en dan rechts.", "Straight ahead and then right.", "directions", 2)
defWord("nl", "nl-a1-5", "dichtbij", "dikht-BAY", "nearby", "Het station is dichtbij.", "The station is nearby.", "directions", 2)
defEx("nl", "nl-a1-5", "choice", "What does “links” mean?", "left", ["left", "right", "straight ahead", "nearby"], "Links is left; rechts is right.", "links")
defEx("nl", "nl-a1-5", "choice", "Which asks “Where is the station?”", "Waar is het station?", ["Waar is het station?", "Hoe heet je?", "Waar kom je vandaan?"], "Waar is = where is. “Waar kom je vandaan?” asks where you come from.", "")
defEx("nl", "nl-a1-5", "fill", "Waar ___ het hotel?", "is", ["is", "ben", "bent"], "The hotel is a single thing (it), so the verb is is.", "Waar is het hotel")
defEx("nl", "nl-a1-5", "fill", "Het hotel is ___. (right)", "rechts", ["rechts", "links", "rechtdoor"], "Rechts means right. Links would be left.", "Het hotel is rechts")
defEx("nl", "nl-a1-5", "match", "Match places and directions", "", ["de straat=street", "het station=station", "links=left", "rechtdoor=straight ahead"], "Learn places with their article, directions without.", "")
defEx("nl", "nl-a1-5", "translate", "Say “straight ahead” in Dutch", "rechtdoor", [], "Rechtdoor is one word.", "recht door")
defEx("nl", "nl-a1-5", "translate", "Say “Where is the hotel?” in Dutch", "waar is het hotel", [], "Waar is + het hotel. Hotel is a het-word.", "")
defEx("nl", "nl-a1-5", "arrange", "Build: The station is nearby", "Het station is dichtbij", ["Het", "station", "is", "dichtbij"], "Subject, verb, then the place word.", "")
defEx("nl", "nl-a1-5", "listen", "", "Straight ahead and then right", ["Straight ahead and then right", "Left and then nearby", "The hotel is nearby"], "Rechtdoor en dan rechts: go straight, then turn right.", "Rechtdoor en dan rechts")
defEx("nl", "nl-a1-5", "speak", "Dutch “aa” in waar is long: vahr.", "Where is the station?", [], "Waar is het station? The w is softer than English w, close to a v/w blend.", "Waar is het station?")
defRead("nl", "nl-a1-5", "Finding the hotel", "Het hotel is dichtbij. Het station is rechtdoor en dan links.", ["Directions to a hotel and a station.", "A family introduction.", "A bakery order."], "Het hotel is dichtbij = the hotel is nearby; rechtdoor en dan links = straight ahead and then left.")
defEx("nl", "nl-a1-5", "convo", "Asking for directions", "", ["Hallo! Heb je hulp nodig?|Hi! Do you need help?|Ja. Waar is het station?|Ja. Hoe heet je?|Ik wil graag koffie.|Ja means yes; then you ask where the station is.", "Het station is rechts.|The station is on the right.|Dank je wel.|Aangenaam.|Ik heb honger.|Thank them for the directions.", "Graag gedaan. Doei!|You're welcome. Bye!|Doei!|Ik heet Anna.|Goedenacht.|Say the matching goodbye."], "You asked for directions and finished politely.", "")

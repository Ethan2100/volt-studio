// ---------- Lesson 1: Greetings and politeness ----------
defLesson("ja", "ja-a1-1", "A1", "First contact", 1, "Hello and thank you", "Greet people at any time of day and be polite.", "Why is こんにちは read “konnichiwa”?", "Japanese greetings are fixed phrases, and you learn them whole. They show a curious spelling rule: こんにちは and こんばんは end in は, which is normally read “ha”. Here it is read “wa”, because these greetings began as longer sentences (“As for today, …”) and は is the particle that marks the topic, always read “wa”. Politeness is built into the words too: おはよう is casual, and adding ございます makes おはようございます, which you use with teachers, strangers and colleagues. When in doubt, choose the polite form.", ["こんにちは|Hello. The final は is read “wa”, not “ha”.", "おはようございます|Good morning, polite. Drop ございます for friends: おはよう.", "ありがとう|Thank you. Add ございます for polite: ありがとうございます.", "さようなら|Goodbye, fairly formal. Friends say またね (see you)."], 12)
defWord("ja", "ja-a1-1", "こんにちは", "konnichiwa", "hello / good afternoon", "こんにちは、たなかさん。", "Hello, Mr Tanaka.", "greetings", 1)
defWord("ja", "ja-a1-1", "おはようございます", "ohayou gozaimasu", "good morning (polite)", "おはようございます、せんせい。", "Good morning, teacher.", "greetings", 1)
defWord("ja", "ja-a1-1", "こんばんは", "konbanwa", "good evening", "こんばんは、さとうさん。", "Good evening, Ms Sato.", "greetings", 1)
defWord("ja", "ja-a1-1", "おやすみなさい", "oyasumi nasai", "good night", "おやすみなさい、おかあさん。", "Good night, Mum.", "greetings", 1)
defWord("ja", "ja-a1-1", "さようなら", "sayounara", "goodbye", "さようなら、また あした。", "Goodbye, see you tomorrow.", "greetings", 1)
defWord("ja", "ja-a1-1", "おねがいします", "onegai shimasu", "please", "コーヒーを おねがいします。", "Coffee, please.", "politeness", 2)
defWord("ja", "ja-a1-1", "ありがとう", "arigatou", "thank you", "ありがとうございます。", "Thank you very much.", "politeness", 1)
defWord("ja", "ja-a1-1", "どういたしまして", "dou itashimashite", "you're welcome", "「ありがとう。」「どういたしまして。」", "“Thank you.” “You're welcome.”", "politeness", 2)
defEx("ja", "ja-a1-1", "choice", "What does “ありがとう” mean?", "thank you", ["thank you", "please", "goodbye", "hello"], "ありがとう (arigatou) = thank you. おねがいします is please, and さようなら is goodbye.", "ありがとう")
defEx("ja", "ja-a1-1", "choice", "Which greeting is for the evening?", "こんばんは", ["こんばんは", "こんにちは", "おやすみなさい", "さようなら"], "ばん means evening, so こんばんは (konbanwa). おやすみなさい is only said when going to bed.", "")
defEx("ja", "ja-a1-1", "match", "Match each word with its meaning", "", ["こんにちは=hello", "さようなら=goodbye", "ありがとう=thank you", "おねがいします=please"], "Four phrases for everyday politeness.", "")
defEx("ja", "ja-a1-1", "fill", "おはよう___。(good morning, polite)", "ございます", ["ございます", "ありがとう", "さようなら"], "ございます is the polite ending that turns おはよう into おはようございます.", "おはようございます")
defEx("ja", "ja-a1-1", "fill", "___。(thank you)", "ありがとう", ["ありがとう", "さようなら", "こんにちは"], "ありがとう means thank you. さようなら is goodbye and こんにちは is hello.", "ありがとう")
defEx("ja", "ja-a1-1", "translate", "Type “thank you” in Japanese (kana or romaji)", "ありがとう", [], "ありがとう, arigatou. Add ございます (gozaimasu) to be polite.", "arigatou|arigato|ありがとうございます|arigatou gozaimasu")
defEx("ja", "ja-a1-1", "translate", "Type “goodbye” in Japanese (kana or romaji)", "さようなら", [], "さようなら (sayounara) is the standard goodbye.", "sayounara|sayonara")
defEx("ja", "ja-a1-1", "arrange", "Build: Good evening", "こんばん は", ["こんばん", "は"], "こんばん (this evening) + は (read “wa”). Remember: the は here is pronounced “wa”.", "")
defEx("ja", "ja-a1-1", "listen", "", "Hello / good afternoon", ["Hello / good afternoon", "Good night", "Goodbye"], "こんにちは (konnichiwa) is the standard daytime greeting.", "こんにちは")
defEx("ja", "ja-a1-1", "speak", "Say it evenly: a-ri-ga-tou, with a long final “o”.", "Thank you", [], "ありがとう: every syllable gets the same weight, and the final う lengthens the “o”.", "ありがとう")
defRead("ja", "ja-a1-1", "A polite exchange", "おはようございます。ありがとう。どういたしまして。さようなら。", ["Two people greet, thank each other and say goodbye.", "Someone asks for directions to the station.", "Someone orders coffee and bread."], "おはようございます = good morning; ありがとう = thank you; どういたしまして = you're welcome; さようなら = goodbye.")
defEx("ja", "ja-a1-1", "convo", "Meeting a neighbour", "", ["こんにちは。|Hello.|こんにちは。|おやすみなさい。|さようなら。|Return the same greeting. おやすみなさい is for bedtime.", "これ、どうぞ。|Here, please take this.|ありがとう。|さようなら。|おやすみなさい。|When someone gives you something, say thank you.", "どういたしまして。さようなら。|You're welcome. Goodbye.|さようなら。|こんにちは。|ありがとう。|Finish with the matching goodbye."], "You greeted, thanked and said goodbye politely.", "")

// ---------- Lesson 2: Introducing yourself ----------
defLesson("ja", "ja-a1-2", "A1", "First contact", 2, "Who are you?", "Say who you are and ask someone's name.", "は, です and the verb at the end", "Japanese puts the verb (or です) at the end of the sentence. The pattern is “A は B です”, meaning “A is B”. です (desu) is the polite “is/am/are”, and は (read “wa”) marks the topic: what the sentence is about. So “わたしは がくせいです” is “As for me, (I) am a student.” Japanese does not need a subject every time, but わたし (I) is common in introductions. To say “my name”, link the two words with の: わたしの なまえ. The の works like “’s”: わたしの = “my”.", ["A は B です|A is B. The は is read “wa”: わたしは がくせいです.", "わたしの なまえは A です|My name is A. の links the owner and the thing.", "Verb / です last|The sentence always ends with です or a verb.", "A から きました|I came from A."], 14)
defWord("ja", "ja-a1-2", "はじめまして", "hajimemashite", "nice to meet you", "はじめまして、アンナです。", "Nice to meet you, I'm Anna.", "introductions", 1)
defWord("ja", "ja-a1-2", "わたし", "watashi", "I / me", "わたしは がくせいです。", "I am a student.", "pronouns", 1)
defWord("ja", "ja-a1-2", "です", "desu", "is / am / are (polite)", "がくせいです。", "(I) am a student.", "grammar", 1)
defWord("ja", "ja-a1-2", "がくせい", "gakusei", "student", "わたしは がくせいです。", "I am a student.", "people", 1)
defWord("ja", "ja-a1-2", "おなまえは？", "onamae wa", "what is your name?", "おなまえは？", "What is your name?", "introductions", 2)
defWord("ja", "ja-a1-2", "わたしの なまえは", "watashi no namae wa", "my name is", "わたしの なまえは アンナです。", "My name is Anna.", "introductions", 2)
defWord("ja", "ja-a1-2", "からきました", "kara kimashita", "(I) came from", "ドイツから きました。", "I came from Germany.", "introductions", 2)
defWord("ja", "ja-a1-2", "どうぞ よろしく", "douzo yoroshiku", "pleased to meet you", "どうぞ よろしく。", "Pleased to meet you.", "introductions", 2)
defEx("ja", "ja-a1-2", "choice", "What does “はじめまして” mean?", "nice to meet you", ["nice to meet you", "thank you very much", "good morning", "what is your name"], "はじめまして (hajimemashite) is said the first time you meet someone.", "はじめまして")
defEx("ja", "ja-a1-2", "choice", "Which word means “student”?", "がくせい", ["がくせい", "わたし", "です", "ありがとう"], "がくせい (gakusei) = student. わたし is “I”, and です is the polite “is”.", "")
defEx("ja", "ja-a1-2", "fill", "わたし___ がくせいです。", "は", ["は", "の", "から"], "は marks the topic (“as for me”) and is read “wa”. の joins a possessor and a noun.", "わたしは がくせいです")
defEx("ja", "ja-a1-2", "fill", "わたし___ なまえは アンナです。(my name)", "の", ["の", "は", "です"], "わたしの means “my”: の links the owner (わたし) to the thing owned (なまえ).", "わたしの なまえは アンナです")
defEx("ja", "ja-a1-2", "match", "Match the words", "", ["わたし=I", "がくせい=student", "です=is / am", "はじめまして=nice to meet you"], "These four build most introductions.", "")
defEx("ja", "ja-a1-2", "translate", "Say “I am a student” in Japanese (kana or romaji)", "わたしはがくせいです", [], "わたしは がくせいです: topic (わたしは), what you are (がくせい), then です at the end.", "わたしは がくせいです|watashi wa gakusei desu|watashiwa gakuseidesu|がくせいです|gakusei desu")
defEx("ja", "ja-a1-2", "translate", "Say “My name is Anna” in Japanese (kana or romaji)", "わたしのなまえはアンナです", [], "わたしの なまえは + name + です. Foreign names are usually written in katakana: アンナ.", "わたしの なまえは アンナです|watashi no namae wa anna desu|watashinonamaewaannadesu|わたしのなまえはあんなです")
defEx("ja", "ja-a1-2", "arrange", "Build: I am a student", "わたし は がくせい です", ["わたし", "は", "がくせい", "です"], "Topic, particle は, the noun, then です at the end.", "")
defEx("ja", "ja-a1-2", "listen", "", "Nice to meet you", ["Nice to meet you", "What is your name?", "Thank you"], "はじめまして starts the conversation when you meet someone for the first time.", "はじめまして")
defEx("ja", "ja-a1-2", "speak", "Four even beats: ha-ji-me-ma-shi-te.", "Nice to meet you", [], "はじめまして: Japanese syllables are even in length, with no strong stress.", "はじめまして")
defRead("ja", "ja-a1-2", "Anna introduces herself", "はじめまして。わたしの なまえは アンナです。わたしは がくせいです。どうぞ よろしく。", ["Anna gives her name, says she is a student and greets politely.", "Anna asks where the station is.", "Anna orders coffee."], "わたしの なまえは アンナです = my name is Anna; わたしは がくせいです = I am a student; どうぞ よろしく = pleased to meet you.")
defEx("ja", "ja-a1-2", "convo", "Meeting someone new", "", ["はじめまして。おなまえは？|Nice to meet you. What's your name?|わたしの なまえは サムです。|サムの なまえは わたしです。|ありがとうです。|わたしの なまえは + name + です gives your name.", "サムさん、がくせいですか。|Sam, are you a student?|はい、わたしは がくせいです。|はい、ありがとう。|いいえ、さようなら。|はい means yes; then say you are a student.", "どうぞ よろしく。|Pleased to meet you.|どうぞ よろしく。|さようなら。|おやすみなさい。|どうぞ よろしく is said back to the person."], "You introduced yourself politely in Japanese.", "")

// ---------- Lesson 3: Food and drink ----------
defLesson("ja", "ja-a1-3", "A1", "Everyday life", 3, "At the café", "Order food and drink politely.", "No articles, no gender: the particle を", "Japanese has no articles (no “a” or “the”) and no grammatical gender, so コーヒー alone means “coffee”, “a coffee” or “the coffee”. What it does have is particles, small words placed after a noun to show its role. The particle を marks the thing an action is done to (the object) and is read “o”. So “コーヒーを ください” is “(Give me) coffee, please”. ください (kudasai) means “please give me”. You can also say おねがいします for any request. Japanese has two scripts for this lesson: hiragana (みず, りんご) for native words, and katakana (コーヒー, パン) for words borrowed from other languages.", ["N を ください|Please give me N. を is read “o” and marks the object.", "N を おねがいします|Another way to request: N, please.", "No articles|No a/the and no gender: パン can mean bread, a bread or the bread.", "hiragana / katakana|Native words use hiragana; borrowed words (コーヒー, パン) use katakana."], 15)
defWord("ja", "ja-a1-3", "コーヒー", "koohii", "coffee", "コーヒーを ください。", "Coffee, please.", "food", 1)
defWord("ja", "ja-a1-3", "みず", "mizu", "water", "みずを ください。", "Water, please.", "food", 1)
defWord("ja", "ja-a1-3", "パン", "pan", "bread", "パンを ください。", "Bread, please.", "food", 1)
defWord("ja", "ja-a1-3", "ぎゅうにゅう", "gyuunyuu", "milk", "ぎゅうにゅうを ください。", "Milk, please.", "food", 2)
defWord("ja", "ja-a1-3", "りんご", "ringo", "apple", "りんごを ください。", "An apple, please.", "food", 1)
defWord("ja", "ja-a1-3", "ください", "kudasai", "please give me", "みずを ください。", "Water, please.", "verbs", 1)
defWord("ja", "ja-a1-3", "おかんじょう", "okanjou", "the bill", "おかんじょうを おねがいします。", "The bill, please.", "restaurant", 2)
defWord("ja", "ja-a1-3", "おなかが すきました", "onaka ga sukimashita", "I am hungry", "おなかが すきました。パンを ください。", "I'm hungry. Bread, please.", "restaurant", 2)
defEx("ja", "ja-a1-3", "choice", "What does “みず” mean?", "water", ["water", "milk", "coffee", "apple"], "みず (mizu) is water. ぎゅうにゅう is milk.", "みず")
defEx("ja", "ja-a1-3", "choice", "Which word means “milk”?", "ぎゅうにゅう", ["ぎゅうにゅう", "みず", "パン", "りんご"], "ぎゅうにゅう (gyuunyuu) is milk. The ゅ is a small ゆ, making a blended “yu” sound.", "")
defEx("ja", "ja-a1-3", "fill", "コーヒー___ ください。", "を", ["を", "は", "の"], "を marks the thing being requested, the object of ください. It is read “o”.", "コーヒーを ください")
defEx("ja", "ja-a1-3", "fill", "___を ください。(bread, please)", "パン", ["パン", "みず", "りんご"], "パン (pan) is bread, borrowed from Portuguese, which is why it is written in katakana.", "パンを ください")
defEx("ja", "ja-a1-3", "match", "Match food and drink to meaning", "", ["コーヒー=coffee", "みず=water", "パン=bread", "りんご=apple"], "Note the scripts: コーヒー and パン are katakana (loanwords); みず and りんご are hiragana.", "")
defEx("ja", "ja-a1-3", "translate", "Say “Water, please” in Japanese (kana or romaji)", "みずをください", [], "みず (water) + を (object marker) + ください (please give me).", "みずを ください|mizu o kudasai|mizu wo kudasai|mizuokudasai|みずを おねがいします|mizu o onegai shimasu")
defEx("ja", "ja-a1-3", "translate", "Type “the bill” in Japanese (kana or romaji)", "おかんじょう", [], "おかんじょう (okanjou) is the polite word for the bill; the お adds politeness.", "okanjou|okanjo|かんじょう|kanjou")
defEx("ja", "ja-a1-3", "arrange", "Build: Coffee, please", "コーヒー を ください", ["コーヒー", "を", "ください"], "Noun, then を, then the request. The verb-like word comes last.", "")
defEx("ja", "ja-a1-3", "listen", "", "I'm hungry", ["I'm hungry", "Coffee, please", "The bill, please"], "おなかが すきました literally says “the stomach became empty”.", "おなかが すきました")
defEx("ja", "ja-a1-3", "speak", "Keep ください even: ku-da-sa-i.", "Coffee, please", [], "コーヒーを ください: the を is read “o”, and the long “ii” in コーヒー is held for two beats.", "コーヒーを ください")
defRead("ja", "ja-a1-3", "At the café", "こんにちは。コーヒーを ください。パンを ください。みずを ください。おかんじょうを おねがいします。", ["Someone orders coffee, bread and water, then asks for the bill.", "Someone introduces their family.", "Someone asks where the station is."], "コーヒーを ください = coffee, please; おかんじょうを おねがいします = the bill, please.")
defEx("ja", "ja-a1-3", "convo", "Ordering", "", ["いらっしゃいませ。|Welcome.|コーヒーを ください。|さようなら。|はじめまして。|You order with the item, を and ください.", "ほかに なにか。|Anything else?|パンを ください。|わたしは がくせいです。|おやすみなさい。|Say what else you want with を ください.", "どうぞ。|Here you are.|ありがとう。|ください。|わたしの なまえは アンナです。|Thank them when you are handed something."], "You ordered politely using を ください.", "")

// ---------- Lesson 4: Family ----------
defLesson("ja", "ja-a1-4", "A1", "Everyday life", 4, "My family", "Talk about your own family.", "Your family and other people's family", "Japanese has two sets of family words. When you talk about your own family to other people, you use plain words: はは (my mother), ちち (my father), あに (my older brother), あね (my older sister). When you talk about someone else's family, or address your own relatives, you use the respectful words with お…さん: おかあさん, おとうさん, おにいさん, おねえさん. Japanese also distinguishes older from younger siblings, so there is no single word for “brother”. Use の for “my”: わたしの かぞく, and が with います to say what exists: あにが います (I have an older brother).", ["はは / ちち / あに / あね|My own mother / father / older brother / older sister, said to other people.", "おかあさん / おとうさん|Someone else's mother or father, or what you call your own.", "わたしの + N|My N. の links possessor and thing.", "N が います|There is N / I have N, for people and animals."], 14)
defWord("ja", "ja-a1-4", "かぞく", "kazoku", "family", "わたしの かぞくは よにんです。", "My family has four people.", "family", 1)
defWord("ja", "ja-a1-4", "はは", "haha", "my mother", "ははは せんせいです。", "My mother is a teacher.", "family", 1)
defWord("ja", "ja-a1-4", "ちち", "chichi", "my father", "ちちは アメリカから きました。", "My father came from America.", "family", 1)
defWord("ja", "ja-a1-4", "あに", "ani", "my older brother", "あにが います。", "I have an older brother.", "family", 1)
defWord("ja", "ja-a1-4", "あね", "ane", "my older sister", "あねが います。", "I have an older sister.", "family", 1)
defWord("ja", "ja-a1-4", "りょうしん", "ryoushin", "parents", "りょうしんが います。", "I have parents.", "family", 2)
defWord("ja", "ja-a1-4", "わたしの", "watashi no", "my", "わたしの かぞく。", "My family.", "grammar", 1)
defWord("ja", "ja-a1-4", "います", "imasu", "there is / (I) have (people, animals)", "あねが います。", "I have an older sister.", "verbs", 1)
defEx("ja", "ja-a1-4", "choice", "What does “あね” mean?", "my older sister", ["my older sister", "my older brother", "my mother", "my parents"], "あね is your own older sister. あに is your own older brother.", "あね")
defEx("ja", "ja-a1-4", "choice", "How do you say “my father” to someone else?", "ちち", ["ちち", "おとうさん", "かぞく", "あに"], "To other people you use the plain word ちち for your own father. おとうさん is used for someone else's father.", "")
defEx("ja", "ja-a1-4", "fill", "わたしは あねが ___。(I have an older sister)", "います", ["います", "です", "ありがとう"], "います is used for people and animals that exist. です would make it “is” instead.", "わたしは あねが います")
defEx("ja", "ja-a1-4", "fill", "わたし___ はは (my mother)", "の", ["の", "は", "が"], "の links わたし and はは into “my mother”, like “’s”.", "わたしの はは")
defEx("ja", "ja-a1-4", "match", "Match the family words", "", ["かぞく=family", "はは=my mother", "ちち=my father", "あに=my older brother"], "These are the plain words you use for your own family.", "")
defEx("ja", "ja-a1-4", "translate", "Say “my family” in Japanese (kana or romaji)", "わたしのかぞく", [], "わたしの + かぞく: my family.", "わたしの かぞく|watashi no kazoku|watashinokazoku")
defEx("ja", "ja-a1-4", "translate", "Say “I have an older sister” in Japanese (kana or romaji)", "あねがいます", [], "あね (older sister) + が + います. Japanese can leave out わたしは when it is obvious.", "あねが います|ane ga imasu|aneimasu|わたしは あねが います|watashi wa ane ga imasu")
defEx("ja", "ja-a1-4", "arrange", "Build: I have an older brother", "あに が います", ["あに", "が", "います"], "Noun + が + います: the thing that exists comes first, います last.", "")
defEx("ja", "ja-a1-4", "listen", "", "I have an older sister", ["I have an older sister", "I have an older brother", "I have a family"], "あねが います: あね is the older sister.", "あねが います")
defEx("ja", "ja-a1-4", "speak", "Two short syllables: ka-zo-ku.", "My family", [], "わたしの かぞく: the u in かぞく is often very light, almost silent.", "わたしの かぞく")
defRead("ja", "ja-a1-4", "Anna's family", "わたしは アンナです。あにが います。ははと ちちが います。", ["Anna says she has an older brother and parents.", "Anna orders a coffee.", "Anna says goodbye."], "あにが います = I have an older brother; ははと ちちが います = I have a mother and a father (と means “and”).")
defEx("ja", "ja-a1-4", "choice", "Which word means “parents”?", "りょうしん", ["りょうしん", "かぞく", "はは", "あね"], "りょうしん means both parents together; かぞく is the whole family.", "")

// ---------- Lesson 5: Getting around ----------
defLesson("ja", "ja-a1-5", "A1", "Getting around", 5, "Where is it?", "Ask where something is and understand simple directions.", "“Doko desu ka?” and the question marker か", "To ask where something is, name it with は and add どこですか: “えきは どこですか”, “Where is the station?”. The word order does not change in a question; the particle か at the end turns the statement into a question, like a spoken question mark. Directions are simple nouns used with です: みぎです (it is on the right), ひだりです (left), まっすぐです (straight ahead), ちかくです (near).", ["N は どこですか|Where is N? か makes it a question.", "N は みぎ / ひだり です|N is on the right / left.", "まっすぐ|Straight ahead.", "ちかく|Near, nearby."], 15)
defWord("ja", "ja-a1-5", "どこ", "doko", "where", "えきは どこですか。", "Where is the station?", "directions", 1)
defWord("ja", "ja-a1-5", "えき", "eki", "train station", "えきは ちかくです。", "The station is nearby.", "places", 1)
defWord("ja", "ja-a1-5", "ホテル", "hoteru", "hotel", "ホテルは みぎです。", "The hotel is on the right.", "places", 1)
defWord("ja", "ja-a1-5", "みち", "michi", "street / road", "みちは まっすぐです。", "The road goes straight.", "places", 1)
defWord("ja", "ja-a1-5", "みぎ", "migi", "right", "ホテルは みぎです。", "The hotel is on the right.", "directions", 1)
defWord("ja", "ja-a1-5", "ひだり", "hidari", "left", "えきは ひだりです。", "The station is on the left.", "directions", 1)
defWord("ja", "ja-a1-5", "まっすぐ", "massugu", "straight ahead", "まっすぐです。", "Straight ahead.", "directions", 2)
defWord("ja", "ja-a1-5", "ちかく", "chikaku", "near", "えきは ちかくです。", "The station is near.", "directions", 2)
defEx("ja", "ja-a1-5", "choice", "What does “ひだり” mean?", "left", ["left", "right", "straight ahead", "near"], "ひだり (hidari) is left; みぎ (migi) is right.", "ひだり")
defEx("ja", "ja-a1-5", "choice", "Which asks “Where is the station?”", "えきは どこですか", ["えきは どこですか", "おなまえは？", "ありがとう"], "どこ means where, and か marks the question.", "")
defEx("ja", "ja-a1-5", "fill", "えきは ___ ですか。(where)", "どこ", ["どこ", "わたし", "パン"], "どこ (doko) means where.", "えきは どこですか")
defEx("ja", "ja-a1-5", "fill", "ホテルは ___ です。(right)", "みぎ", ["みぎ", "ひだり", "まっすぐ"], "みぎ means right. ひだり would be left.", "ホテルは みぎです")
defEx("ja", "ja-a1-5", "match", "Match places and directions", "", ["みち=street", "えき=station", "ひだり=left", "まっすぐ=straight ahead"], "Directions are nouns that go before です.", "")
defEx("ja", "ja-a1-5", "translate", "Say “straight ahead” in Japanese (kana or romaji)", "まっすぐ", [], "まっすぐ (massugu) has a small っ that doubles the s: mas-su-gu.", "massugu|まっすぐです|massugu desu")
defEx("ja", "ja-a1-5", "translate", "Say “Where is the hotel?” in Japanese (kana or romaji)", "ホテルはどこですか", [], "ホテル + は + どこ + ですか. The question word stays where the answer would go.", "ホテルは どこですか|hoteru wa doko desu ka|ほてるはどこですか")
defEx("ja", "ja-a1-5", "arrange", "Build: Where is the station?", "えき は どこ ですか", ["えき", "は", "どこ", "ですか"], "Topic, は, question word, then ですか at the end.", "")
defEx("ja", "ja-a1-5", "listen", "", "It's straight ahead", ["It's straight ahead", "It's on the left", "It's nearby"], "まっすぐです: it is straight ahead.", "まっすぐです")
defEx("ja", "ja-a1-5", "speak", "Rise at the end for the question: e-ki wa do-ko de-su ka?", "Where is the station?", [], "えきは どこですか: the か gives a slight rising tone.", "えきは どこですか")
defRead("ja", "ja-a1-5", "Finding the hotel", "ホテルは ちかくです。えきは まっすぐです。", ["Directions to a hotel and a station.", "A family introduction.", "A café order."], "ホテルは ちかくです = the hotel is nearby; えきは まっすぐです = the station is straight ahead.")
defEx("ja", "ja-a1-5", "convo", "Asking for directions", "", ["こんにちは。|Hello.|こんにちは。えきは どこですか。|こんにちは。コーヒーを ください。|さようなら。|Greet back, then ask where the station is.", "えきは みぎです。|The station is on the right.|ありがとう。|どこですか。|おやすみなさい。|Thank them for the directions.", "どういたしまして。|You're welcome.|さようなら。|はじめまして。|ありがとう。|Finish with a goodbye."], "You asked for directions and finished politely.", "")

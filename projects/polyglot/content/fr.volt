// =====================================================================

// ---------- Lesson 1: Greetings and politeness ----------
defLesson("fr", "fr-a1-1", "A1", "First contact", 1, "Hello and thank you", "Greet people at any time of day and be polite.", "Why “bonjour” but “bonne nuit”?", "Bonjour is two words fused together: bon (good) + jour (day). Jour is masculine, so the adjective is bon. Nuit (night) and soirée (evening) are feminine, so French adds an -e: bonne nuit, bonne soirée. This is the first example of agreement: an adjective matches the gender of its noun. French also has two ways of saying “you”: tu for friends and vous for strangers or politeness. That is why the polite request is “s'il vous plaît” (literally “if it pleases you”), and the friendly version is “s'il te plaît”.", ["bon + jour|Jour is masculine, so bon has no ending.", "bonne + nuit|Nuit is feminine, so the adjective takes -e.", "s'il vous plaît|Formal please, using vous. With friends: s'il te plaît.", "merci / de rien|Thanks and “it's nothing”, the usual reply."], 12)
defWord("fr", "fr-a1-1", "bonjour", "bohn-ZHOOR", "hello / good day", "Bonjour, madame.", "Hello, madam.", "greetings", 1)
defWord("fr", "fr-a1-1", "bonsoir", "bohn-SWAHR", "good evening", "Bonsoir, monsieur.", "Good evening, sir.", "greetings", 1)
defWord("fr", "fr-a1-1", "bonne nuit", "bun NWEE", "good night", "Bonne nuit, maman.", "Good night, mum.", "greetings", 1)
defWord("fr", "fr-a1-1", "salut", "sah-LOO", "hi / bye (informal)", "Salut, ça va ?", "Hi, how's it going?", "greetings", 1)
defWord("fr", "fr-a1-1", "au revoir", "oh ruh-VWAHR", "goodbye", "Au revoir, à demain.", "Goodbye, see you tomorrow.", "greetings", 1)
defWord("fr", "fr-a1-1", "s'il vous plaît", "seel voo PLEH", "please", "Un café, s'il vous plaît.", "A coffee, please.", "politeness", 1)
defWord("fr", "fr-a1-1", "merci", "mehr-SEE", "thank you", "Merci beaucoup.", "Thank you very much.", "politeness", 1)
defWord("fr", "fr-a1-1", "de rien", "duh RYAN", "you're welcome", "— Merci. — De rien.", "“Thanks.” “You're welcome.”", "politeness", 1)
defEx("fr", "fr-a1-1", "choice", "What does “merci” mean?", "thank you", ["thank you", "please", "goodbye", "hello"], "Merci = thank you. S'il vous plaît is please, and au revoir is goodbye.", "merci")
defEx("fr", "fr-a1-1", "choice", "Which greeting is for the evening?", "Bonsoir", ["Bonsoir", "Bonjour", "Bonne nuit", "Au revoir"], "Soir means evening, so bonsoir. Bonne nuit is only for going to bed.", "")
defEx("fr", "fr-a1-1", "match", "Match each word with its meaning", "", ["bonjour=hello", "au revoir=goodbye", "merci=thank you", "s'il vous plaît=please"], "Four words you will use constantly. They work in shops, cafés and on the street.", "")
defEx("fr", "fr-a1-1", "fill", "___ nuit ! (good night)", "Bonne", ["Bonne", "Bon", "Merci"], "Nuit is feminine, so the adjective takes -e: bonne. Bon goes with masculine nouns such as jour.", "Bonne nuit")
defEx("fr", "fr-a1-1", "fill", "Bon___ ! (hello / good day)", "jour", ["jour", "nuit", "soir"], "Bonjour = bon + jour. Nuit would need bonne, and soir would make bonsoir (good evening).", "Bonjour")
defEx("fr", "fr-a1-1", "translate", "Type “thank you” in French", "merci", [], "Merci. Add beaucoup for “thank you very much”.", "merci beaucoup")
defEx("fr", "fr-a1-1", "translate", "Type “goodbye” in French", "au revoir", [], "Au revoir, literally “until the seeing again”.", "")
defEx("fr", "fr-a1-1", "arrange", "Build: Good night", "Bonne nuit", ["Bonne", "nuit"], "Adjective first, then the feminine noun: bonne nuit.", "")
defEx("fr", "fr-a1-1", "listen", "", "Hello / good day", ["Hello / good day", "Good night", "Goodbye"], "Bonjour is the standard greeting from morning until the evening.", "Bonjour")
defEx("fr", "fr-a1-1", "speak", "The French “r” is made at the back of the throat: oh ruh-VWAHR.", "Goodbye", [], "Au revoir: the ending -oir sounds like “vwahr”, and the stress falls on the last syllable.", "Au revoir")
defRead("fr", "fr-a1-1", "A polite exchange", "Bonjour ! Merci. De rien. Au revoir !", ["Two people greet, thank each other and say goodbye.", "Someone asks for directions to the station.", "Someone orders coffee and bread."], "Bonjour = hello; merci = thanks; de rien = you're welcome; au revoir = goodbye.")
defEx("fr", "fr-a1-1", "convo", "At the bakery", "", ["Bonjour !|Hello!|Bonjour !|Bonne nuit !|Au revoir !|Return the same greeting. Bonne nuit is for bedtime, and au revoir is goodbye.", "Voilà.|Here you are.|Merci.|Au revoir.|Bonne nuit.|When something is handed to you, you thank them.", "De rien. Au revoir !|You're welcome. Goodbye!|Au revoir !|Bonjour !|Salut !|Finish with the matching goodbye."], "You greeted, thanked and said goodbye politely.", "")

// ---------- Lesson 2: Introducing yourself ----------
defLesson("fr", "fr-a1-2", "A1", "First contact", 2, "Who are you?", "Say your name and where you are from.", "“Être”: the verb for being", "Être (to be) is irregular: je suis (I am), tu es (you are), il/elle est (he/she is). French needs the subject pronoun every time, unlike Spanish. Before a vowel, je shortens to j' (j'ai), and de becomes d' (d'où). “Je m'appelle” literally means “I call myself”, so it replaces “my name is”. Jobs and nationalities agree with the person: a man says “je suis étudiant”, a woman says “je suis étudiante”, with an extra -e that you hear in the final consonant.", ["je suis|I am: je suis étudiant.", "tu es|You are (informal).", "il est / elle est|He is / she is.", "Je m'appelle …|“I call myself …”: how to give your name.", "étudiant / étudiante|The -e marks a woman and makes the t audible."], 14)
defWord("fr", "fr-a1-2", "je m'appelle", "zhuh ma-PEL", "my name is", "Je m'appelle Anna.", "My name is Anna.", "introductions", 1)
defWord("fr", "fr-a1-2", "Comment tu t'appelles ?", "ko-mahn too ta-PEL", "what is your name?", "Salut ! Comment tu t'appelles ?", "Hi! What's your name?", "introductions", 1)
defWord("fr", "fr-a1-2", "enchanté", "ahn-shahn-TAY", "nice to meet you", "Enchanté, Max.", "Nice to meet you, Max.", "introductions", 1)
defWord("fr", "fr-a1-2", "je suis", "zhuh swee", "I am", "Je suis étudiant.", "I am a student.", "verbs", 1)
defWord("fr", "fr-a1-2", "tu es", "too eh", "you are", "Tu es de Paris.", "You are from Paris.", "verbs", 1)
defWord("fr", "fr-a1-2", "Tu viens d'où ?", "too vyan DOO", "where are you from?", "Tu viens d'où ?", "Where are you from?", "introductions", 2)
defWord("fr", "fr-a1-2", "je viens de", "zhuh vyan duh", "I come from", "Je viens de Belgique.", "I come from Belgium.", "introductions", 1)
defWord("fr", "fr-a1-2", "étudiant", "ay-too-DYAHN", "student (male)", "Je suis étudiant.", "I am a student.", "people", 1)
defEx("fr", "fr-a1-2", "choice", "What does “enchanté” mean?", "nice to meet you", ["nice to meet you", "thank you very much", "good morning", "where are you from"], "Enchanté literally means “enchanted”: delighted to meet you.", "enchanté")
defEx("fr", "fr-a1-2", "choice", "Which means “you are”?", "tu es", ["tu es", "je suis", "il est", "je m'appelle"], "Tu es: tu is the informal “you”. Je suis is I am, and il est is he is.", "")
defEx("fr", "fr-a1-2", "fill", "Je ___ étudiant.", "suis", ["suis", "es", "est"], "Je always goes with suis. Es belongs to tu, and est to il/elle.", "Je suis étudiant")
defEx("fr", "fr-a1-2", "fill", "Tu ___ de Paris.", "es", ["es", "suis", "est"], "Tu takes es.", "Tu es de Paris")
defEx("fr", "fr-a1-2", "match", "Match the forms of être", "", ["je suis=I am", "tu es=you are", "il est=he is", "je m'appelle=my name is"], "Être is irregular, so learn each form. Je m'appelle is a separate phrase for names.", "")
defEx("fr", "fr-a1-2", "translate", "Say “I am a student” in French", "je suis étudiant", [], "French keeps the pronoun je. A woman adds -e: étudiante.", "je suis étudiante|je suis un étudiant|je suis une étudiante")
defEx("fr", "fr-a1-2", "translate", "Say “My name is Anna” in French", "je m'appelle anna", [], "Je m'appelle + name. It is a reflexive verb: literally “I call myself”.", "")
defEx("fr", "fr-a1-2", "arrange", "Build: What is your name?", "Comment tu t'appelles", ["Comment", "tu", "t'appelles"], "Question word first, then the subject and verb: how you call-yourself.", "")
defEx("fr", "fr-a1-2", "listen", "", "Where are you from?", ["Where are you from?", "What is your name?", "Nice to meet you"], "Tu viens d'où ? — d'où means “from where”.", "Tu viens d'où ?")
defEx("fr", "fr-a1-2", "speak", "Nasal vowel: en-chan-TÉ, the n is not pronounced separately.", "Nice to meet you", [], "Enchanté: the final -é sounds like “ay”, and the stress is on the last syllable.", "Enchanté")
defRead("fr", "fr-a1-2", "Max introduces himself", "Salut ! Je m'appelle Max. Je viens de Paris. Je suis étudiant.", ["Max gives his name, where he is from and that he is a student.", "Max asks where the hotel is.", "Max orders food."], "Je m'appelle Max = my name is Max; je viens de Paris = I come from Paris; je suis étudiant = I am a student.")
defEx("fr", "fr-a1-2", "convo", "Meeting someone new", "", ["Salut ! Comment tu t'appelles ?|Hi! What's your name?|Je m'appelle Sam.|Je suis Sam appelle.|Enchanté.|Je m'appelle + name gives your name.", "Enchanté. Tu viens d'où ?|Nice to meet you. Where are you from?|Je viens du Canada.|Je m'appelle Canada.|Tu viens du Canada.|Je viens de + place says where you are from.", "Super ! Au revoir !|Great! Goodbye!|Au revoir ! Enchanté.|Je m'appelle Sam.|Je suis étudiant.|End with the matching goodbye."], "You introduced yourself and said where you come from.", "")

// ---------- Lesson 3: Food and drink ----------
defLesson("fr", "fr-a1-3", "A1", "Everyday life", 3, "At the café", "Order food and drink politely.", "Two genders: le / la and un / une", "French nouns are masculine or feminine. “The” is le (masculine) or la (feminine); “a” is un or une. Before a vowel sound, both le and la shorten to l': l'eau, l'addition. The apostrophe hides the gender, so learn it as you learn the word: l'eau is feminine, l'hôtel is masculine. The polite way to order is “Je voudrais …” (I would like), which is gentler than “Je veux” (I want).", ["le / un|Masculine: le café, un café.", "la / une|Feminine: la pomme, une pomme.", "l'|Before a vowel the article shortens: l'eau (f), l'addition (f).", "Je voudrais …|“I would like …”: the polite way to order."], 15)
defWord("fr", "fr-a1-3", "le café", "luh ka-FAY", "coffee", "Je voudrais un café.", "I would like a coffee.", "food", 1)
defWord("fr", "fr-a1-3", "l'eau", "loh", "water", "Je voudrais de l'eau.", "I would like some water.", "food", 1)
defWord("fr", "fr-a1-3", "le pain", "luh PAN", "bread", "Le pain est bon.", "The bread is good.", "food", 1)
defWord("fr", "fr-a1-3", "le lait", "luh LEH", "milk", "Je voudrais du lait.", "I would like some milk.", "food", 1)
defWord("fr", "fr-a1-3", "la pomme", "la POM", "apple", "Je voudrais une pomme.", "I would like an apple.", "food", 1)
defWord("fr", "fr-a1-3", "je voudrais", "zhuh voo-DREH", "I would like", "Je voudrais un café.", "I would like a coffee.", "verbs", 1)
defWord("fr", "fr-a1-3", "l'addition", "la-dee-SYOHN", "the bill", "L'addition, s'il vous plaît.", "The bill, please.", "restaurant", 1)
defWord("fr", "fr-a1-3", "j'ai faim", "zhay FAN", "I am hungry", "J'ai faim. Je voudrais du pain.", "I'm hungry. I would like some bread.", "restaurant", 2)
defEx("fr", "fr-a1-3", "choice", "What does “le lait” mean?", "milk", ["milk", "water", "bread", "apple"], "Le lait is milk. The article le shows it is masculine.", "le lait")
defEx("fr", "fr-a1-3", "choice", "Which article goes with “pain”?", "le", ["le", "la"], "Pain is masculine, so le pain. Learn the gender with each noun.", "")
defEx("fr", "fr-a1-3", "fill", "Je voudrais ___ café. (a)", "un", ["un", "une", "la"], "Café is masculine, so “a” is un. Une is for feminine nouns.", "Je voudrais un café")
defEx("fr", "fr-a1-3", "fill", "Je voudrais ___ pomme. (an)", "une", ["une", "un", "le"], "Pomme is feminine, so “an/a” is une.", "Je voudrais une pomme")
defEx("fr", "fr-a1-3", "fill", "___ pain est bon. (the)", "Le", ["Le", "La", "Une"], "Pain is masculine, so “the” is le.", "Le pain est bon")
defEx("fr", "fr-a1-3", "match", "Match food and drink to meaning", "", ["le café=coffee", "l'eau=water", "le pain=bread", "le lait=milk"], "L'eau shows the elision: le/la shrink to l' before a vowel.", "")
defEx("fr", "fr-a1-3", "translate", "Say “I would like water” in French", "je voudrais de l'eau", [], "When you ask for a quantity of something, French adds de l' / du / de la: “de l'eau” means some water.", "je voudrais l'eau|je voudrais eau")
defEx("fr", "fr-a1-3", "translate", "Say “the bill” in French", "l'addition", [], "Addition starts with a vowel, so la becomes l'.", "addition|la addition|une addition")
defEx("fr", "fr-a1-3", "arrange", "Build: I would like a coffee", "Je voudrais un café", ["Je", "voudrais", "un", "café"], "Subject, verb, article, noun. Un matches the masculine café.", "")
defEx("fr", "fr-a1-3", "listen", "", "I'm hungry", ["I'm hungry", "I would like coffee", "The bill, please"], "J'ai faim literally says “I have hunger”: French uses avoir (to have).", "J'ai faim")
defEx("fr", "fr-a1-3", "speak", "Keep the vowels short: zhuh voo-DREH.", "I would like a coffee, please", [], "Je voudrais un café, s'il vous plaît: the stress falls on the last syllable of each group.", "Je voudrais un café, s'il vous plaît")
defRead("fr", "fr-a1-3", "At the café", "Bonjour. Je voudrais un café et du pain. Je voudrais de l'eau, s'il vous plaît. L'addition, s'il vous plaît.", ["Someone orders coffee, bread and water, then asks for the bill.", "Someone introduces their family.", "Someone asks where the station is."], "Je voudrais un café et du pain = I would like a coffee and some bread; l'addition, s'il vous plaît = the bill, please.")
defEx("fr", "fr-a1-3", "convo", "Ordering", "", ["Bonjour. Vous désirez ?|Hello. What would you like?|Je voudrais un café, s'il vous plaît.|Au revoir.|Enchanté.|Answer with je voudrais + what you want.", "Et avec ça ?|Anything else?|Du pain, s'il vous plaît.|Je suis étudiant.|Bonsoir.|Say what else you want, politely.", "Voilà.|Here you are.|Merci.|Je voudrais.|Je m'appelle Anna.|Thank them when you are handed something."], "You ordered politely using je voudrais and s'il vous plaît.", "")

// ---------- Lesson 4: Family ----------
defLesson("fr", "fr-a1-4", "A1", "Everyday life", 4, "My family", "Talk about your family and say what you have.", "“Mon, ma, mes”: possessives agree with the thing owned", "In French the possessive agrees with the noun that is owned, not with the owner. For one masculine noun use mon (mon père); for one feminine noun use ma (ma mère); for any plural use mes (mes parents). This is different from English, where “my” never changes. To say what you have, use avoir: j'ai (I have), with je shortened to j' before the vowel.", ["mon + masculine|mon père, mon frère.", "ma + feminine|ma mère, ma sœur.", "mes + plural|mes parents, mes frères.", "j'ai + noun|I have …: j'ai une sœur."], 14)
defWord("fr", "fr-a1-4", "la famille", "la fa-MEE", "family", "Ma famille est grande.", "My family is big.", "family", 1)
defWord("fr", "fr-a1-4", "la mère", "la MEHR", "mother", "Ma mère est professeure.", "My mother is a teacher.", "family", 1)
defWord("fr", "fr-a1-4", "le père", "luh PEHR", "father", "Mon père vient de Paris.", "My father comes from Paris.", "family", 1)
defWord("fr", "fr-a1-4", "le frère", "luh FREHR", "brother", "J'ai un frère.", "I have a brother.", "family", 1)
defWord("fr", "fr-a1-4", "la sœur", "la SUHR", "sister", "J'ai une sœur.", "I have a sister.", "family", 1)
defWord("fr", "fr-a1-4", "les parents", "lay pa-RAHN", "parents", "Mes parents sont gentils.", "My parents are kind.", "family", 2)
defWord("fr", "fr-a1-4", "mon / ma / mes", "mohn / ma / may", "my", "Mon père, ma mère, mes parents.", "My father, my mother, my parents.", "grammar", 1)
defWord("fr", "fr-a1-4", "j'ai", "zhay", "I have", "J'ai une famille.", "I have a family.", "verbs", 1)
defEx("fr", "fr-a1-4", "choice", "What does “la sœur” mean?", "sister", ["sister", "brother", "mother", "parents"], "La sœur is sister. Le frère is brother.", "la sœur")
defEx("fr", "fr-a1-4", "choice", "Which means “my sister”?", "ma sœur", ["ma sœur", "mon sœur", "mes sœur"], "Sœur is feminine and singular, so the possessive is ma.", "")
defEx("fr", "fr-a1-4", "fill", "J'ai une ___. (sister)", "sœur", ["sœur", "frère", "père"], "Une is feminine, so the noun must be feminine: sœur.", "J'ai une sœur")
defEx("fr", "fr-a1-4", "fill", "___ parents viennent de Paris. (my)", "Mes", ["Mes", "Mon", "Ma"], "Parents is plural, so “my” is mes.", "Mes parents viennent de Paris")
defEx("fr", "fr-a1-4", "fill", "J'ai ___ frère. (a)", "un", ["un", "une", "ma"], "Frère is masculine, so “a” is un.", "J'ai un frère")
defEx("fr", "fr-a1-4", "match", "Match the family words", "", ["la mère=mother", "le père=father", "le frère=brother", "la famille=family"], "Le and la show the gender, which decides whether you say mon or ma.", "")
defEx("fr", "fr-a1-4", "translate", "Say “my family” in French", "ma famille", [], "Famille is feminine, so ma.", "")
defEx("fr", "fr-a1-4", "translate", "Say “I have a brother” in French", "j'ai un frère", [], "J'ai = I have. Un agrees with the masculine frère.", "")
defEx("fr", "fr-a1-4", "arrange", "Build: I have a sister", "J'ai une sœur", ["J'ai", "une", "sœur"], "Verb, article, noun. Une matches the feminine sœur.", "")
defEx("fr", "fr-a1-4", "listen", "", "I have a sister", ["I have a sister", "I have a brother", "I have a family"], "Une sœur is feminine: sister.", "J'ai une sœur")
defEx("fr", "fr-a1-4", "speak", "The “œu” sound is like “uh” with rounded lips.", "I have a brother", [], "J'ai un frère: the r in frère is made in the throat, and un is a nasal vowel.", "J'ai un frère")
defRead("fr", "fr-a1-4", "Max and his family", "Je m'appelle Max. J'ai une sœur et un frère. Mes parents viennent de Paris.", ["Max talks about his name, his siblings and where his parents are from.", "Max orders a coffee.", "Max says goodbye."], "J'ai une sœur et un frère = I have a sister and a brother. Viennent is the plural of vient (they come).")
defEx("fr", "fr-a1-4", "choice", "Which one is correct?", "mon père", ["mon père", "ma père", "mes père"], "Père is masculine and singular, so mon.", "")

// ---------- Lesson 5: Getting around ----------
defLesson("fr", "fr-a1-5", "A1", "Getting around", 5, "Where is it?", "Ask where something is and follow simple directions.", "“Où est …?” and directions", "To ask where something is, begin with the question word: “Où est la gare ?”. The article shows the gender: la gare, la rue, l'hôtel. Directions are short fixed phrases: à droite (to the right), à gauche (to the left), tout droit (straight ahead). “Près d'ici” means nearby, literally “close from here”. Notice that est here means “is” in the sense of location, the same verb être you met in lesson 2.", ["Où est + article + place ?|Where is …? Question word first.", "à droite / à gauche|To the right / to the left.", "tout droit|Straight ahead.", "près d'ici|Nearby. Learn it as a chunk."], 15)
defWord("fr", "fr-a1-5", "Où est … ?", "oo EH", "where is …?", "Où est l'hôtel ?", "Where is the hotel?", "directions", 1)
defWord("fr", "fr-a1-5", "la rue", "la ROO", "street", "L'hôtel est dans la rue.", "The hotel is on the street.", "places", 1)
defWord("fr", "fr-a1-5", "la gare", "la GAHR", "train station", "Où est la gare ?", "Where is the train station?", "places", 1)
defWord("fr", "fr-a1-5", "l'hôtel", "loh-TEL", "hotel", "L'hôtel est à gauche.", "The hotel is on the left.", "places", 1)
defWord("fr", "fr-a1-5", "à droite", "ah DRWAHT", "to the right", "L'hôtel est à droite.", "The hotel is on the right.", "directions", 1)
defWord("fr", "fr-a1-5", "à gauche", "ah GOHSH", "to the left", "La gare est à gauche.", "The station is on the left.", "directions", 1)
defWord("fr", "fr-a1-5", "tout droit", "too DRWAH", "straight ahead", "Tout droit puis à droite.", "Straight ahead then right.", "directions", 2)
defWord("fr", "fr-a1-5", "près d'ici", "preh dee-SEE", "nearby", "La gare est près d'ici.", "The station is nearby.", "directions", 2)
defEx("fr", "fr-a1-5", "choice", "What does “à gauche” mean?", "to the left", ["to the left", "to the right", "straight ahead", "nearby"], "Gauche is left; droite is right.", "à gauche")
defEx("fr", "fr-a1-5", "choice", "Which asks “Where is the station?”", "Où est la gare ?", ["Où est la gare ?", "Comment tu t'appelles ?", "Tu viens d'où ?"], "Où means where. “Tu viens d'où ?” asks where you come from.", "")
defEx("fr", "fr-a1-5", "fill", "Où ___ l'hôtel ?", "est", ["est", "suis", "es"], "The hotel is a single thing (it), so the verb is est.", "Où est l'hôtel")
defEx("fr", "fr-a1-5", "fill", "L'hôtel est à ___. (right)", "droite", ["droite", "gauche", "la rue"], "Droite means right. Gauche would be left.", "L'hôtel est à droite")
defEx("fr", "fr-a1-5", "match", "Match places and directions", "", ["la rue=street", "la gare=station", "à gauche=left", "tout droit=straight ahead"], "Directions are fixed phrases: learn them whole.", "")
defEx("fr", "fr-a1-5", "translate", "Say “straight ahead” in French", "tout droit", [], "Tout droit is the standard phrase for going straight on.", "")
defEx("fr", "fr-a1-5", "translate", "Say “Where is the hotel?” in French", "où est l'hôtel", [], "Où est + l'hôtel. Hôtel starts with a silent h, so le becomes l'.", "ou est l'hotel")
defEx("fr", "fr-a1-5", "arrange", "Build: The station is nearby", "La gare est près d'ici", ["La", "gare", "est", "près d'ici"], "Subject, verb, then the fixed phrase près d'ici.", "")
defEx("fr", "fr-a1-5", "listen", "", "Straight ahead then right", ["Straight ahead then right", "Left then nearby", "The hotel is nearby"], "Tout droit puis à droite: go straight, then turn right.", "Tout droit puis à droite")
defEx("fr", "fr-a1-5", "speak", "The final -e of gare is silent; say GAHR.", "Where is the station?", [], "Où est la gare ? The “ou” in où sounds like English “oo”.", "Où est la gare ?")
defRead("fr", "fr-a1-5", "Finding the hotel", "L'hôtel est près d'ici. La gare est tout droit puis à gauche.", ["Directions to a hotel and a station.", "A family introduction.", "A bakery order."], "L'hôtel est près d'ici = the hotel is nearby; tout droit puis à gauche = straight ahead then left.")
defEx("fr", "fr-a1-5", "convo", "Asking for directions", "", ["Bonjour ! Vous avez besoin d'aide ?|Hello! Do you need help?|Oui. Où est la gare ?|Oui. Comment tu t'appelles ?|Je voudrais un café.|Oui means yes; then you ask where the station is.", "La gare est à droite.|The station is on the right.|Merci.|Enchanté.|J'ai faim.|Thank them for the directions.", "De rien. Au revoir !|You're welcome. Goodbye!|Au revoir !|Je m'appelle Anna.|Bonne nuit.|Say the matching goodbye."], "You asked for directions and finished politely.", "")

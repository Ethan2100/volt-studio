// =====================================================================
// POLYGLOT - content/de.volt  ·  German A1 (5 lessons)
// =====================================================================

// ---------- Lesson 1: Greetings and politeness ----------
defLesson("de", "de-a1-1", "A1", "First contact", 1, "Hello and thank you", "Greet people at any time of day and be polite.", "Why “Guten Morgen” but “Gute Nacht”?", "German greetings are what is left of a longer sentence: “Ich wünsche dir einen guten Morgen” (I wish you a good morning). The thing being wished for is the object, and German marks masculine objects with an extra -n: der Morgen, der Tag and der Abend are masculine, so they become einen guten … and the greeting shortens to “Guten Morgen”. Die Nacht is feminine, which does not change, so it stays “Gute Nacht”. You do not need the full grammar yet: learn each greeting as one block and notice that masculine words take -en.", ["Guten Morgen / Tag / Abend|Morgen, Tag and Abend are masculine, so the adjective gets -en.", "Gute Nacht|Nacht is feminine, so the adjective ends in -e.", "bitte|Does double duty: please, and also “you're welcome” or “here you are”.", "Tschüss|Informal goodbye. A more formal one is “Auf Wiedersehen”."], 12)
defWord("de", "de-a1-1", "Hallo", "HAH-loh", "hello", "Hallo, wie geht's?", "Hello, how are you?", "greetings", 1)
defWord("de", "de-a1-1", "Guten Morgen", "GOO-ten MOR-gen", "good morning", "Guten Morgen, Frau Müller.", "Good morning, Mrs Müller.", "greetings", 1)
defWord("de", "de-a1-1", "Guten Tag", "GOO-ten TAHK", "good day / hello", "Guten Tag, Herr Schmidt.", "Good day, Mr Schmidt.", "greetings", 1)
defWord("de", "de-a1-1", "Guten Abend", "GOO-ten AH-bent", "good evening", "Guten Abend, Anna.", "Good evening, Anna.", "greetings", 1)
defWord("de", "de-a1-1", "Gute Nacht", "GOO-teh NAKHT", "good night", "Gute Nacht, Mama.", "Good night, Mum.", "greetings", 1)
defWord("de", "de-a1-1", "Tschüss", "tshüss", "bye", "Tschüss, bis morgen!", "Bye, see you tomorrow!", "greetings", 1)
defWord("de", "de-a1-1", "bitte", "BIT-teh", "please / you're welcome", "Einen Kaffee, bitte.", "A coffee, please.", "politeness", 1)
defWord("de", "de-a1-1", "danke", "DAHN-keh", "thank you", "Danke schön!", "Thank you very much!", "politeness", 1)
defEx("de", "de-a1-1", "choice", "What does “danke” mean?", "thank you", ["thank you", "please", "goodbye", "hello"], "Danke = thank you. Bitte is please, and tschüss is goodbye.", "danke")
defEx("de", "de-a1-1", "choice", "Which greeting is for the evening?", "Guten Abend", ["Guten Abend", "Guten Morgen", "Gute Nacht", "Tschüss"], "Abend means evening. Morgen is morning, and Gute Nacht is only said when going to bed or leaving late.", "")
defEx("de", "de-a1-1", "match", "Match each word with its meaning", "", ["Hallo=hello", "Tschüss=bye", "danke=thank you", "bitte=please"], "Four words you will use every day. Bitte also means “you're welcome”.", "")
defEx("de", "de-a1-1", "fill", "Guten ___! (good morning)", "Morgen", ["Morgen", "Nacht", "Tschüss"], "Morgen is masculine, which is why the greeting has guten with -en. Nacht would need gute.", "Guten Morgen")
defEx("de", "de-a1-1", "fill", "___ Nacht! (good night)", "Gute", ["Gute", "Guten", "Danke"], "Nacht is feminine, so the adjective ends in -e: Gute Nacht. Guten is for masculine words like Morgen.", "Gute Nacht")
defEx("de", "de-a1-1", "translate", "Type “thank you” in German", "danke", [], "Danke is thank you. “Danke schön” is a warmer thank you very much.", "danke schön|danke schoen")
defEx("de", "de-a1-1", "translate", "Type “please” in German", "bitte", [], "Bitte is please. You can also hear it as “here you go” when handing something over.", "")
defEx("de", "de-a1-1", "arrange", "Build: Good evening", "Guten Abend", ["Guten", "Abend"], "Guten first: the adjective comes before the noun, and Abend is masculine.", "")
defEx("de", "de-a1-1", "listen", "", "Good day / hello", ["Good day / hello", "Good night", "Goodbye"], "Guten Tag is the standard daytime greeting, used from morning until evening.", "Guten Tag")
defEx("de", "de-a1-1", "speak", "Sound the “g” in Morgen hard, like “go”: MOR-gen.", "Good morning", [], "Guten Morgen: the u in Guten is long (GOO), and the final -en is spoken softly.", "Guten Morgen")
defRead("de", "de-a1-1", "A polite exchange", "Guten Morgen! Danke. Bitte. Tschüss!", ["Two people greet each other, thank each other and say goodbye.", "Someone asks for directions to the station.", "Someone orders coffee and bread."], "Guten Morgen = good morning, danke = thanks, bitte = you're welcome, tschüss = bye.")
defEx("de", "de-a1-1", "convo", "At the bakery", "", ["Guten Tag!|Good day!|Guten Tag!|Gute Nacht!|Tschüss!|Return the same greeting. Gute Nacht is for bedtime and tschüss is goodbye.", "Hier, bitte.|Here you are.|Danke.|Tschüss.|Gute Nacht.|When someone hands you something, thank them with danke.", "Bitte schön. Tschüss!|You're welcome. Bye!|Tschüss!|Guten Morgen!|Hallo!|Close with the matching goodbye."], "You greeted, thanked and said goodbye politely.", "")

// ---------- Lesson 2: Introducing yourself ----------
defLesson("de", "de-a1-2", "A1", "First contact", 2, "Who are you?", "Say your name and where you are from.", "“Sein”: the verb for being", "The verb sein (to be) is irregular, so learn its forms by heart: ich bin (I am), du bist (you are), er/sie/es ist (he/she/it is). Unlike Spanish, German keeps the pronoun: you must say “Ich bin Max”. German verbs also sit in second position in a statement, which is why questions that start with a question word keep the verb right after it: “Woher kommst du?” (Where from come you?). “Ich heiße” literally means “I am called”, so it takes the place of “my name is”.", ["ich bin|I am: ich bin Student.", "du bist|You are (informal, to a friend or a child).", "er / sie / es ist|He, she, it is.", "Ich heiße …|“I am called …”, the normal way to give your name.", "Verb in second place|The verb is always the second item: Ich komme aus Berlin."], 14)
defWord("de", "de-a1-2", "ich heiße", "ikh HY-seh", "my name is", "Ich heiße Anna.", "My name is Anna.", "introductions", 1)
defWord("de", "de-a1-2", "Wie heißt du?", "vee hyst doo", "what is your name?", "Hallo! Wie heißt du?", "Hi! What's your name?", "introductions", 1)
defWord("de", "de-a1-2", "Freut mich", "froyt mikh", "nice to meet you", "Freut mich, Max.", "Nice to meet you, Max.", "introductions", 1)
defWord("de", "de-a1-2", "ich bin", "ikh bin", "I am", "Ich bin Student.", "I am a student.", "verbs", 1)
defWord("de", "de-a1-2", "du bist", "doo bist", "you are", "Du bist aus Berlin.", "You are from Berlin.", "verbs", 1)
defWord("de", "de-a1-2", "Woher kommst du?", "voh-HAIR komst doo", "where are you from?", "Woher kommst du?", "Where are you from?", "introductions", 2)
defWord("de", "de-a1-2", "ich komme aus", "ikh KOM-meh ows", "I come from", "Ich komme aus Österreich.", "I come from Austria.", "introductions", 1)
defWord("de", "de-a1-2", "der Student", "dair shtoo-DENT", "student (male)", "Ich bin Student.", "I am a student.", "people", 1)
defEx("de", "de-a1-2", "choice", "What does “Freut mich” mean?", "nice to meet you", ["nice to meet you", "thank you very much", "good morning", "where are you from"], "“Freut mich” means “it pleases me”: the polite reaction when you meet someone.", "Freut mich")
defEx("de", "de-a1-2", "choice", "Which means “you are”?", "du bist", ["du bist", "ich bin", "er ist", "ich heiße"], "Du bist: du is the informal “you”. Ich bin is I am, and er ist is he is.", "")
defEx("de", "de-a1-2", "fill", "Ich ___ Student.", "bin", ["bin", "bist", "ist"], "Ich (I) always goes with bin. Bist belongs to du, and ist to er/sie/es.", "Ich bin Student")
defEx("de", "de-a1-2", "fill", "Du ___ aus Berlin.", "bist", ["bist", "bin", "ist"], "Du (you) takes bist.", "Du bist aus Berlin")
defEx("de", "de-a1-2", "match", "Match the forms of sein", "", ["ich bin=I am", "du bist=you are", "er ist=he is", "ich heiße=my name is"], "Sein is irregular, so these forms must be memorised. Heißen is a different verb used for names.", "")
defEx("de", "de-a1-2", "translate", "Say “I am a student” in German", "ich bin student", [], "German keeps the pronoun ich. With jobs you can drop the article: Ich bin Student.", "ich bin ein student")
defEx("de", "de-a1-2", "translate", "Say “My name is Anna” in German", "ich heiße anna", [], "Ich heiße + name. You may also say “Mein Name ist Anna”.", "ich heisse anna|mein name ist anna")
defEx("de", "de-a1-2", "arrange", "Build: What is your name?", "Wie heißt du?", ["Wie", "heißt", "du?"], "Question word first, then the verb in second place, then the subject.", "")
defEx("de", "de-a1-2", "listen", "", "Where are you from?", ["Where are you from?", "What is your name?", "Nice to meet you"], "Woher kommst du? — woher = from where, kommst = come, du = you.", "Woher kommst du?")
defEx("de", "de-a1-2", "speak", "The “ch” in ich is a soft hiss, not a “k”.", "My name is Anna", [], "Ich heiße Anna: the ei in heiße sounds like English “eye”, and ß is a long “s”.", "Ich heiße Anna")
defRead("de", "de-a1-2", "Max introduces himself", "Hallo! Ich heiße Max. Ich komme aus Berlin. Ich bin Student.", ["Max gives his name, where he is from and that he is a student.", "Max asks where the hotel is.", "Max orders food."], "Ich heiße Max = my name is Max; ich komme aus Berlin = I come from Berlin; ich bin Student = I am a student.")
defEx("de", "de-a1-2", "convo", "Meeting someone new", "", ["Hallo! Wie heißt du?|Hi! What's your name?|Ich heiße Sam.|Ich bin Sam heißt.|Freut mich.|Ich heiße + name gives your name.", "Freut mich. Woher kommst du?|Nice to meet you. Where are you from?|Ich komme aus Kanada.|Ich heiße Kanada.|Du kommst aus Kanada.|Ich komme aus + place says where you are from.", "Schön! Tschüss!|Nice! Bye!|Tschüss! Freut mich.|Ich heiße Sam.|Ich bin Student.|End with the matching goodbye."], "You introduced yourself and said where you come from.", "")

// ---------- Lesson 3: Food and drink ----------
defLesson("de", "de-a1-3", "A1", "Everyday life", 3, "At the café", "Order food and drink politely.", "Three genders: der, die, das", "German nouns have three genders, shown by the article: der (masculine), die (feminine), das (neuter). The gender is not predictable from meaning, so learn the article with every noun: der Kaffee, die Milch, das Brot. To order, use the polite “Ich möchte …” (I would like). The thing you order is the object, and masculine objects change ein to einen: “Ich möchte einen Kaffee”. Feminine (eine Milch) and neuter (ein Brot) stay the same.", ["der / ein|Masculine: der Kaffee, ein Kaffee.", "die / eine|Feminine: die Milch, eine Milch.", "das / ein|Neuter: das Brot, ein Brot.", "Ich möchte einen …|Masculine objects take einen: einen Kaffee, einen Apfel.", "Ich möchte eine / ein …|Feminine takes eine, neuter takes ein."], 15)
defWord("de", "de-a1-3", "der Kaffee", "dair KAF-feh", "coffee", "Ich möchte einen Kaffee.", "I would like a coffee.", "food", 1)
defWord("de", "de-a1-3", "das Wasser", "dahs VAS-ser", "water", "Ich möchte Wasser, bitte.", "I would like water, please.", "food", 1)
defWord("de", "de-a1-3", "das Brot", "dahs BROHT", "bread", "Das Brot ist gut.", "The bread is good.", "food", 1)
defWord("de", "de-a1-3", "die Milch", "dee MILKH", "milk", "Ich möchte eine Milch.", "I would like a milk.", "food", 1)
defWord("de", "de-a1-3", "der Apfel", "dair AP-fel", "apple", "Ich möchte einen Apfel.", "I would like an apple.", "food", 1)
defWord("de", "de-a1-3", "ich möchte", "ikh MURKH-teh", "I would like", "Ich möchte einen Kaffee.", "I would like a coffee.", "verbs", 1)
defWord("de", "de-a1-3", "die Rechnung", "dee REKH-noong", "the bill", "Die Rechnung, bitte.", "The bill, please.", "restaurant", 1)
defWord("de", "de-a1-3", "ich habe Hunger", "ikh HAH-beh HOONG-er", "I am hungry", "Ich habe Hunger. Ich möchte Brot.", "I'm hungry. I would like bread.", "restaurant", 2)
defEx("de", "de-a1-3", "choice", "What does “die Milch” mean?", "milk", ["milk", "water", "bread", "apple"], "Die Milch is milk. The article die tells you it is feminine.", "die Milch")
defEx("de", "de-a1-3", "choice", "Which article goes with “Brot”?", "das", ["das", "der", "die"], "Brot is neuter, so das Brot. There is no rule to guess this, so learn the article with the noun.", "")
defEx("de", "de-a1-3", "fill", "Ich möchte ___ Kaffee. (a)", "einen", ["einen", "eine", "ein"], "Kaffee is masculine and is the thing you order (the object), so ein becomes einen.", "Ich möchte einen Kaffee")
defEx("de", "de-a1-3", "fill", "Ich möchte ___ Milch. (a)", "eine", ["eine", "einen", "ein"], "Milch is feminine, so “a” is eine.", "Ich möchte eine Milch")
defEx("de", "de-a1-3", "fill", "Ich möchte ___ Brot. (a)", "ein", ["ein", "einen", "eine"], "Brot is neuter, so “a” is ein.", "Ich möchte ein Brot")
defEx("de", "de-a1-3", "match", "Match food and drink to meaning", "", ["der Kaffee=coffee", "das Wasser=water", "das Brot=bread", "die Milch=milk"], "Notice that the article shows the gender, so learn them together.", "")
defEx("de", "de-a1-3", "translate", "Say “I would like water” in German", "ich möchte wasser", [], "Ich möchte + noun. Water needs no article when you order it in general.", "ich mochte wasser|ich möchte ein wasser")
defEx("de", "de-a1-3", "translate", "Say “the bill” in German", "die rechnung", [], "Rechnung is feminine, so die Rechnung.", "")
defEx("de", "de-a1-3", "arrange", "Build: I would like bread", "Ich möchte ein Brot", ["Ich", "möchte", "ein", "Brot"], "Subject, verb in second place, then the article and noun. Brot is neuter, so ein.", "")
defEx("de", "de-a1-3", "listen", "", "I'm hungry", ["I'm hungry", "I would like coffee", "The bill, please"], "Ich habe Hunger literally says “I have hunger”.", "Ich habe Hunger")
defEx("de", "de-a1-3", "speak", "Say möchte with rounded lips: MURKH-teh.", "I would like a coffee, please", [], "Ich möchte einen Kaffee, bitte. In Kaffee the stress is on the first syllable.", "Ich möchte einen Kaffee, bitte")
defRead("de", "de-a1-3", "At the café", "Guten Tag. Ich möchte einen Kaffee und ein Brot. Ich möchte Wasser, bitte. Die Rechnung, bitte.", ["Someone orders coffee, bread and water, then asks for the bill.", "Someone introduces their family.", "Someone asks where the station is."], "Ich möchte einen Kaffee und ein Brot = I would like a coffee and a bread; die Rechnung, bitte = the bill, please.")
defEx("de", "de-a1-3", "convo", "Ordering", "", ["Guten Tag. Was möchten Sie?|Good day. What would you like?|Ich möchte einen Kaffee, bitte.|Tschüss.|Freut mich.|Answer with ich möchte + what you want.", "Sonst noch etwas?|Anything else?|Ein Brot, bitte.|Ich bin Student.|Guten Morgen.|Say what else you want, politely.", "Hier, bitte.|Here you are.|Danke.|Ich möchte.|Ich heiße Anna.|Thank them when you are handed something."], "You ordered politely using ich möchte and bitte.", "")

// ---------- Lesson 4: Family ----------
defLesson("de", "de-a1-4", "A1", "Everyday life", 4, "My family", "Talk about your family and say what you have.", "“Mein” and “meine”: possessives take endings", "Possessive words such as mein (my) follow the same endings as ein. With masculine and neuter singular nouns, use mein: mein Vater, mein Bruder. With feminine nouns and with all plurals, add -e: meine Mutter, meine Schwester, meine Eltern. To say what you have, use haben: ich habe. As a masculine object, “a brother” becomes einen Bruder, but a feminine one stays eine Schwester.", ["mein + masculine / neuter|mein Vater, mein Bruder.", "meine + feminine / plural|meine Mutter, meine Schwester, meine Eltern.", "ich habe + object|I have …: ich habe eine Schwester.", "einen Bruder|A masculine object takes einen."], 14)
defWord("de", "de-a1-4", "die Familie", "dee fah-MEE-lyeh", "family", "Meine Familie ist groß.", "My family is big.", "family", 1)
defWord("de", "de-a1-4", "die Mutter", "dee MOOT-ter", "mother", "Meine Mutter ist Lehrerin.", "My mother is a teacher.", "family", 1)
defWord("de", "de-a1-4", "der Vater", "dair FAH-ter", "father", "Mein Vater kommt aus Berlin.", "My father comes from Berlin.", "family", 1)
defWord("de", "de-a1-4", "der Bruder", "dair BROO-der", "brother", "Ich habe einen Bruder.", "I have a brother.", "family", 1)
defWord("de", "de-a1-4", "die Schwester", "dee SHVES-ter", "sister", "Ich habe eine Schwester.", "I have a sister.", "family", 1)
defWord("de", "de-a1-4", "die Eltern", "dee EL-tern", "parents", "Meine Eltern sind nett.", "My parents are nice.", "family", 2)
defWord("de", "de-a1-4", "mein / meine", "mine / MY-neh", "my", "Mein Bruder, meine Schwester.", "My brother, my sister.", "grammar", 1)
defWord("de", "de-a1-4", "ich habe", "ikh HAH-beh", "I have", "Ich habe eine Familie.", "I have a family.", "verbs", 1)
defEx("de", "de-a1-4", "choice", "What does “die Schwester” mean?", "sister", ["sister", "brother", "mother", "parents"], "Die Schwester is sister. Der Bruder is brother.", "die Schwester")
defEx("de", "de-a1-4", "choice", "Which means “my sister”?", "meine Schwester", ["meine Schwester", "mein Schwester", "meiner Schwester"], "Schwester is feminine, so the possessive takes -e: meine.", "")
defEx("de", "de-a1-4", "fill", "Ich habe eine ___. (sister)", "Schwester", ["Schwester", "Bruder", "Vater"], "Eine is feminine, so the noun must be feminine: Schwester.", "Ich habe eine Schwester")
defEx("de", "de-a1-4", "fill", "___ Eltern kommen aus Berlin. (my)", "Meine", ["Meine", "Mein", "Eine"], "Eltern is plural, and plurals take -e: meine.", "Meine Eltern kommen aus Berlin")
defEx("de", "de-a1-4", "fill", "Ich habe ___ Bruder. (a)", "einen", ["einen", "eine", "ein"], "Bruder is masculine and is the object, so ein becomes einen.", "Ich habe einen Bruder")
defEx("de", "de-a1-4", "match", "Match the family words", "", ["die Mutter=mother", "der Vater=father", "der Bruder=brother", "die Familie=family"], "Der and die show the gender, which decides whether you say mein or meine.", "")
defEx("de", "de-a1-4", "translate", "Say “my family” in German", "meine familie", [], "Familie is feminine, so meine.", "")
defEx("de", "de-a1-4", "translate", "Say “I have a brother” in German", "ich habe einen bruder", [], "Bruder is masculine, so “a” is einen when it is the object.", "")
defEx("de", "de-a1-4", "arrange", "Build: I have a sister", "Ich habe eine Schwester", ["Ich", "habe", "eine", "Schwester"], "Subject, verb, article, noun. Eine matches the feminine Schwester.", "")
defEx("de", "de-a1-4", "listen", "", "I have a sister", ["I have a sister", "I have a brother", "I have a family"], "Eine Schwester is feminine: sister.", "Ich habe eine Schwester")
defEx("de", "de-a1-4", "speak", "Say “sch” in Schwester like English “sh”: SHVES-ter.", "I have a brother", [], "Ich habe einen Bruder: the b in haben is soft, and the r in Bruder is pronounced in the throat.", "Ich habe einen Bruder")
defRead("de", "de-a1-4", "Max and his family", "Ich heiße Max. Ich habe eine Schwester und einen Bruder. Meine Eltern kommen aus Berlin.", ["Max talks about his name, his siblings and where his parents are from.", "Max orders a coffee.", "Max says goodbye."], "Ich habe eine Schwester und einen Bruder = I have a sister and a brother. Kommen is the plural of komme (they come).")
defEx("de", "de-a1-4", "choice", "Which one is correct?", "mein Vater", ["mein Vater", "meine Vater", "meiner Vater"], "Vater is masculine, so the possessive is mein with no ending.", "")

// ---------- Lesson 5: Getting around ----------
defLesson("de", "de-a1-5", "A1", "Getting around", 5, "Where is it?", "Ask where something is and follow simple directions.", "“Wo ist …?” and directions", "To ask where something is, put the question word first and the verb ist right after it: “Wo ist der Bahnhof?”. The article tells you the gender: der Bahnhof, die Straße, das Hotel. Directions are short words with no article: rechts (right), links (left), geradeaus (straight ahead). “In der Nähe” means nearby; der after in is a form of die, because Nähe is feminine and takes a different case after in.", ["Wo ist + article + place?|Where is …? Question word, then ist.", "rechts / links|Right and left. No article needed.", "geradeaus|Straight ahead: one word.", "in der Nähe|Nearby. Learn it as a fixed phrase."], 15)
defWord("de", "de-a1-5", "Wo ist …?", "voh ist", "where is …?", "Wo ist das Hotel?", "Where is the hotel?", "directions", 1)
defWord("de", "de-a1-5", "die Straße", "dee SHTRAH-seh", "street", "Das Hotel ist in der Straße.", "The hotel is on the street.", "places", 1)
defWord("de", "de-a1-5", "der Bahnhof", "dair BAHN-hohf", "train station", "Wo ist der Bahnhof?", "Where is the train station?", "places", 1)
defWord("de", "de-a1-5", "das Hotel", "dahs hoh-TEL", "hotel", "Das Hotel ist links.", "The hotel is on the left.", "places", 1)
defWord("de", "de-a1-5", "rechts", "rekhts", "right", "Das Hotel ist rechts.", "The hotel is on the right.", "directions", 1)
defWord("de", "de-a1-5", "links", "links", "left", "Der Bahnhof ist links.", "The station is on the left.", "directions", 1)
defWord("de", "de-a1-5", "geradeaus", "geh-RAH-deh-ows", "straight ahead", "Geradeaus und dann rechts.", "Straight ahead and then right.", "directions", 2)
defWord("de", "de-a1-5", "in der Nähe", "in dair NAY-eh", "nearby", "Der Bahnhof ist in der Nähe.", "The station is nearby.", "directions", 2)
defEx("de", "de-a1-5", "choice", "What does “links” mean?", "left", ["left", "right", "straight ahead", "nearby"], "Links is left; rechts is right.", "links")
defEx("de", "de-a1-5", "choice", "Which asks “Where is the station?”", "Wo ist der Bahnhof?", ["Wo ist der Bahnhof?", "Wie heißt du?", "Woher kommst du?"], "Wo means where. Woher asks where from, which is a different question.", "")
defEx("de", "de-a1-5", "fill", "Wo ___ das Hotel?", "ist", ["ist", "bin", "bist"], "The hotel is a single thing (it), so the verb is ist.", "Wo ist das Hotel")
defEx("de", "de-a1-5", "fill", "Das Hotel ist ___. (right)", "rechts", ["rechts", "links", "geradeaus"], "Rechts means right. Links would be left.", "Das Hotel ist rechts")
defEx("de", "de-a1-5", "match", "Match places and directions", "", ["die Straße=street", "der Bahnhof=station", "links=left", "geradeaus=straight ahead"], "Learn places with their articles, directions without.", "")
defEx("de", "de-a1-5", "translate", "Say “straight ahead” in German", "geradeaus", [], "Geradeaus is a single word.", "")
defEx("de", "de-a1-5", "translate", "Say “Where is the hotel?” in German", "wo ist das hotel", [], "Wo ist + das Hotel. Hotel is neuter.", "")
defEx("de", "de-a1-5", "arrange", "Build: The station is nearby", "Der Bahnhof ist in der Nähe", ["Der", "Bahnhof", "ist", "in der Nähe"], "Subject, verb in second place, then the fixed phrase in der Nähe.", "")
defEx("de", "de-a1-5", "listen", "", "Straight ahead and then right", ["Straight ahead and then right", "Left and then nearby", "The hotel is nearby"], "Geradeaus und dann rechts: go straight, then turn right.", "Geradeaus und dann rechts")
defEx("de", "de-a1-5", "speak", "The “st” at the start of Straße sounds like “sht”.", "Where is the station?", [], "Wo ist der Bahnhof? The h in Bahnhof makes the a long: BAHN-hohf.", "Wo ist der Bahnhof?")
defRead("de", "de-a1-5", "Finding the hotel", "Das Hotel ist in der Nähe. Der Bahnhof ist geradeaus und dann links.", ["Directions to a hotel and a station.", "A family introduction.", "A bakery order."], "Das Hotel ist in der Nähe = the hotel is nearby; geradeaus und dann links = straight ahead and then left.")
defEx("de", "de-a1-5", "convo", "Asking for directions", "", ["Hallo! Brauchen Sie Hilfe?|Hi! Do you need help?|Ja. Wo ist der Bahnhof?|Ja. Wie heißt du?|Ich möchte Kaffee.|Ja means yes; then you ask where the station is.", "Der Bahnhof ist rechts.|The station is on the right.|Danke.|Freut mich.|Ich habe Hunger.|Thank them for the directions.", "Bitte. Tschüss!|You're welcome. Bye!|Tschüss!|Ich heiße Anna.|Gute Nacht.|Say the matching goodbye."], "You asked for directions and finished politely.", "")

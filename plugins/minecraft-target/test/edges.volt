#minecraft
// the places Minecraft's maths disagrees with Volt's
print 7 / 2
print (0 - 7) / 2
print 7 / (0 - 2)
print (0 - 7) / (0 - 2)
print 7 % 3
print (0 - 7) % 3
print 7 % (0 - 3)
print abs(0 - 9)
print min(4, 7) + max(4, 7)
print sign(0 - 3)
print sign(0)
print constrain(99, 0, 10)
print map(5, 0, 10, 0, 100)
print map(3, 0, 10, 0, 100)
let flag = 3 > 2
print flag
print "flag is " + flag
print 10 == 10

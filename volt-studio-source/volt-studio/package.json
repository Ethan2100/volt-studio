{
  "name": "volt-studio",
  "productName": "Volt Studio",
  "version": "1.3.1",
  "description": "Editor for the Volt language: write Volt once, turn it into Arduino C++, MicroPython, Python, Ruby, JavaScript or a web page.",
  "main": "main.js",
  "author": "Ethan",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win",
    "dist:portable": "electron-builder --win portable",
    "compile": "node compiler/volt.js",
    "installer": "electron-builder --win dir --x64 && makensis -DVERSION=%npm_package_version% installer/installer.nsi"
  },
  "dependencies": {
    "codemirror": "5.65.21",
    "marked": "12.0.2",
    "serialport": "^12.0.0"
  },
  "devDependencies": {
    "electron": "^45.0.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.ethan.voltstudio",
    "productName": "Volt Studio",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "lib/**",
      "compiler/**",
      "renderer/**",
      "examples/**",
      "docs/**",
      "build/icon.png",
      "node_modules/**",
      "!node_modules/@serialport/bindings-cpp/build/**"
    ],
    "fileAssociations": [
      {
        "ext": "volt",
        "name": "Volt program",
        "description": "Volt program"
      }
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "Volt Studio"
    },
    "npmRebuild": false
  }
}

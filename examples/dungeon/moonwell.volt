fn buildLevel() {
  clearLists()
  rows = maps[floor]
  MH = length(rows)
  MW = length(rows[0])
  bossKind = floorBoss[floor]
  bossMax = kindLife[bossKind]
  // read the map letters
  for ty from 0 to MH - 1 {
    for tx from 0 to MW - 1 {
      let ch = rows[ty][tx]
      let keep = ch
      if ch == "P" {
        hx = tx * 16 + 3
        hy = ty * 16 + 6
        keep = "."
      } else if contains(kindLetters, ch) and ch != "-" {
        let k = 1
        while k < 14 {
          if kindLetters[k] == ch {
            if k == 5 {
              spawnEnemy(bossKind, tx, ty)
            } else {
              spawnEnemy(k, tx, ty)
            }
          }
          k += 1
        }
        keep = "."
      } else if ch == "$" or ch == "h" {
        add tx * 16 + 8 to ix
        add ty * 16 + 8 to iy
        if ch == "$" {
          add 1 to ikind
        } else {
          add 2 to ikind
        }
        keep = "."
      } else if ch == "k" or ch == "c" or ch == "w" {
        add tx to chx
        add ty to chy
        if ch == "k" {
          add 1 to chWhat
        } else if ch == "c" {
          add 2 to chWhat
        } else {
          add 3 to chWhat
        }
        add 0 to chOpen
        keep = "C"
      } else if ch == "L" {
        ladX = tx
        ladY = ty
        keep = "."
      } else if ch == "*" {
        if not contains(shardFloors, floor) {
          add tx * 16 + 8 to ix
          add ty * 16 + 8 to iy
          add 3 to ikind
        }
        keep = "."
      } else if ch == "u" or ch == "v" {
        add tx * 16 + 8 to lightX
        add ty * 16 + 8 to lightY
        if ch == "u" {
          add "#6fc3ff" to lightCol
        } else {
          add "#ff6a1f" to lightCol
        }
      } else if ch == "K" {
        mageX = tx
        mageY = ty
      } else if ch == "q" {
        add tx to skx
        add ty to sky
        add length(skx) - 1 to skIdx
      } else if floor == 0 and contains("adejln", ch) {
        add tx to shx
        add ty to shy
        let gItem = 11
        if ch == "d" {
          gItem = 12
        } else if ch == "e" {
          gItem = 13
        } else if ch == "j" {
          gItem = 14
        } else if ch == "l" {
          gItem = 15
        } else if ch == "n" {
          gItem = 16
        }
        add gItem to shItem
        keep = "1"
      } else if floor == 0 and contains("pUVXY", ch) {
        add tx to shx
        add ty to shy
        let eItem = 17
        if ch == "U" {
          eItem = 18
        } else if ch == "V" {
          eItem = 19
        } else if ch == "X" {
          eItem = 20
        } else if ch == "Y" {
          eItem = 21
        }
        add eItem to shItem
        keep = "1"
      } else if contains("1234567890", ch) {
        add tx to shx
        add ty to shy
        let itemNo = number(ch)
        if itemNo == 0 {
          itemNo = 10
        }
        add itemNo to shItem
      } else if ch == "D" {
        if rows[ty][tx - 1] != "D" {
          add tx to drx
          add ty to dry
          add false to drOpen
        }
      }
      add keep to grid
    }
  }
  // the travellers stand where they can't be walked through
  if floor == 0 and questsOpen() {
    let nn = 0
    while nn < npcCount() {
      grid[npcY[nn] * MW + npcX[nn]] = "K"
      nn += 1
    }
  }
  placeSecret()
  // choose a picture for every cell
  for ty from 0 to MH - 1 {
    for tx from 0 to MW - 1 {
      let pic = 0
      let ch = grid[ty * MW + tx]
      let below = cell(tx, ty + 1)
      if isWall(tx, ty) {
        if not isWall(tx, ty + 1) and below != "#" {
          pic = 10
          if ch == "b" {
            // banner colours change with the floor
            pic = 11 + (tx + ty) % 2 + (floor % 2) * 2
          }
          if ch == "f" {
            pic = 15
          }
          if ch == "r" {
            pic = 16
          }
        } else if contains("bfr", below) or (below == "#" and not isWall(tx, ty + 2)) {
          pic = 20
          if contains("fr", below) {
            pic = 21
          }
        }
      } else {
        pic = 1
        if random(1, 100) > 86 {
          pic = random(2, 8)
        }
      }
      add pic to look
      // edges: 1 = open to the right, 2 = open to the left, 4 = open above
      let e = 0
      if isWall(tx, ty) and (pic == 0 or pic == 20 or pic == 21) {
        if not isWall(tx + 1, ty) {
          e += 1
        }
        if not isWall(tx - 1, ty) {
          e += 2
        }
        if not isWall(tx, ty - 1) {
          e += 4
        }
      }
      add e to edge
    }
  }
  if floor == 0 {
    addStand(32, 13, 7)
    if contains(skinsOwned, 6) {
      addSecretStand()
    }
  }
  checkX = hx
  checkY = hy
  bossAwake = false
  bossDead = floor == 0
  bossAngry = false
  bossShot = 0
  bossWind = 0
  bossRush = 0
  keys = 0
  hurt = 0
  swing = 0
  dash = 0
  dying = 0
  faceX = 0
  faceY = -1
  camX = constrain(hx + 5 - 160, 0, MW * 16 - 320)
  camY = constrain(hy - 86, 0, MH * 16 - 180)
}

// =====================================================================
//  Journeys: new, continue, save, and moving between floors
// =====================================================================
fn saveGame() {
  let data = [floor, nextFloor, coins, maxHp, weapon, playTime]
  for each w in owned {
    add w to data
  }
  save "moonwell", data
  save "pack", inv
  save "gear", [smithLv, hasCharm, hasFang]
  save "ench", ench
  save "stats", stats
  save "ach", ach
}

fn enterFloor(f) {
  floor = f
  let reached = f
  if f == 0 {
    reached = nextFloor
  }
  let wasLocked = deepest < vaultFloor
  if reached > deepest {
    deepest = reached
    save "deepest", deepest
  }
  fireTaps = 0
  invOpen = false
  if f > 0 {
    questAdd(3, 0, f)
  }
  buildLevel()
  hp = maxHp
  fadeIn = 30
  mode = 1
  saveGame()
  sound jingleFloor volume 80
  if floor == 0 {
    say("THE REST CAMP\nA quiet cave between the floors.")
    say("MAGE:\nAh, a knight! Follow the paths: supplies\nand arms to the left, fine clothes to the\nright, and my vault right here.")
    if deepest < vaultFloor {
      say("MAGE:\nMy vault stays sealed until you've\nreached floor " + vaultFloor + ". Its treasures are... special.")
    } else if wasLocked {
      say("MAGE:\nYou've come far. The VAULT is open!\nThe Moonblade, the Starfall Staff... and\na Celestial look... and I can enchant your\ngear. Just talk to me!")
    } else if not contains(owned, 6) or not contains(owned, 7) {
      say("MAGE:\nThe Moonblade, 500 gold. The Starfall Staff,\n550. Worth every coin, I promise.")
    }
    if length(skinsOwned) < 6 {
      say("MAGE:\nAnd new looks in the wardrobe, if you\nfancy dressing like a hero.")
    }
    if questsOpen() and not seenNpcs {
      seenNpcs = true
      say("Three travellers have gathered by the fire\nnow that the Ember King is gone. Perhaps\nthey have work for the last knight.")
    }
  } else if floor == 2 {
    say("FLOOR 2: THE DROWNED CRYPT\nCold water drips. Something shuffles in the dark.")
    say("One key opens the crypt's great door.\nThe Warden waits beyond it.")
  } else if floor == 3 {
    say("FLOOR 3: THE FROZEN OSSUARY\nBones and frost. Your breath hangs in the air.")
    say("Vael, the Necromancer Lord, guards the way\ndown. The key lies somewhere in the cold.")
  } else if floor == 4 {
    say("FLOOR 4: THE ORC WARRENS\nDrums echo through the tunnels.")
    say("Warlord Krag rules here. Find the key\nto his war hall... and watch for his charge.")
  } else if floor == 5 {
    say("FLOOR 5: THE IMP FURNACE\nThe air shimmers with heat.")
    say("Ignis, the Chort Queen, vanishes and\nreappears. Keep moving.")
  } else if floor == 6 {
    say("FLOOR 6: THE EMBER THRONE\nThe walls glow red. He is close now.")
    say("Two keys, two doors. Then the throne.")
  } else if floor == 7 {
    say("FLOOR 7: THE SUNKEN ARCHIVE\nWater laps at ruined shelves. Loose pages\ndrift like ghosts.")
    say("Archivist Morwen guards the vault. Somewhere\nhere a silver glint: a Moon Shard? Vesper\nwould want to know.")
  } else if floor == 8 {
    say("FLOOR 8: THE BONE ORCHARD\nWhite trees, pale fruit, and no birds.")
    say("The Bone Colossus is rooted at the far end.\nFind the key, and look for another\nMoon Shard.")
  } else if floor == 9 {
    say("FLOOR 9: THE MOONWELL SOURCE\nSilver water wells up from below. The light\nhere is almost alive.")
    say("Something hollow sits at its heart, drinking\nthe moon. End it, knight.")
  } else if floor == 10 {
    say("FLOOR 10: THE ASHEN CITADEL\nThe Ember King's fortress, or what is left.")
    say("Warlord Zorn commands the last of his army.\nBeyond him, the fire's heart.")
  } else if floor == 11 {
    say("FLOOR 11: THE HEART OF EMBERS\nThe air roars. This is where the fire began.")
    say("The Cinder God waits. Finish it, last knight.")
  }
}

fn newJourney() {
  coins = bank
  maxHp = 6
  weapon = 1
  owned = [1]
  secFound = []
  save "secrets", secFound
  inv = [0, 0, 0, 0, 0, 0]
  swiftT = 0
  wardN = 0
  smithLv = 0
  hasCharm = 0
  hasFang = 0
  ench = [0, 0, 0, 0, 0]
  strT = 0
  goldT = 0
  playTime = 0
  nextFloor = 2
  seenSpikes = false
  seenRest = false
  enterFloor(1)
  say("Long ago, the Moonwell filled these halls\nwith silver light.")
  say("Then the Ember King climbed up from the\ndeep, and one by one the lights went out.")
  say("Since then, a hundred moons have passed\nin darkness...")
  say("You are the last knight of the old order.\nGo down. Find the Ember King.")
  say("ARROWS / WASD  move     X  swing, open, buy\nZ  dash     C  switch weapon     M  music")
  say("B  open your pack   1-5  drink   G  bomb")
}

fn continueJourney() {
  let data = saved("moonwell", [])
  nextFloor = data[1]
  coins = data[2]
  maxHp = data[3]
  weapon = data[4]
  playTime = data[5]
  owned = []
  let n = 6
  while n < length(data) {
    add data[n] to owned
    n += 1
  }
  inv = saved("pack", [0, 0, 0])
  while length(inv) < 6 {
    add 0 to inv
  }
  let gear = saved("gear", [0, 0, 0])
  if length(gear) == 3 {
    smithLv = gear[0]
    hasCharm = gear[1]
    hasFang = gear[2]
  }
  ench = saved("ench", [0, 0, 0, 0, 0])
  while length(ench) < 5 {
    add 0 to ench
  }
  swiftT = 0
  wardN = 0
  strT = 0
  goldT = 0
  seenSpikes = true
  seenRest = true
  enterFloor(data[0])
  say("Welcome back, knight.\n" + floorNames[floor] + " awaits.")
}

// ---------- the pack ----------
// =====================================================================
//  Settings: music, sound, shake, button side, and the save-code boxes
// =====================================================================
fn applySettings() {
  # window.__setMix(setSfx, setMusic);
  # window.__setLefty(setLefty == 1);
  save "set", [setMusic, setSfx, setShake, setLefty]
}

// row ids: 0 music, 1 sound, 2 shake, 3 button side (phones), 4 controls, 5 achievements, 6 stats, 7 export, 8 import, 9 close
fn setIds() {
  let ids = [0, 1, 2]
  if touch {
    add 3 to ids
    add 10 to ids
  }
  add 4 to ids
  add 5 to ids
  add 6 to ids
  add 7 to ids
  add 8 to ids
  add 9 to ids
  return ids
}

fn openAch() {
  setOpen = false
  achOpen = true
}

fn openStats() {
  setOpen = false
  statsOpen = true
}

fn openSettings() {
  if setOpen {
    return 0
  }
  if (mode != 0 and mode != 1) or length(msgs) > 0 or dying > 0 or typingCode or cutT > 0 or ctlEditing or enchOpen {
    return 0
  }
  invOpen = false
  helpOpen = false
  setOpen = true
  setSel = 0
  sound sndSwitch volume 50
}

fn closeSettings() {
  setOpen = false
  sound sndSwitch volume 50
}

fn setMove(d) {
  let ids = setIds()
  setSel = (setSel + d + length(ids)) % length(ids)
  sound sndTick volume 40
}

// left / right on a row
fn setAdjust(d) {
  let rowId = setIds()[setSel]
  if rowId == 0 {
    setMusic = max(0, min(100, setMusic + d * 10))
  } else if rowId == 1 {
    setSfx = max(0, min(100, setSfx + d * 10))
  } else if rowId == 2 {
    setShake = (setShake + d + 3) % 3
  } else if rowId == 3 {
    setLefty = 1 - setLefty
  } else {
    return 0
  }
  applySettings()
  sound sndTick volume 40
  if rowId == 1 {
    sound sndCoin volume 40
  }
}

// X on a row
fn setAct() {
  let rowId = setIds()[setSel]
  if rowId <= 3 {
    setAdjust(1)
  } else if rowId == 10 {
    setOpen = false
    ctlEditing = true
    # window.__ctlEdit(true);
  } else if rowId == 4 {
    setOpen = false
    helpOpen = true
  } else if rowId == 5 {
    openAch()
  } else if rowId == 6 {
    openStats()
  } else if rowId == 7 {
    setOpen = false
    # window.__mwBox('export');
  } else if rowId == 8 {
    setOpen = false
    # window.__mwBox('import');
  } else {
    closeSettings()
  }
}

fn drawSettings() {
  box 0, 0, 320, 180 color "#000000b0"
  box 32, 6, 256, 152 color "#0b0912f4"
  box 32, 6, 256, 1 color "#d3bfa9"
  box 32, 157, 256, 1 color "#d3bfa9"
  box 32, 6, 1, 152 color "#d3bfa9"
  box 287, 6, 1, 152 color "#d3bfa9"
  write "SETTINGS" at 160, 11 centered color "#e8f4ff" shadow
  let ids = setIds()
  let names = ["MUSIC", "SOUND", "SCREEN SHAKE", "BUTTON SIDE", "CONTROLS", "ACHIEVEMENTS", "STATS", "EXPORT SAVE", "IMPORT SAVE", "CLOSE", "MOVE BUTTONS"]
  let r = 0
  while r < length(ids) {
    let rowId = ids[r]
    let ry = 21 + r * 11
    if r == setSel {
      box 36, ry - 2, 248, 11 color "#2a2036"
      box 36, ry - 2, 2, 11 color "#ffd23f"
    }
    let col = "#c9c3d6"
    if r == setSel {
      col = "#ffd23f"
    }
    write names[rowId] at 46, ry color col
    if rowId == 0 or rowId == 1 {
      let v = setMusic
      if rowId == 1 {
        v = setSfx
      }
      let seg = 0
      while seg < 10 {
        let sc = "#3a3346"
        if seg < v / 10 {
          sc = "#7ee787"
        }
        box 176 + seg * 9, ry + 1, 7, 6 color sc
        seg += 1
      }
    } else if rowId == 2 {
      let words = ["OFF", "LESS", "FULL"]
      write words[setShake] at 176, ry color "#7ee787"
    } else if rowId == 3 {
      let words = ["RIGHT-HANDED", "LEFT-HANDED"]
      write words[setLefty] at 176, ry color "#7ee787"
    }
    r += 1
  }
  write "Stick: choose / change    SWORD: use" at 160, 146 centered color "#9a8fb0"
}

fn toggleHelp() {
  if helpOpen {
    helpOpen = false
    return 0
  }
  if (mode != 0 and mode != 1) or length(msgs) > 0 or dying > 0 or invOpen or typingCode or setOpen {
    return 0
  }
  helpOpen = true
  sound sndSwitch volume 50
}

fn toggleInv() {
  if enchOpen {
    return 0
  }
  if setOpen {
    closeSettings()
    return 0
  }
  if mode == 0 and touch and length(msgs) == 0 {
    openSettings()
    return 0
  }
  if helpOpen {
    return 0
  }
  if mode != 1 or length(msgs) > 0 or dying > 0 {
    return 0
  }
  invOpen = not invOpen
  invNote = ""
  sound sndSwitch volume 50
}

fn invMove(d) {
  if enchOpen {
    return 0
  }
  if setOpen {
    setAdjust(d)
    return 0
  }
  if not invOpen {
    return 0
  }
  invSel = (invSel + d + 6) % 6
  sound sndTick volume 40
}

fn usePotion(slot) {
  if helpOpen or enchOpen {
    return 0
  }
  if mode != 1 or length(msgs) > 0 or dying > 0 {
    return 0
  }
  if inv[slot] <= 0 {
    sound sndNope
    invNote = "You have none of those."
    return 0
  }
  if slot == 0 and hp >= maxHp {
    sound sndNope
    invNote = "Your hearts are already full."
    return 0
  }
  inv[slot] -= 1
  invNote = ""
  if slot == 0 {
    hp = min(maxHp, hp + 4)
    sound sndHeal
    burst(hx + 5, hy - 6, 12, "#ff4d6d", 16)
    effect(9, hx + 5, hy - 6, 30, "#ff6b8a", 40, 90, 0, 6)
    drift(0, -5)
  } else if slot == 1 {
    strT = 3600
    sound sndBuy
    burst(hx + 5, hy - 6, 14, "#7be07b", 18)
    effect(16, hx + 5, hy - 6, 30, "#7be07b", 30, 100, 0, 4)
  } else if slot == 2 {
    goldT = 3600
    sound sndBuy
    burst(hx + 5, hy - 6, 14, "#ffd23f", 18)
    effect(16, hx + 5, hy - 6, 30, "#ffd23f", 30, 100, 0, 4)
  } else if slot == 3 {
    swiftT = 1800
    sound sndBuy
    burst(hx + 5, hy - 6, 14, "#4fd1ff", 18)
    effect(16, hx + 5, hy - 6, 30, "#4fd1ff", 30, 100, 0, 4)
  } else if slot == 4 {
    wardN = 3
    sound sndBuy
    burst(hx + 5, hy - 6, 14, "#b57bff", 18)
    effect(16, hx + 5, hy - 6, 30, "#b57bff", 30, 100, 0, 4)
  } else {
    placeBomb()
  }
  if slot != 5 {
    questAdd(6, 0, 1)
    stats[7] += 1
  }
  saveGame()
  // drinking from the pack closes it, so the fight goes on
  invOpen = false
}

fn useLadder() {
  // the Ember King falls: the first ending, but the journey goes on
  if floor == 6 {
    won = 1
    save "won", 1
    if bestTime == 0 or playTime < bestTime {
      bestTime = playTime
      save "best", bestTime
    }
    nextFloor = 7
    let wasFloor = floor
    floor = 0
    saveGame()
    floor = wasFloor
    mode = 3
    epilogue = 1
    winAt = tick
    sound jingleWin
    return 0
  }
  if floor == lastFloor {
    mode = 3
    epilogue = 2
    trueEnd = 1
    save "true", 1
    winAt = tick
    won = 1
    save "won", 1
    bank = coins
    save "bank", bank
    sound jingleWin
    save "moonwell", []
    if bestTime == 0 or playTime < bestTime {
      bestTime = playTime
      save "best", bestTime
    }
    return 0
  }
  if floor == 0 {
    if nextFloor == 9 and not stairOpen() {
      sound sndLocked
      say("The stair down to the Moonwell Source is\nsealed with silver light. Vesper may know\nhow to open it.")
      return 0
    }
    enterFloor(nextFloor)
  } else {
    nextFloor = floor + 1
    enterFloor(0)
  }
}

// =====================================================================
//  Small helpers
// =====================================================================
fn overlap(ax, ay, aw, ah, ox, oy, ow, oh) {
  return ax < ox + ow and ox < ax + aw and ay < oy + oh and oy < ay + ah
}

// is a box (in pixels) touching anything solid?
fn blocked(px, py, w, h) {
  if px < 0 or py < 0 {
    return true
  }
  let x1 = px / 16
  let y1 = py / 16
  let x2 = (px + w - 1) / 16
  let y2 = (py + h - 1) / 16
  return solidCell(x1, y1) or solidCell(x2, y1) or solidCell(x1, y2) or solidCell(x2, y2)
}

fn say(words) {
  add words to msgs
}

fn burst(px, py, count, color, speed) {
  repeat count {
    add px * 10 to qx
    add py * 10 to qy
    add random(-speed, speed) to qvx
    add random(-speed, speed) to qvy
    add random(14, 30) to qlife
    add color to qcol
  }
}

fn spikeFrame() {
  let ph = tick % 150
  if ph < 80 {
    return 0
  }
  if ph < 86 {
    return 1
  }
  if ph < 92 {
    return 2
  }
  if ph < 128 {
    return 3
  }
  if ph < 136 {
    return 2
  }
  return 1
}

fn enemyW(k) {
  if isBoss(k) {
    return 24
  }
  return 12
}

fn enemyH(k) {
  if isBoss(k) {
    return 14
  }
  return 8
}

// a rough length of (dx, dy) without square roots
fn roughLength(dx, dy) {
  let a = abs(dx)
  let b = abs(dy)
  return max(1, max(a, b) + min(a, b) / 2)
}

fn fireball(px, py, vx, vy, color) {
  add px * 10 to bx
  add py * 10 to by
  add vx to bvx
  add vy to bvy
  add color to bcol
}

// shoot at the hero: count is 1, 3 or 5 shots in a fan
fn aimAt(px, py, speed, count, color) {
  let dx = hx + 5 - px
  let dy = hy - 2 - py
  let dist = roughLength(dx, dy)
  let vx = dx * speed / dist
  let vy = dy * speed / dist
  let s = 0 - count / 2
  while s <= count / 2 {
    fireball(px, py, vx - vy * s * 3 / 10, vy + vx * s * 3 / 10, color)
    s += 1
  }
}

fn ring(px, py, turned, color) {
  let d = 0
  while d < 8 {
    if turned {
      fireball(px, py, ring2X[d], ring2Y[d], color)
    } else {
      fireball(px, py, ringX[d], ringY[d], color)
    }
    d += 1
  }
}

// =====================================================================
//  Effects: glowing sprites that grow, spin, drift and fade
// =====================================================================
// kinds: 1 slash  2 star  3 cross  4 flare  5 spark  6 smoke  7 fire  8 flame
//        9 rune  10 dot  11 bolt  12 twirl  13 claw  14 ring  15 glow  16 circle
fn effect(kind, px, py, life, color, s0, s1, ang, spin) {
  if length(efk) > 160 {
    return 0
  }
  add kind to efk
  add px * 10 to efx
  add py * 10 to efy
  add 0 to efage
  add life to eflife
  add color to efcol
  add s0 to efs0
  add s1 to efs1
  add ang to efang
  add spin to efspin
  add 0 to efvx
  add 0 to efvy
}

// the same, drifting by (dx, dy) tenths of a pixel each frame
fn drift(dx, dy) {
  let last = length(efk) - 1
  if last >= 0 {
    efvx[last] = dx
    efvy[last] = dy
  }
}

fn clearEffects() {
  efk = []
  efx = []
  efy = []
  efage = []
  eflife = []
  efcol = []
  efs0 = []
  efs1 = []
  efang = []
  efspin = []
  efvx = []
  efvy = []
}

// =====================================================================
//  Underlings: press V to raise ghostly skeletons that fight for you
// =====================================================================
fn summon() {
  if invOpen or helpOpen or setOpen or achOpen or statsOpen or enchOpen {
    return 0
  }
  if mode != 1 or length(msgs) > 0 or dying > 0 {
    return 0
  }
  if skin != 7 {
    sound sndNope
    say("Only a Necromancer can raise the dead.\nThe look waits in the Rest Camp's wardrobe.")
    return 0
  }
  if floor == 0 {
    say("The camp is a place of rest. Your\nunderlings will answer you in the dungeon.")
    return 0
  }
  if summonCool > 0 {
    sound sndNope
    return 0
  }
  // two underlings, three from floor 4 down
  let count = 2
  if floor >= 4 {
    count = 3
  }
  let i = 0
  while i < count {
    let sx = hx + random(-22, 22)
    let sy = hy + random(-16, 16)
    if blocked(sx, sy, 10, 8) {
      sx = hx
      sy = hy
    }
    add sx to ux
    add sy to uy
    add 3 + floor / 2 to uhp
    add 900 to ulife
    add 20 to uatk
    add false to uleft
    effect(16, sx + 5, sy + 2, 30, "#7fb8e8", 20, 70, 0, 10)
    puff(sx + 5, sy + 4, "#46607a")
    i += 1
  }
  summonCool = summonWait
  tone 220 to 660 for 300ms
  sound sndSwitch
  effect(16, hx + 5, hy + 2, 36, "#c77dff", 30, 120, 0, -8)
}

fn moveUnderling(n, dx, dy) {
  if dx != 0 and not blocked(ux[n] + dx, uy[n], 10, 8) {
    ux[n] += dx
  }
  if dy != 0 and not blocked(ux[n], uy[n] + dy, 10, 8) {
    uy[n] += dy
  }
}

// an underling's hit: no screen freeze, so it doesn't interrupt your own fighting
fn allyHit(e2, dmg, pushX, pushY) {
  let k = ekind[e2]
  ehp[e2] -= dmg
  ehurt[e2] = 8
  if isBoss(k) {
    bossAwake = true
  } else {
    ekx[e2] = pushX
    eky[e2] = pushY
  }
  let mx = ex[e2] + enemyW(k) / 2
  let my = ey[e2] + enemyH(k) - kindTall[k] / 2
  effect(2, mx, my, 8, "#9bd3ff", 70, 20, random(0, 90), 6)
  sound sndHit volume 30
}

fn updateUnderlings() {
  if summonCool > 0 {
    summonCool -= 1
  }
  let n = 0
  while n < length(ux) {
    ulife[n] -= 1
    if uatk[n] > 0 {
      uatk[n] -= 1
    }
    // find the nearest monster
    let best = -1
    let bestFar = 170
    let e2 = 0
    while e2 < length(ex) {
      let far = abs(ex[e2] + enemyW(ekind[e2]) / 2 - (ux[n] + 5)) + abs(ey[e2] + enemyH(ekind[e2]) / 2 - (uy[n] + 4))
      if far < bestFar and (not isBoss(ekind[e2]) or bossAwake) {
        best = e2
        bestFar = far
      }
      e2 += 1
    }
    if best >= 0 {
      let k = ekind[best]
      let dx = ex[best] + enemyW(k) / 2 - (ux[n] + 5)
      let dy = ey[best] + enemyH(k) / 2 - (uy[n] + 4)
      uleft[n] = dx < 0
      if overlap(ux[n] - 3, uy[n] - 3, 16, 14, ex[best] - 2, ey[best] - 2, enemyW(k) + 4, enemyH(k) + 4) {
        if uatk[n] == 0 {
          allyHit(best, 1 + floor / 3, sign(dx) * 3, sign(dy) * 3)
          uatk[n] = 32
        }
        // monsters fight back
        if tick % 45 == 0 {
          uhp[n] -= 1
        }
      } else if tick % 4 != 0 {
        moveUnderling(n, sign(dx), sign(dy))
      }
    } else {
      // no monsters near: stay close to the knight
      let dx = hx - ux[n]
      let dy = hy - uy[n]
      if abs(dx) + abs(dy) > 28 and tick % 2 == 0 {
        moveUnderling(n, sign(dx), sign(dy))
        uleft[n] = dx < 0
      }
    }
    if ulife[n] <= 0 or uhp[n] <= 0 {
      puff(ux[n] + 5, uy[n] - 2, "#46607a")
      effect(15, ux[n] + 5, uy[n] - 2, 14, "#7fb8e8", 40, 5, 0, 0)
      remove ux[n]
      remove uy[n]
      remove uhp[n]
      remove ulife[n]
      remove uatk[n]
      remove uleft[n]
    } else {
      n += 1
    }
  }
}

fn drawUnderlings() {
  let n = 0
  while n < length(ux) {
    let x = ux[n] - 3
    let y = uy[n] - 8
    let see = 75
    // they flicker as their time runs out
    if ulife[n] < 120 and tick % 8 < 4 {
      see = 35
    }
    box ux[n], uy[n] + 6, 10, 3 color "#00000044"
    draw fxGlow at x + 8 - 32, y + 8 - 32 tint "#5f8fc0" alpha see / 4 scale 45 glow
    draw skelRun at x, y frame tick / 7 + n * 3 flip uleft[n] alpha see * 2 / 3 tint "#5f8fc0"
    draw skelRun at x, y frame tick / 7 + n * 3 flip uleft[n] alpha see / 3
    draw skelRun at x, y frame tick / 7 + n * 3 flip uleft[n] alpha see / 4 tint "#9bd3ff" glow
    n += 1
  }
}

fn updateEffects() {
  let n = 0
  while n < length(efk) {
    efage[n] += 1
    efx[n] += efvx[n]
    efy[n] += efvy[n]
    efang[n] += efspin[n]
    if efage[n] >= eflife[n] {
      remove efk[n]
      remove efx[n]
      remove efy[n]
      remove efage[n]
      remove eflife[n]
      remove efcol[n]
      remove efs0[n]
      remove efs1[n]
      remove efang[n]
      remove efspin[n]
      remove efvx[n]
      remove efvy[n]
    } else {
      n += 1
    }
  }
}

fn drawEffects() {
  let n = 0
  while n < length(efk) {
    let t = efage[n] * 100 / eflife[n]
    let sc = efs0[n] + (efs1[n] - efs0[n]) * t / 100
    let see = 100 - t
    drawFx(efk[n], efx[n] / 10, efy[n] / 10, efang[n], efcol[n], see, sc)
    n += 1
  }
}

// one effect sprite centred on (cx, cy)
fn drawFx(kind, cx, cy, ang, color, see, sc) {
  let x = cx - 16
  let y = cy - 16
  if kind >= 14 {
    x = cx - 32
    y = cy - 32
  }
  if kind == 1 {
    draw fxSlash at x, y angle ang tint color alpha see scale sc glow
  } else if kind == 2 {
    draw fxStar at x, y angle ang tint color alpha see scale sc glow
  } else if kind == 3 {
    draw fxCross at x, y angle ang tint color alpha see scale sc glow
  } else if kind == 4 {
    draw fxFlare at x, y angle ang tint color alpha see scale sc glow
  } else if kind == 5 {
    draw fxSpark at x, y angle ang tint color alpha see scale sc glow
  } else if kind == 6 {
    draw fxSmoke at x, y frame ang / 180 angle ang tint color alpha see * 7 / 10 scale sc
  } else if kind == 7 {
    draw fxFire at x, y angle ang tint color alpha see scale sc glow
  } else if kind == 8 {
    draw fxFlame at x, y angle ang tint color alpha see scale sc glow
  } else if kind == 9 {
    draw fxRune at x, y angle ang tint color alpha see scale sc glow
  } else if kind == 10 {
    draw fxDot at x, y angle ang tint color alpha see scale sc glow
  } else if kind == 11 {
    draw fxBolt at x, y angle ang tint color alpha see scale sc glow
  } else if kind == 12 {
    draw fxTwirl at x, y angle ang tint color alpha see scale sc glow
  } else if kind == 13 {
    draw fxClaw at x, y angle ang tint color alpha see scale sc glow
  } else if kind == 14 {
    draw fxRing at x, y angle ang tint color alpha see scale sc
  } else if kind == 15 {
    draw fxGlow at x, y angle ang tint color alpha see scale sc glow
  } else {
    draw fxCircle at x, y angle ang tint color alpha see scale sc glow
  }
}

// a soft puff of smoke that rises
fn puff(px, py, color) {
  effect(6, px + random(-4, 4), py + random(-3, 3), random(22, 34), color, 50, 130, random(0, 359), random(-3, 3))
  drift(random(-3, 3), -4)
}

// glows on lava and moonwater, flickering a little
fn drawLights() {
  let n = 0
  while n < length(lightX) {
    let lx = lightX[n]
    let ly = lightY[n]
    if lx > camX - 60 and lx < camX + 380 and ly > camY - 60 and ly < camY + 240 {
      let flick = 30 + (tick / 4 + n * 5) % 7
      draw fxLight at lx - 32, ly - 32 tint lightCol[n] alpha flick scale 150 glow
    }
    n += 1
  }
}

// =====================================================================
//  The hero
// =====================================================================

// ---------- the mage's enchanting menu ----------
let enchOpen = false
let enchSel = 0

fn openEnch() {
  if mode != 1 or length(msgs) > 0 or dying > 0 or setOpen or invOpen or helpOpen {
    return 0
  }
  enchOpen = true
  enchSel = 0
  sound sndSwitch volume 50
}

fn closeEnch() {
  enchOpen = false
  sound sndSwitch volume 50
}

fn enchMove(d) {
  enchSel = (enchSel + d + 6) % 6
  sound sndTick volume 40
}

fn enchBuy() {
  if enchSel >= 5 {
    closeEnch()
    return 0
  }
  let e = enchSel
  if ench[e] >= 3 {
    sound sndNope
    showToast(shopName[17 + e] + " is at its peak")
    return 0
  }
  let cost = enchCost(e)
  if coins < cost {
    sound sndNope
    showToast("That's " + cost + " gold. You have " + coins + ".")
    return 0
  }
  coins -= cost
  ench[e] += 1
  sound jingleTreasure
  burst(hx + 5, hy - 8, 16, enchCol[e], 22)
  effect(16, hx + 5, hy - 6, 30, enchCol[e], 30, 110, 0, 4)
  saveGame()
  showToast(shopName[17 + e] + " is now level " + ench[e])
}

fn enchVal(e, lv) {
  if e <= 2 {
    return "" + [0, 25, 50, 75][lv] + "%"
  }
  if e == 3 {
    return "" + [0, 15, 30, 45][lv] + "%"
  }
  return "-" + (lv * 8) + " frames"
}

fn drawEnch() {
  box 0, 0, 320, 180 color "#0b0912"
  write "THE MAGE'S ENCHANTING" at 160, 5 centered color "#b57bff" shadow
  box 10, 16, 300, 1 color "#3a2f3a"
  write coins + " gold" at 308 - length("" + coins + " gold") * 6, 21 color "#ffd23f"
  let r = 0
  while r < 6 {
    let ry = 33 + r * 17
    let isSel = r == enchSel
    if isSel {
      box 10, ry - 1, 300, 16 color "#2a2036"
      box 10, ry - 1, 2, 16 color "#ffd23f"
    } else if r % 2 == 0 {
      box 10, ry - 1, 300, 16 color "#15101e"
    }
    let col = "#c9c3d6"
    if isSel {
      col = "#ffd23f"
    }
    if r < 5 {
      drawIcon(17 + r, 16, ry - 1, false)
      write shopName[17 + r] at 40, ry + 4 color col
      let pip = 0
      while pip < 3 {
        let pc = "#3a3346"
        if pip < ench[r] {
          pc = enchCol[r]
        }
        box 170 + pip * 13, ry + 4, 10, 7 color pc
        pip += 1
      }
      if ench[r] >= 3 {
        write "MAX" at 296 - 18, ry + 4 color "#7ee787"
      } else {
        let c = "" + enchCost(r) + " gold"
        let cc = "#ffd23f"
        if coins < enchCost(r) {
          cc = "#a0586a"
        }
        write c at 304 - length(c) * 6, ry + 4 color cc
      }
    } else {
      write "CLOSE" at 40, ry + 4 color col
    }
    r += 1
  }
  box 10, 140, 300, 22 color "#15101e"
  if enchSel < 5 {
    write enchInfo[enchSel] at 160, 143 centered color "#c9c3d6"
    let lv = ench[enchSel]
    if lv >= 3 {
      write "Level 3: " + enchVal(enchSel, 3) + " (max)" at 160, 152 centered color "#7ee787"
    } else {
      write "Now " + enchVal(enchSel, lv) + "   Next " + enchVal(enchSel, lv + 1) at 160, 152 centered color "#ffd23f"
    }
  } else {
    write "Leave the mage's table." at 160, 147 centered color "#9a8fb0"
  }
  if touch {
    write "Stick: choose   SWORD: buy" at 160, 168 centered color "#9a8fb0"
  } else {
    write "Up/Down: choose   X: buy   Z: close" at 160, 168 centered color "#9a8fb0"
  }
}

fn enchCost(i) {
  return [60, 120, 200][ench[i]]
}

// which element a monster fights with: 1 fire, 2 water, 3 dark, 0 plain steel
fn kindElem(k) {
  if contains([4, 5, 13, 18, 23], k) {
    return 1
  }
  if contains([7, 8, 15, 21, 24], k) {
    return 2
  }
  if contains([2, 6, 10, 11, 12, 16, 19, 20], k) {
    return 3
  }
  return 0
}

fn hurtHero(amount, fromX, fromY) {
  let elem = hurtElem
  hurtElem = 0
  if hurt > 0 or dash > 0 or dying > 0 or mode != 1 {
    return 0
  }
  if elem > 0 and ench[elem - 1] > 0 {
    if random(1, 100) <= [0, 25, 50, 75][ench[elem - 1]] {
      hurt = 30
      shake = 3
      sound sndHit volume 50
      burst(hx + 5, hy - 4, 10, enchCol[elem - 1], 22)
      effect(13, hx + 5, hy - 6, 12, enchCol[elem - 1], 90, 120, random(0, 90), 0)
      return 0
    }
  }
  if wardN > 0 {
    wardN -= 1
    hurt = 40
    shake = 4
    sound sndHit
    burst(hx + 5, hy - 4, 12, "#b57bff", 24)
    effect(13, hx + 5, hy - 6, 12, "#b57bff", 90, 120, random(0, 90), 0)
    return 0
  }
  hp -= amount
  hurt = 70
  if skin == 0 {
    hurt = 105
  }
  shake = 10
  freeze = 4
  kbx = sign(hx + 5 - fromX) * 4
  kby = sign(hy + 4 - fromY) * 4
  sound sndHurt
  burst(hx + 5, hy - 4, 10, "#ff4d6d", 25)
  effect(13, hx + 5, hy - 6, 12, "#ff4d6d", 90, 120, random(0, 90), 0)
  if hp <= 0 {
    hp = 0
    dying = 70
    sound jingleFallen
  }
}

fn scorch() {
  let e2 = 0
  while e2 < length(ex) {
    let k = ekind[e2]
    let far = abs(ex[e2] + enemyW(k) / 2 - (hx + 5)) + abs(ey[e2] + enemyH(k) / 2 - (hy + 4))
    if far < 30 and (not isBoss(k) or bossAwake) {
      ehp[e2] -= 1
      ehurt[e2] = 6
      burst(ex[e2] + enemyW(k) / 2, ey[e2] + enemyH(k) / 2, 3, "#ff8a3d", 10)
    }
    e2 += 1
  }
}

fn moveHero(dx, dy) {
  if dx != 0 and not blocked(hx + dx, hy, 10, 8) {
    hx += dx
  }
  if dy != 0 and not blocked(hx, hy + dy, 10, 8) {
    hy += dy
  }
}

fn updateHero() {
  if dying > 0 {
    dying -= 1
    if dying == 1 {
      stats[1] += 1
      saveGame()
      mode = 2
    }
    return 0
  }
  let mx = 0
  let my = 0
  if held("left") or held("a") {
    mx = -1
  }
  if held("right") or held("d") {
    mx = 1
  }
  if held("up") or held("w") {
    my = -1
  }
  if held("down") or held("s") {
    my = 1
  }
  moving = mx != 0 or my != 0
  if moving and swing == 0 and dash == 0 {
    faceX = mx
    faceY = my
    if mx != 0 and my != 0 {
      faceY = 0
    }
  }
  if mx < 0 {
    lookLeft = true
  }
  if mx > 0 {
    lookLeft = false
  }
  // walking speed: 1.5 pixels a frame (1 or 2 in turns)
  let speed = 1 + tick % 2
  if swiftT > 0 {
    speed = 2 + tick % 2
  }
  if swing > 0 {
    speed = tick % 2
  }
  if dash > 0 {
    dash -= 1
    moveHero(faceX * 4, faceY * 4)
    if tick % 2 == 0 {
      burst(hx + 5, hy + 4, 1, "#9bd3ff", 6)
      // Comet Dash: the Celestial Knight drops stars that sting monsters
      if skin == 5 {
        launch(4, hx + 5, hy - 2, 0, 0, 40, 2)
      }
    }
  } else {
    moveHero(mx * speed, my * speed)
  }
  if moving and dash == 0 and tick % 18 == 0 {
    sound sndStep volume 22
  }
  if dashCool > 0 {
    dashCool -= 1
  }
  if kbx != 0 or kby != 0 {
    moveHero(kbx, kby)
    kbx -= sign(kbx)
    kby -= sign(kby)
  }
  if hurt > 0 {
    hurt -= 1
  }
  if swiftT > 0 {
    swiftT -= 1
    if tick % 4 == 0 and moving {
      burst(hx + 5, hy + 6, 1, "#4fd1ff", 8)
    }
  }
  if strT > 0 {
    strT -= 1
    if tick % 9 == 0 {
      burst(hx + 5 + random(-5, 5), hy + random(-12, 2), 1, "#7be07b", 8)
    }
  }
  if goldT > 0 {
    goldT -= 1
    if tick % 11 == 0 {
      burst(hx + 5 + random(-5, 5), hy + random(-12, 2), 1, "#ffd23f", 8)
    }
  }
  // Lizardfolk Regrowth: half a heart every 8 seconds
  if skin == 3 and hp > 0 and hp < maxHp and dying == 0 and tick % 480 == 0 {
    hp += 1
    sound sndHeal volume 40
    burst(hx + 5, hy - 6, 6, "#7be07b", 12)
  }
  // Ember Knight Burning Aura: scorches whatever stands close
  if skin == 6 and dying == 0 and floor > 0 and tick % 30 == 0 {
    scorch()
  }
  if weaponShow > 0 {
    weaponShow -= 1
  }
  // spikes
  let ftx = (hx + 5) / 16
  let fty = (hy + 4) / 16
  if cell(ftx, fty) == "^" and spikeFrame() == 3 {
    hurtHero(1, hx + 5, hy - 20)
  }
  // the weapon lands partway through the swing
  if swing > 0 {
    swing -= 1
    if swing == wLen[weapon] - 5 and not swingHit {
      swingHit = true
      if weapon == 5 {
        shootFlame()
      } else if weapon == 7 {
        shootStar()
      } else {
        swordHits()
        if skin == 2 {
          swingCount += 1
          if swingCount % 3 == 0 {
            let ax = faceX
            let ay = faceY
            if ax == 0 and ay == 0 {
              ay = 1
            }
            launch(2, hx + 5 + ax * 10, hy - 4 + ay * 10, ax * 38, ay * 38, 30, 3)
            tone 1400 to 900 for 80ms
          }
        }
        if weapon == 6 {
          let wx = faceX
          let wy = faceY
          if wx == 0 and wy == 0 {
            wy = 1
          }
          launch(3, hx + 5 + wx * 16, hy - 4 + wy * 16, wx * 36, wy * 36, 14, 10)
          tone 900 to 400 for 160ms
        }
      }
    }
  }
}

fn swordHits() {
  let r = wReach[weapon]
  let ax = hx - 7 - r
  let ay = hy - 12 - r
  let aw = 24 + r * 2
  let ah = 24 + r * 2
  if faceX > 0 {
    ax = hx + 8
    ay = hy - 16 - r
    aw = 22 + r
    ah = 28 + r * 2
  } else if faceX < 0 {
    ax = hx - 20 - r
    ay = hy - 16 - r
    aw = 22 + r
    ah = 28 + r * 2
  } else if faceY < 0 {
    ax = hx - 9 - r
    ay = hy - 34 - r
    aw = 28 + r * 2
    ah = 24 + r
  } else {
    ax = hx - 9 - r
    ay = hy
    aw = 28 + r * 2
    ah = 22 + r
  }
  let n = 0
  while n < length(ex) {
    let k = ekind[n]
    let tall = kindTall[k]
    let w = enemyW(k)
    let h = enemyH(k)
    if ehurt[n] < 6 and overlap(ax, ay, aw, ah, ex[n] - 2, ey[n] + h - tall, w + 4, tall) {
      hitEnemy(n, wDmg[weapon], faceX * 5, faceY * 5)
    }
    n += 1
  }
  // the slash arc, pointing the way the hero faces
  let arc = 0
  if faceX > 0 {
    arc = 270
  } else if faceX < 0 {
    arc = 90
  } else if faceY < 0 {
    arc = 180
  }
  let slashCol = "#ffffff"
  if weapon == 6 {
    effect(1, ax + aw / 2, ay + ah / 2, 10, "#6fa8d6", 190, 240, arc, 0)
  }
  if weapon == 4 {
    slashCol = "#ffd23f"
  } else if weapon == 1 {
    slashCol = "#c9d3dd"
  }
  if weapon == 3 {
    shake = max(shake, 5)
    burst(ax + aw / 2, ay + ah / 2, 6, "#c9a27e", 14)
    effect(14, ax + aw / 2, ay + ah / 2, 16, "#c9a27e", 20, 80, 0, 0)
    effect(1, ax + aw / 2, ay + ah / 2, 12, "#ffe6c4", 220, 300, arc, 0)
  } else {
    effect(1, ax + aw / 2, ay + ah / 2, 9, slashCol, 160, 210, arc, 0)
  }
}

fn hitEnemy(n, dmg, pushX, pushY) {
  let k = ekind[n]
  // a Strength potion doubles every hit (the Moonblade is mighty enough already)
  let hit = dmg
  if weapon != 6 {
    hit = dmg + smithLv
  }
  if strT > 0 and weapon != 6 {
    hit = hit * 2
  }
  if ench[3] > 0 and random(1, 100) <= ench[3] * 15 {
    hit += 2
    burst(ex[n] + enemyW(k) / 2, ey[n] + enemyH(k) / 2, 8, "#ff8a3d", 20)
  }
  ehp[n] -= hit
  ehurt[n] = 12
  if not isBoss(k) {
    ekx[n] = pushX
    eky[n] = pushY
  } else {
    bossAwake = true
  }
  freeze = 3
  shake = max(shake, 4)
  if weapon == 3 {
    sound sndHeavy
  } else {
    sound sndHit
  }
  let mx = ex[n] + enemyW(k) / 2
  let my = ey[n] + enemyH(k) - kindTall[k] / 2
  burst(mx, my, 8, "#ffffff", 22)
  effect(2, mx, my, 10, "#fff4c2", 120, 30, random(0, 90), 6)
  effect(4, mx, my, 6, "#c9c3d6", 110, 50, 0, 0)
}

// the Ember Staff throws a flame that passes through monsters
fn shootFlame() {
  let vx = faceX * 40
  let vy = faceY * 40
  if faceX == 0 and faceY == 0 {
    vy = 40
  }
  let startX = hx + 5 + faceX * 8
  let startY = hy - 4 + faceY * 8
  launch(1, startX, startY, vx, vy, 40, wDmg[5])
  tone 700 to 300 for 90ms
  effect(4, startX, startY, 8, "#ffb34a", 120, 40, 0, 0)
}

// a piercing shot from the hero: kind 1 ember flame, 2 star shard, 3 moon wave
fn launch(kind, px, py, vx, vy, life, dmg) {
  add px * 10 to fx
  add py * 10 to fy
  add vx to fvx
  add vy to fvy
  add life to flife
  add "," to fhit
  add kind to fkind
  add dmg to fdmg
}

fn updateFlames() {
  let n = 0
  while n < length(fx) {
    fx[n] += fvx[n]
    fy[n] += fvy[n]
    flife[n] -= 1
    let px = fx[n] / 10
    let py = fy[n] / 10
    if fkind[n] == 1 and tick % 2 == 0 {
      burst(px, py, 1, "#ffb34a", 8)
    } else if fkind[n] == 2 and tick % 2 == 0 {
      effect(2, px, py, 10, "#fff4c2", 50, 10, random(0, 90), 9)
    } else if fkind[n] == 4 {
      if tick % 5 == 0 {
        effect(2, px + random(-3, 3), py + random(-3, 3), 12, "#e8f4ff", 40, 5, random(0, 90), 8)
      }
    } else if fkind[n] == 3 {
      if tick % 3 == 0 {
        effect(1, px, py, 6, "#4f7fa8", 140, 110, fhitAngle(n), 0)
      }
    }
    // hit every monster it touches, once each
    let e2 = 0
    while e2 < length(ex) {
      let k = ekind[e2]
      let tag = "," + ehome[e2] + ","
      // comet stars share one list per dash, so a trail hits each monster once
      let seen = fhit[n]
      if fkind[n] == 4 {
        seen = cometHit
      }
      if not contains(seen, tag) and overlap(px - 6, py - 6, 12, 12, ex[e2] - 2, ey[e2] + enemyH(k) - kindTall[k], enemyW(k) + 4, kindTall[k]) {
        if fkind[n] == 4 {
          cometHit = cometHit + ehome[e2] + ","
          hitEnemy(e2, fdmg[n], faceX * 4, faceY * 4)
          effect(16, px, py, 16, "#9bd3ff", 20, 70, 0, 8)
        } else {
          fhit[n] = fhit[n] + ehome[e2] + ","
          hitEnemy(e2, fdmg[n], sign(fvx[n]) * 4, sign(fvy[n]) * 4)
        }
      }
      e2 += 1
    }
    if flife[n] <= 0 or (fkind[n] != 4 and isWall(px / 16, py / 16)) {
      if fkind[n] == 1 {
        burst(px, py, 6, "#ff8a3d", 14)
      } else if fkind[n] == 4 {
        burst(px, py, 2, "#9bd3ff", 8)
      } else {
        burst(px, py, 6, "#9bd3ff", 14)
      }
      remove fkind[n]
      remove fdmg[n]
      remove fx[n]
      remove fy[n]
      remove fvx[n]
      remove fvy[n]
      remove flife[n]
      remove fhit[n]
    } else {
      n += 1
    }
  }
}

// which way a flying shot points, for drawing it
fn fhitAngle(n) {
  if fvx[n] > 0 {
    return 270
  }
  if fvx[n] < 0 {
    return 90
  }
  if fvy[n] < 0 {
    return 180
  }
  return 0
}

// ---------- the Starfall Staff ----------
fn shootStar() {
  let vx = faceX * 34
  let vy = faceY * 34
  if faceX == 0 and faceY == 0 {
    vy = 34
  }
  let sx = hx + 5 + faceX * 10
  let sy = hy - 6 + faceY * 10
  add sx * 10 to orbX
  add sy * 10 to orbY
  add vx to orbVX
  add vy to orbVY
  add 45 to orbLife
  tone 1200 to 600 for 200ms
  effect(16, sx, sy, 20, "#ffd23f", 20, 90, 0, 10)
  effect(4, sx, sy, 10, "#ffffff", 160, 40, 0, 0)
}

fn updateStars() {
  let n = 0
  while n < length(orbX) {
    orbX[n] += orbVX[n]
    orbY[n] += orbVY[n]
    orbLife[n] -= 1
    let px = orbX[n] / 10
    let py = orbY[n] / 10
    // a glittering tail
    if tick % 2 == 0 {
      effect(2, px + random(-3, 3), py + random(-3, 3), 12, "#c9a227", 60, 10, random(0, 90), 12)
    }
    let boom = orbLife[n] <= 0 or isWall(px / 16, py / 16)
    let e2 = 0
    while e2 < length(ex) and not boom {
      let k = ekind[e2]
      if overlap(px - 6, py - 6, 12, 12, ex[e2] - 2, ey[e2] + enemyH(k) - kindTall[k], enemyW(k) + 4, kindTall[k]) {
        boom = true
      }
      e2 += 1
    }
    if boom {
      starBurst(px, py)
      remove orbX[n]
      remove orbY[n]
      remove orbVX[n]
      remove orbVY[n]
      remove orbLife[n]
    } else {
      n += 1
    }
  }
}

// the star explodes: a flash, rings, sparks, and eight shards flying out
fn starBurst(px, py) {
  whiteT = 10
  shake = max(shake, 14)
  freeze = 3
  sound sndSlam
  tone 200 to 40 for 500ms
  effect(14, px, py, 28, "#c9a227", 30, 330, 0, 0)
  effect(16, px, py, 36, "#b8963a", 60, 200, 0, 9)
  effect(15, px, py, 20, "#a86a2a", 180, 20, 0, 0)
  repeat 6 {
    effect(2, px + random(-30, 30), py + random(-30, 30), random(14, 26), "#fff4c2", 90, 10, random(0, 90), 14)
  }
  burst(px, py, 30, "#ffd23f", 40)
  burst(px, py, 20, "#ffffff", 30)
  // everything nearby takes the blast
  let e2 = 0
  while e2 < length(ex) {
    let k = ekind[e2]
    let dx = ex[e2] + enemyW(k) / 2 - px
    let dy = ey[e2] + enemyH(k) / 2 - py
    if roughLength(dx, dy) < 64 {
      hitEnemy(e2, wDmg[7], sign(dx) * 6, sign(dy) * 6)
    }
    e2 += 1
  }
  let d = 0
  while d < 8 {
    launch(2, px, py, ringX[d] * 2, ringY[d] * 2, 14, 4)
    d += 1
  }
}

fn switchWeapon() {
  if invOpen or helpOpen or setOpen or achOpen or statsOpen or enchOpen {
    return 0
  }
  if mode != 1 or length(owned) < 2 or swing > 0 {
    return 0
  }
  let n = 0
  let pick = owned[0]
  while n < length(owned) {
    if owned[n] == weapon {
      pick = owned[(n + 1) % length(owned)]
    }
    n += 1
  }
  weapon = pick
  weaponShow = 90
  sound sndSwitch
}

fn giveWeapon(wid) {
  if not contains(owned, wid) {
    add wid to owned
  }
  weapon = wid
  weaponShow = 150
}

// X: talk, open, buy, climb, or swing
fn pressX() {
  if enchOpen {
    enchBuy()
    return 0
  }
  if setOpen {
    setAct()
    return 0
  }
  if achOpen or statsOpen {
    achOpen = false
    statsOpen = false
    return 0
  }
  if helpOpen {
    helpOpen = false
    return 0
  }
  if invOpen {
    usePotion(invSel)
    return 0
  }
  if length(msgs) > 0 {
    if shown < length(msgs[0]) {
      shown = length(msgs[0])
    } else {
      remove msgs[0]
      shown = 0
    }
    return 0
  }
  if mode == 0 {
    if length(save0) > 0 {
      continueJourney()
    } else {
      newJourney()
    }
    return 0
  }
  if mode == 2 {
    respawn()
    return 0
  }
  if mode == 3 {
    if epilogue == 1 {
      epilogue = 0
      enterFloor(0)
      say("MAGE:\nYou did it! The Ember King is ash... but\nlook, the Moonwell only flickers. Something\ndeeper is drinking its light.")
      say("The ladder at the camp leads on to floor 7.\nThe travellers by the fire may have news.")
      return 0
    }
    mode = 0
    save0 = []
    return 0
  }
  if dying > 0 {
    return 0
  }
  let cx = hx + 5
  let cy = hy + 4
  // a chest?
  let n = 0
  while n < length(chx) {
    if chOpen[n] == 0 and abs(chx[n] * 16 + 8 - cx) < 22 and abs(chy[n] * 16 + 8 - cy) < 22 {
      openChest(n)
      return 0
    }
    n += 1
  }
  // something for sale?
  n = 0
  while n < length(shx) {
    if abs(shx[n] * 16 + 8 - cx) < 14 and abs(shy[n] * 16 + 8 - cy) < 24 {
      buy(shItem[n])
      return 0
    }
    n += 1
  }
  // a skin on the wardrobe stands?
  n = 0
  while n < length(skx) {
    if abs(skx[n] * 16 + 8 - cx) < 14 and abs(sky[n] * 16 + 8 - cy) < 24 {
      wardrobe(skIdx[n])
      return 0
    }
    n += 1
  }
  // the campfire?
  if floor == 0 and abs(14 * 16 + 8 - cx) < 22 and abs(12 * 16 + 8 - cy) < 24 {
    pokeFire()
    return 0
  }
  // the mage?
  if floor == 0 and abs(mageX * 16 + 8 - cx) < 24 and abs(mageY * 16 + 8 - cy) < 26 {
    if vaultOpen() {
      openEnch()
    } else {
      say("MAGE:\nStand by a pedestal and press X to buy.\nReach floor " + vaultFloor + " and I'll teach you enchanting.")
    }
    return 0
  }
  // a traveller?
  if floor == 0 and questsOpen() {
    n = 0
    while n < npcCount() {
      if abs(npcX[n] * 16 + 8 - cx) < 24 and abs(npcY[n] * 16 + 8 - cy) < 26 {
        talkNpc(n)
        return 0
      }
      n += 1
    }
  }
  // a door?
  n = 0
  while n < length(drx) {
    if not drOpen[n] and abs(drx[n] * 16 + 16 - cx) < 24 and abs(dry[n] * 16 + 8 - cy) < 28 {
      if keys > 0 {
        keys -= 1
        drOpen[n] = true
        grid[dry[n] * MW + drx[n]] = "d"
        grid[dry[n] * MW + drx[n] + 1] = "d"
        checkX = drx[n] * 16 + 11
        checkY = dry[n] * 16 + 20
        if cy < dry[n] * 16 {
          checkY = dry[n] * 16 - 10
        }
        shake = 6
        sound sndDoor
        burst(drx[n] * 16 + 16, dry[n] * 16 + 8, 18, "#c9a27e", 20)
      } else {
        sound sndLocked
        say("The door is locked tight.\nThere must be a key somewhere on this floor.")
      }
      return 0
    }
    n += 1
  }
  // the ladder down?
  if bossDead and cx / 16 == ladX and cy / 16 == ladY {
    useLadder()
    return 0
  }
  // moonwater?
  if cell(cx / 16, cy / 16 - 1) == "u" or cell((cx - 6) / 16, cy / 16 - 1) == "u" or cell((cx + 6) / 16, cy / 16 - 1) == "u" {
    hp = maxHp
    checkX = hx
    checkY = hy
    burst(cx, cy - 10, 20, "#9bd3ff", 18)
    effect(16, cx, cy - 8, 40, "#9bd3ff", 30, 140, 0, 3)
    effect(9, cx, cy - 8, 36, "#e8f4ff", 60, 100, 0, 5)
    drift(0, -6)
    sound sndHeal
    if tick - healedAt > 600 {
      say("The cold moonwater fills you with strength.\nYour hearts are restored.")
    }
    healedAt = tick
    return 0
  }
  // otherwise, swing
  if swing == 0 and dash == 0 {
    swing = wLen[weapon]
    swingHit = false
    if weapon == 3 {
      sound sndSwing
      tone 120 to 60 for 120ms
    } else if weapon != 5 and weapon != 7 {
      sound sndSwing volume 70
    }
  }
}

fn buy(item) {
  let cost = shopCost[item]
  if (item == 7 or item == 8) and not vaultOpen() {
    sound sndLocked
    say("The vault is sealed. Reach floor " + vaultFloor + "\nand the mage will open it.")
    return 0
  }
  if item >= 3 and item <= 8 and contains(owned, item - 1) {
    sound sndNope
    say("You already own the " + shopName[item] + ".\nPress C to switch to it.")
    return 0
  }
  if item == 2 and maxHp >= 10 {
    sound sndNope
    say("Five hearts is as strong as a knight gets.")
    return 0
  }
  if item >= 17 {
    if not vaultOpen() {
      sound sndLocked
      say("The altars are sealed. Reach floor " + vaultFloor + "\nand the mage will wake them.")
      return 0
    }
    if ench[item - 17] >= 3 {
      sound sndNope
      say("The " + shopName[item] + " enchantment is at its\npeak (level 3).")
      return 0
    }
    cost = enchCost(item - 17)
  }
  if item == 14 and smithLv >= 3 {
    sound sndNope
    say("The blade can't be honed any sharper.")
    return 0
  }
  if (item == 15 and hasCharm == 1) or (item == 16 and hasFang == 1) {
    sound sndNope
    say("You already wear the " + shopName[item] + ".")
    return 0
  }
  if (item == 1 or (item >= 9 and item <= 13)) and inv[potionSlot(item)] >= invMax {
    sound sndNope
    say("Your pack can't hold more than " + invMax + " of those.")
    return 0
  }
  if coins < cost {
    sound sndNope
    say("MAGE:\nThat's " + cost + " gold. You have " + coins + ". Come back richer!")
    return 0
  }
  coins -= cost
  sound sndBuy
  burst(hx + 5, hy - 8, 14, "#ffd23f", 16)
  effect(16, hx + 5, hy - 6, 30, "#ffd23f", 30, 110, 0, 4)
  if item == 1 or (item >= 9 and item <= 13) {
    inv[potionSlot(item)] += 1
    if not packTip {
      packTip = true
      say("It goes in your pack. Press B to open it.\n1 2 3 4 5 drink potions, G drops a bomb.")
    }
  } else if item >= 17 {
    ench[item - 17] += 1
    sound jingleTreasure
    say(upper(shopName[item]) + " is now level " + ench[item - 17] + "!\n" + enchInfo[item - 17])
  } else if item == 14 {
    smithLv += 1
    sound jingleTreasure
    say("The mage hones your blade.\nSword damage +" + smithLv + " (max 3).")
  } else if item == 15 {
    hasCharm = 1
    sound jingleTreasure
    say("You tuck the Lucky Charm away.\nCoins are worth half again as much!")
  } else if item == 16 {
    hasFang = 1
    sound jingleTreasure
    say("The Vampire Fang hums on your belt.\nEvery sixth kill heals you a little.")
  } else if item == 2 {
    maxHp += 2
    hp = maxHp
    say("A new heart! You can take more hits now.")
  } else {
    giveWeapon(item - 1)
    say("You bought the " + shopName[item] + ".\n" + wInfo[item - 1])
  }
  saveGame()
}

// ---------- quests ----------
fn questsOpen() {
  return won == 1 or deepest >= 6
}

fn questNpc(q) {
  let n = 0
  while n < 3 and q > npcLast[n] {
    n += 1
  }
  return n
}

fn npcCount() {
  if deepest >= 7 {
    return 4
  }
  return 3
}

// the first quest of theirs that isn't finished (or -1)
fn npcQuest(n) {
  let q = npcFirst[n]
  while q <= npcLast[n] and qState[q] == 3 {
    q += 1
  }
  if q > npcLast[n] {
    return -1
  }
  return q
}

// the stair to the Moonwell Source opens when Vesper's story quest is done
fn stairOpen() {
  return qState[6] == 3
}

fn saveQuests() {
  let data = []
  for each qv in qState {
    add qv to data
  }
  for each qv in qProg {
    add qv to data
  }
  save "quests", data
}

fn showToast(words) {
  toast = words
  toastT = 240
  sound sndSwitch volume 50
}

// something happened that quests might care about
fn questAdd(kind, param, amount) {
  if not questsOpen() {
    return 0
  }
  let q = 0
  let changed = false
  while q < length(qName) {
    if qState[q] == 1 and qType[q] == kind {
      let ok = true
      if kind == 2 and param != 3 and param != 9 {
        ok = false
      }
      if kind == 4 and param != qParam[q] {
        ok = false
      }
      if ok {
        if kind == 3 {
          qProg[q] = max(qProg[q], amount)
        } else {
          qProg[q] += amount
        }
        changed = true
        if qProg[q] >= qNeed[q] {
          qProg[q] = qNeed[q]
          qState[q] = 2
          showToast("Quest ready: " + qName[q] + " - see " + npcName[questNpc(q)])
        }
      }
    }
    q += 1
  }
  if changed {
    saveQuests()
  }
}

// Moon Shards count whenever you find them, even before Vesper asks
fn syncShards() {
  if qState[6] == 1 {
    qProg[6] = length(shardFloors)
    if qProg[6] >= qNeed[6] {
      qProg[6] = qNeed[6]
      qState[6] = 2
      showToast("Quest ready: " + qName[6] + " - see VESPER")
    }
    saveQuests()
  }
}

fn talkNpc(n) {
  let q = npcQuest(n)
  if q < 0 {
    if n == 0 {
      say("SSSORA:\nThe warrens ssing your name, knight.\nSssleep well.")
    } else if n == 1 {
      say("LIRAEL:\nThe deep is quieter now. Thank you.\nThe old order lives on in you.")
    } else if n == 2 {
      say("VESPER:\nThe Source is open to you. May its light\nguide you, last knight.")
    } else {
      say("MARROW:\nRattle rattle. The Archive is quiet again.\nGood. I do love a quiet shelf.")
    }
    return 0
  }
  if q == 6 and deepest < 7 {
    say("VESPER:\nCome back once you've been deeper than the\nEmber Throne, knight. I'll have a task.")
    return 0
  }
  if qState[q] == 0 {
    say(qOffer[q])
    say("NEW QUEST: " + qName[q] + "\n" + qGoal[q])
    qState[q] = 1
    sound sndSwitch
    saveQuests()
    if q == 6 {
      syncShards()
    }
  } else if qState[q] == 1 {
    say(npcName[n] + ":\n" + qName[q] + ": " + qProg[q] + " / " + qNeed[q] + "\n" + qGoal[q])
  } else {
    finishQuest(q)
  }
}

fn finishQuest(q) {
  let reward = ""
  if qGold[q] > 0 {
    coins += qGold[q]
    reward = "+" + qGold[q] + " gold"
  }
  if qCount[q] > 0 {
    inv[qItem[q]] = min(invMax, inv[qItem[q]] + qCount[q])
    if reward != "" {
      reward = reward + ", "
    }
    reward = reward + qCount[q] + " x " + invName[qItem[q]]
  }
  qState[q] = 3
  saveQuests()
  saveGame()
  sound jingleTreasure
  whiteT = 3
  burst(hx + 5, hy - 8, 20, "#ffd23f", 20)
  effect(16, hx + 5, hy - 6, 30, "#ffd23f", 30, 120, 0, 4)
  say(npcName[questNpc(q)] + ":\nWell done, knight. Here, you've earned it.")
  say("QUEST COMPLETE: " + qName[q] + "\n" + reward)
  if q == 6 {
    say("VESPER:\nTwo shards, one key. The sealed stair is\nopen! Beyond the Bone Orchard, the Moonwell\nSource awaits.")
  }
}

fn potionSlot(item) {
  if item == 9 {
    return 1
  }
  if item == 10 {
    return 2
  }
  if item == 11 {
    return 3
  }
  if item == 12 {
    return 4
  }
  if item == 13 {
    return 5
  }
  return 0
}

fn addStand(tx, ty, which) {
  add tx to skx
  add ty to sky
  add which to skIdx
  grid[ty * MW + tx] = "q"
}

fn addSecretStand() {
  addStand(29, 13, 6)
}

fn vaultOpen() {
  return deepest >= vaultFloor
}

// the campfire's secret: poke it five times
fn pokeFire() {
  if contains(skinsOwned, 6) {
    say("The campfire crackles happily.")
    return 0
  }
  fireTaps += 1
  let fx0 = 14 * 16 + 8
  let fy0 = 12 * 16 + 8
  burst(fx0, fy0 - 8, 6 + fireTaps * 4, "#ffb34a", 10 + fireTaps * 4)
  effect(15, fx0, fy0 - 6, 16, "#ff6a1f", 40, 60 + fireTaps * 30, 0, 0)
  tone 200 + fireTaps * 80 to 120 for 120ms
  if fireTaps == 1 {
    say("The campfire crackles.")
  } else if fireTaps == 2 {
    say("The flames lean toward you...")
  } else if fireTaps == 3 {
    say("You hear a whisper in the embers.")
  } else if fireTaps == 4 {
    say("The fire roars hotter! Once more...")
  } else {
    cutT = 330
    sound sndSwitch
  }
}

// the Ember Knight cutscene, played on the fifth poke
fn playCut() {
  let t = 330 - cutT
  let fx0 = 14 * 16 + 8
  let fy0 = 12 * 16 + 8
  if t < 120 {
    if t % 4 == 0 {
      burst(fx0, fy0 - 8, 3, "#ffb34a", 12 + t / 8)
    }
    if t % 20 == 0 {
      effect(16, fx0, fy0 - 6, 30, "#ff6a1f", 20, 90 + t, 0, 4)
    }
    if t % 10 == 0 {
      shake = 3 + t / 30
      tone 120 + t * 3 to 100 for 100ms
    }
  } else if t < 210 {
    if t % 3 == 0 {
      burst(fx0 + random(-30, 30), fy0 - 8 + random(-18, 18), 1, "#ff9a2a", 10)
    }
    if t % 15 == 0 {
      effect(14, hx + 5, hy - 6, 20, "#ffb34a", 10, 80, 0, 0)
    }
  } else if t == 210 {
    add 6 to skinsOwned
    save "skins", skinsOwned
    addSecretStand()
    skin = 6
    save "skin", skin
    whiteT = 45
    shake = 16
    sound jingleTreasure
    effect(14, fx0, fy0 - 6, 30, "#ff6a1f", 30, 300, 0, 0)
    effect(16, hx + 5, hy - 6, 40, "#ffb34a", 50, 180, 0, 8)
    repeat 6 {
      puff(fx0, fy0 - 6, "#5a3a2a")
    }
  }
  cutT -= 1
  if cutT == 0 {
    say("A knight of embers steps out of the fire,\nbows... and joins you.")
    say("SECRET LOOK FOUND: EMBER KNIGHT!\nYou are wearing it now. It waits in the\nwardrobe, free.")
  }
}

fn drawCut() {
  let t = 330 - cutT
  let bar = min(24, min(t / 2, cutT / 2))
  box 0, 0, 320, bar color "#000000"
  box 0, 180 - bar, 320, bar color "#000000"
  if t > 215 and t < 320 {
    let a = min(15, min((t - 215) / 3, (320 - t) / 3))
    write "EMBER KNIGHT" at 160, 78 size 2 centered color "#ffb34a" + fadeHex[a] shadow
    write "born of the campfire" at 160, 98 centered color "#e8f4ff" + fadeHex[a]
  }
}

fn wardrobe(n) {
  if (n == 5 or n == 7) and not vaultOpen() and not contains(skinsOwned, n) {
    sound sndLocked
    say("MAGE:\nThat one's sealed until you've reached\nfloor " + vaultFloor + ".")
    return 0
  }
  if n == skin {
    say("You're already wearing the " + skinName[n] + " look.")
    return 0
  }
  if not contains(skinsOwned, n) {
    if coins < skinCost[n] {
      sound sndNope
      say("MAGE:\nThe " + skinName[n] + " look is " + skinCost[n] + " gold.\nYou have " + coins + ". Fashion isn't cheap!")
      return 0
    }
    coins -= skinCost[n]
    add n to skinsOwned
    save "skins", skinsOwned
    sound jingleTreasure
    say("New look: " + upper(skinName[n]) + "!\nIt's yours forever, on every journey.")
  } else {
    sound sndSwitch
  }
  skin = n
  save "skin", skin
  saveGame()
  burst(hx + 5, hy - 8, 24, "#ffd23f", 20)
  effect(16, hx + 5, hy - 6, 30, "#e8f4ff", 30, 130, 0, 6)
  effect(4, hx + 5, hy - 6, 12, "#c9c3d6", 140, 40, 0, 0)
}

fn pressZ() {
  if enchOpen {
    closeEnch()
    return 0
  }
  if setOpen {
    closeSettings()
    return 0
  }
  if achOpen or statsOpen {
    achOpen = false
    statsOpen = false
    return 0
  }
  if helpOpen {
    helpOpen = false
    return 0
  }
  if mode == 0 and touch and length(msgs) == 0 and not typingCode {
    newJourney()
    return 0
  }
  if invOpen {
    invOpen = false
    return 0
  }
  if mode != 1 or length(msgs) > 0 or dying > 0 {
    return 0
  }
  if dashCool == 0 and swing == 0 {
    dash = 9
    dashCool = 36 - ench[4] * 8
    if skin == 1 {
      dashCool = 20 - ench[4] * 4
    }
    sound sndDash
    if skin == 5 {
      cometHit = ","
      tone 900 to 1500 for 120ms
    }
    puff(hx + 5, hy + 6, "#b9a8a0")
    puff(hx + 5, hy + 6, "#b9a8a0")
    if faceX == 0 and faceY == 0 {
      faceY = 1
    }
  }
}

// puts a coin or potion on the floor where you can actually walk to it
fn dropItem(px, py, kind) {
  let bestX = hx + 5
  let bestY = hy + 2
  let found = false
  let radius = 0
  while radius < 5 and not found {
    let gap = radius * 10
    let t = 0
    while t < 9 and not found {
      let tx = px + (t % 3 - 1) * gap
      let ty = py + (t / 3 - 1) * gap
      if not blocked(tx - 5, ty - 2, 10, 8) {
        bestX = tx
        bestY = ty
        found = true
      }
      t += 1
    }
    radius += 1
  }
  add bestX to ix
  add bestY to iy
  add kind to ikind
}

// coins earned: a Fortune potion doubles them
fn gain(n) {
  let amount = n
  if hasCharm == 1 {
    amount = n + n / 2
  }
  if goldT > 0 {
    amount = amount * 2
  }
  coins += amount
  stats[2] += amount
  questAdd(5, 0, amount)
}

fn openChest(n) {
  chOpen[n] = 1
  stats[5] += 1
  sound sndChest
  let px = chx[n] * 16 + 8
  let py = chy[n] * 16 + 4
  burst(px, py, 14, "#ffd23f", 16)
  effect(16, px, py, 30, "#ffd23f", 40, 120, 0, 3)
  effect(2, px, py - 6, 20, "#ffffff", 150, 40, 0, 4)
  if chWhat[n] == 1 {
    keys += 1
    sound jingleKey
    say("You found a KEY!\nIt opens one locked door. Press X beside it.")
  } else if chWhat[n] == 4 {
    stats[4] += 1
    add floor to secFound
    questAdd(8, 0, 1)
    let loot = 30 + floor * 10
    gain(loot)
    inv[5] = min(invMax, inv[5] + 3)
    sound jingleTreasure
    say("A SECRET STASH!\n" + loot + " gold and three bombs.")
    save "secrets", secFound
  } else if chWhat[n] == 3 {
    let wid = min(5, floor + 1)
    if contains(owned, wid) {
      gain(25)
      say("A " + wName[wid] + "... you already have one.\nYou sell the spare for 25 gold.")
    } else {
      giveWeapon(wid)
      sound jingleTreasure
      say("You found the " + upper(wName[wid]) + "!\n" + wInfo[wid] + "  (C switches weapons)")
    }
  } else {
    gain(10)
    sound sndCoin
    dropItem(px, py + 14, 2)
    say("Ten gold coins, and a healing potion!")
  }
}

fn respawn() {
  hx = checkX
  hy = checkY
  hp = maxHp
  hurt = 90
  dying = 0
  swing = 0
  dash = 0
  kbx = 0
  kby = 0
  mode = 1
  bx = []
  by = []
  bvx = []
  bvy = []
  bcol = []
  // the boss goes back to the middle of its room
  let n = 0
  while n < length(ex) {
    if isBoss(ekind[n]) {
      ehp[n] = bossMax
      ex[n] = (ehome[n] % MW) * 16 - 4
      ey[n] = (ehome[n] / MW) * 16
      bossAwake = false
      bossAngry = false
      bossRush = 0
      bossWind = 0
    }
    n += 1
  }
  say("You rise again, a little wiser.")
}

// =====================================================================
//  Monsters
// =====================================================================
fn moveEnemy(n, dx, dy) {
  let w = enemyW(ekind[n])
  let h = enemyH(ekind[n])
  if dx != 0 and not blocked(ex[n] + dx, ey[n], w, h) {
    ex[n] += dx
  }
  if dy != 0 and not blocked(ex[n], ey[n] + dy, w, h) {
    ey[n] += dy
  }
}

fn countKind(k) {
  let c = 0
  for each kk in ekind {
    if kk == k {
      c += 1
    }
  }
  return c
}

fn updateEnemies() {
  let n = 0
  while n < length(ex) {
    let k = ekind[n]
    let w = enemyW(k)
    let h = enemyH(k)
    let dx = hx + 5 - (ex[n] + w / 2)
    let dy = hy + 4 - (ey[n] + h / 2)
    let far = abs(dx) + abs(dy)
    let go = tick % kindPace[k] == 0
    if ehurt[n] > 0 {
      ehurt[n] -= 1
    }
    if ekx[n] != 0 or eky[n] != 0 {
      // knocked back
      moveEnemy(n, ekx[n], eky[n])
      ekx[n] -= sign(ekx[n])
      eky[n] -= sign(eky[n])
    } else if isBoss(k) {
      updateBoss(n, dx, dy, far)
    } else if (k == 10 or k == 11) and far < 150 and dying == 0 {
      // spellcasters keep their distance and shoot
      if go {
        if far < 70 {
          moveEnemy(n, 0 - sign(dx), 0 - sign(dy))
        } else if far > 110 {
          moveEnemy(n, sign(dx), sign(dy))
        }
      }
      eleft[n] = dx < 0
      eshot[n] -= 1
      if eshot[n] <= 0 {
        eshot[n] = random(110, 170)
        if k == 10 {
          aimAt(ex[n] + 6, ey[n] - 8, 18, 1, "#ff8a3d")
        } else {
          aimAt(ex[n] + 6, ey[n] - 8, 15, 3, "#c77dff")
          if countKind(12) < 6 {
            spawnNear(12, (ex[n] + 6) / 16 + random(-1, 1), (ey[n] + 4) / 16 + random(-1, 1))
          }
        }
        tone 520 to 260 for 90ms
        if k == 10 {
          effect(9, ex[n] + 6, ey[n] - 8, 18, "#ff8a3d", 40, 90, 0, 8)
        } else {
          effect(9, ex[n] + 6, ey[n] - 8, 22, "#c77dff", 40, 110, 0, -8)
        }
      }
    } else if far < 120 and dying == 0 {
      if go {
        moveEnemy(n, sign(dx), sign(dy))
        if k == 4 and tick % 20 < 10 {
          moveEnemy(n, sign(dy), 0 - sign(dx))
        }
      }
      eleft[n] = dx < 0
    } else {
      etimer[n] -= 1
      if etimer[n] <= 0 {
        etimer[n] = random(40, 110)
        edx[n] = random(-1, 1)
        edy[n] = random(-1, 1)
      }
      if go and tick % 2 == 0 {
        moveEnemy(n, edx[n], edy[n])
        if edx[n] != 0 {
          eleft[n] = edx[n] < 0
        }
      }
    }
    // touching the hero hurts
    if overlap(hx, hy, 10, 8, ex[n] - 2, ey[n] - 2, w + 4, h + 4) {
      hurtElem = kindElem(k)
      hurtHero(kindHit[k], ex[n] + w / 2, ey[n] + h / 2)
    }
    if ehp[n] <= 0 {
      killEnemy(n)
    } else {
      n += 1
    }
  }
}

fn killEnemy(n) {
  let k = ekind[n]
  let px = ex[n] + enemyW(k) / 2
  let py = ey[n] + enemyH(k) / 2
  burst(px, py - 6, 22, "#ff8a3d", 28)
  burst(px, py - 6, 10, "#6b5b55", 16)
  repeat 3 {
    puff(px, py - 8, "#8a7c86")
  }
  effect(15, px, py - 6, 14, "#ff8a3d", 70, 10, 0, 0)
  sound sndHeavy volume 70
  shake = max(shake, 6)
  stats[0] += 1
  if hasFang == 1 {
    fangKills += 1
    if fangKills >= 6 {
      fangKills = 0
      if hp < maxHp and hp > 0 {
        hp += 1
        effect(9, hx + 5, hy - 6, 30, "#ff6b8a", 40, 90, 0, 6)
      }
    }
  }
  questAdd(1, k, 1)
  questAdd(2, k, 1)
  questAdd(4, k, 1)
  let roll = random(1, 100)
  if k != 12 or roll <= 25 {
    if roll <= 50 {
      dropItem(px, py, 1)
    } else if roll <= 62 {
      dropItem(px, py, 2)
    }
  }
  if isBoss(k) {
    stats[6] += 1
    bossDead = true
    shake = 40
    freeze = 20
    bx = []
    by = []
    bvx = []
    bvy = []
    bcol = []
    burst(px, py - 10, 60, "#ffd23f", 45)
    burst(px, py - 10, 40, "#e8f4ff", 35)
    effect(14, px, py - 10, 40, "#ffd23f", 30, 400, 0, 0)
    effect(16, px, py - 10, 50, "#e8f4ff", 60, 220, 0, 4)
    repeat 8 {
      puff(px + random(-20, 20), py - random(0, 20), "#6b5b55")
    }
    sound sndSlam
    sound jingleBoss
    // a pile of gold
    repeat 20 {
      dropItem(px + random(-20, 20), py + random(-14, 14), 1)
    }
    if k == 14 {
      say("GRUKK THE GATEKEEPER:\nGrukk... tired. Grukk... nap now.")
      say("A ladder leads down to the next floor.\nStand on it and press X.")
    } else if k == 15 {
      say("THE ROTTING WARDEN:\nThe dead... will rest... at last.")
      say("The ladder leads deeper. A cold wind\nblows up from below.")
    } else if k == 16 {
      say("VAEL:\nMy bones... were meant... to last forever...")
      say("The ladder leads deeper. You hear drums.")
    } else if k == 17 {
      say("WARLORD KRAG:\nKrag... beaten... by a tin can?!")
      say("The ladder leads deeper. Heat rises.")
    } else if k == 18 {
      say("IGNIS:\nMy king... will... avenge me...")
      say("The ladder leads down to the Ember Throne.\nThis is it, knight.")
    } else if k == 19 {
      say("ARCHIVIST MORWEN:\nThe last page... is blank...")
      say("A ladder leads down. The ink-dark water\nstirs below.")
    } else if k == 20 {
      say("THE BONE COLOSSUS:\n...rest...")
      say("The ladder leads down, toward a pale light.")
    } else if k == 21 {
      say("THE HOLLOW MOON:\nI only wanted... to be full...")
      say("The Source flows silver again. The ladder\nleads down to the fire's last stronghold.")
    } else if k == 22 {
      say("WARLORD ZORN:\nThe fire... will not... forgive...")
      say("Heat pours up the ladder. The heart of the\nfire is close.")
    } else if k == 23 {
      say("THE CINDER GOD:\nI was only... a spark. You... are the\nlight...")
      say("The fire gutters out. For the first time in a\nhundred moons, the Moonwell blazes with silver.")
    } else {
      say("The Ember King crumbles into cinders...")
      say("Silver light floods the halls once more...\nbut it flickers. The ladder leads on.")
    }
  }
  remove ex[n]
  remove ey[n]
  remove ekind[n]
  remove ehp[n]
  remove ehurt[n]
  remove ekx[n]
  remove eky[n]
  remove etimer[n]
  remove edx[n]
  remove edy[n]
  remove eleft[n]
  remove ehome[n]
  remove eshot[n]
}

fn wakeBoss() {
  bossAwake = true
  shake = 20
  tone 90 to 40 for 900ms
  if bossKind == 14 {
    say("GRUKK THE GATEKEEPER:\nNobody passes Grukk! Grukk SMASH!")
  } else if bossKind == 15 {
    say("THE ROTTING WARDEN:\nThe dead do not sleep here, knight.\nNeither will you.")
  } else if bossKind == 16 {
    say("VAEL, THE NECROMANCER LORD:\nWarm blood! How rare. You'll make\na fine skeleton.")
  } else if bossKind == 17 {
    say("WARLORD KRAG:\nWAAAGH! Krag eats knights for breakfast!")
  } else if bossKind == 18 {
    say("IGNIS, THE CHORT QUEEN:\nCatch me if you can, little knight!")
  } else if bossKind == 19 {
    say("ARCHIVIST MORWEN:\nSilence, please. This is an archive.")
  } else if bossKind == 20 {
    say("THE BONE COLOSSUS:\n*the trees rattle as it stands*")
  } else if bossKind == 21 {
    say("THE HOLLOW MOON:\nYou carry light. Give it... give it...")
  } else if bossKind == 22 {
    say("WARLORD ZORN:\nThe Ember King was soft. I am IRON!")
  } else if bossKind == 23 {
    say("THE CINDER GOD:\nA hundred moons I burned. Now, YOU.")
  } else {
    say("THE EMBER KING:\nAnother little knight, come to be ash?")
    say("THE EMBER KING:\nThe Moonwell is MINE. Burn!")
  }
}

fn bossAngryNew(n, k) {
  let tx = ex[n] / 16
  let ty = ey[n] / 16
  if k == 19 {
    say("ARCHIVIST MORWEN:\nEvery story ends. Yours ends HERE.")
    spawnNear(2, tx - 3, ty)
    spawnNear(2, tx + 4, ty)
    spawnNear(10, tx, ty + 3)
  } else if k == 20 {
    say("THE BONE COLOSSUS:\n*CRACK*  ...MORE BONES...")
    spawnNear(2, tx - 3, ty)
    spawnNear(2, tx + 4, ty)
    spawnNear(6, tx, ty + 3)
  } else if k == 21 {
    say("THE HOLLOW MOON:\nThe light is MINE to swallow.")
    spawnNear(24, tx - 3, ty)
    spawnNear(24, tx + 4, ty)
    spawnNear(7, tx, ty + 3)
  } else if k == 22 {
    say("WARLORD ZORN:\nASH AND IRON! ARISE, MY LEGION!")
    spawnNear(9, tx - 3, ty)
    spawnNear(3, tx + 4, ty)
    spawnNear(10, tx, ty + 3)
  } else {
    say("THE CINDER GOD:\nI AM THE HEART OF THE FIRE!")
    spawnNear(13, tx - 4, ty)
    spawnNear(13, tx + 5, ty)
    spawnNear(4, tx, ty + 4)
    spawnNear(9, tx + 2, ty + 4)
  }
}

fn updateBoss(n, dx, dy, far) {
  if not bossAwake {
    if far < 110 and dying == 0 {
      wakeBoss()
    }
    return 0
  }
  let k = ekind[n]
  let ai = bossAi(k)
  let px = ex[n] + 12
  let py = ey[n] - 8
  eleft[n] = dx < 0
  if ehp[n] * 2 <= bossMax and not bossAngry {
    bossAngry = true
    shake = 16
    if k >= 19 {
      bossAngryNew(n, k)
    } else if k == 14 {
      say("GRUKK THE GATEKEEPER:\nGrukk ANGRY now!")
    } else if k == 16 {
      say("VAEL:\nMy servants! Bring me his bones!")
      spawnNear(2, ex[n] / 16 - 3, ey[n] / 16)
      spawnNear(2, ex[n] / 16 + 4, ey[n] / 16)
      spawnNear(7, ex[n] / 16, ey[n] / 16 + 3)
    } else if k == 17 {
      say("WARLORD KRAG:\nBOYS! GET IN HERE!")
      spawnNear(9, ex[n] / 16 - 3, ey[n] / 16)
      spawnNear(3, ex[n] / 16 + 4, ey[n] / 16)
    } else if k == 18 {
      say("IGNIS:\nNow you've made me ANGRY!")
      spawnNear(13, ex[n] / 16 - 3, ey[n] / 16)
      spawnNear(13, ex[n] / 16 + 4, ey[n] / 16)
    } else if k == 15 {
      say("THE ROTTING WARDEN:\nRise, all of you. RISE!")
      spawnNear(12, ex[n] / 16 - 3, ey[n] / 16)
      spawnNear(12, ex[n] / 16 + 4, ey[n] / 16)
      spawnNear(6, ex[n] / 16, ey[n] / 16 + 3)
    } else {
      say("THE EMBER KING:\nRise, my servants! Burn this knight!")
      spawnNear(13, ex[n] / 16 - 4, ey[n] / 16)
      spawnNear(13, ex[n] / 16 + 5, ey[n] / 16)
      spawnNear(4, ex[n] / 16, ey[n] / 16 + 4)
    }
  }
  // Grukk and Krag: wind up, then charge (Krag is faster)
  if ai == 14 or ai == 17 {
    if bossRush > 0 {
      bossRush -= 1
      moveEnemy(n, bossRushX, bossRushY)
      moveEnemy(n, bossRushX, bossRushY)
      if ai == 17 {
        moveEnemy(n, bossRushX, bossRushY)
      }
      if tick % 3 == 0 {
        burst(px, py + 16, 2, "#8a7a6a", 10)
      }
      if bossRush == 0 {
        effect(14, px, py + 16, 26, "#c9a27e", 30, 260, 0, 0)
        repeat 5 {
          puff(px, py + 14, "#8a7a6a")
        }
        shake = 10
        sound sndSlam
        if bossAngry or ai == 17 {
          ring(px, py + 6, tick % 2 == 0, "#c9a27e")
        }
        if ai == 17 and bossAngry {
          aimAt(px, py, 20, 3, "#ff8a3d")
        }
      }
      return 0
    }
    if bossWind > 0 {
      bossWind -= 1
      if bossWind == 0 {
        bossRush = 28
        bossRushX = sign(dx) * 2
        bossRushY = sign(dy) * 2
        if abs(dx) < 10 {
          bossRushX = 0
        }
        if abs(dy) < 10 {
          bossRushY = 0
        }
        tone 140 to 300 for 150ms
      }
      return 0
    }
    if tick % 2 == 0 {
      moveEnemy(n, sign(dx), sign(dy))
    }
    bossShot += 1
    let gap = 150
    if ai == 17 {
      gap = 110
    }
    if bossAngry {
      gap = gap * 2 / 3
    }
    if bossShot >= gap {
      bossShot = 0
      bossWind = 30
      ehurt[n] = 0
    }
    return 0
  }
  // Vael: keeps his distance, throws rings of cold fire and raises skeletons
  if ai == 16 {
    if tick % 2 == 0 {
      if far < 90 {
        moveEnemy(n, 0 - sign(dx), 0 - sign(dy))
      } else if far > 150 {
        moveEnemy(n, sign(dx), sign(dy))
      } else {
        moveEnemy(n, sign(dy), 0 - sign(dx))
      }
    }
    bossShot += 1
    let gap = 100
    if bossAngry {
      gap = 70
    }
    if bossShot >= gap {
      bossShot = 0
      bossWind += 1
      if bossWind % 2 == 0 {
        ring(px, py, bossWind % 4 == 0, "#9bd3ff")
        effect(14, px, py, 22, "#9bd3ff", 20, 170, 0, 0)
      } else {
        aimAt(px, py, 18, 3, "#c77dff")
      }
      effect(9, px, py, 24, "#c77dff", 50, 120, 0, 8)
      tone 420 to 160 for 160ms
      if bossWind % 3 == 0 and countKind(2) < 4 {
        spawnNear(2, ex[n] / 16 + random(-3, 3), ey[n] / 16 + random(1, 3))
      }
    }
    return 0
  }
  // Ignis: fades out, appears beside the knight and fires a fan
  if ai == 18 {
    if bossWind > 0 {
      bossWind -= 1
      if bossWind == 12 {
        // jump to a free spot near the knight
        let tries = 0
        while tries < 12 {
          let nx = hx + 5 - 12 + random(-70, 70)
          let ny = hy + 4 - 7 + random(-55, 55)
          if abs(nx - hx) + abs(ny - hy) > 45 and not blocked(nx, ny, 24, 14) {
            effect(16, px, py, 20, "#ff5a1f", 80, 10, 0, 6)
            ex[n] = nx
            ey[n] = ny
            effect(16, nx + 12, ny - 8, 20, "#ff5a1f", 10, 90, 0, -6)
            tries = 99
          }
          tries += 1
        }
        tone 900 to 300 for 120ms
      }
      if bossWind == 0 {
        aimAt(ex[n] + 12, ey[n] - 8, 20, 5, "#ff8a3d")
        if bossAngry {
          ring(ex[n] + 12, ey[n] - 8, tick % 2 == 0, "#ff5a1f")
        }
        tone 500 to 180 for 120ms
      }
      return 0
    }
    moveEnemy(n, sign(dx), sign(dy))
    bossShot += 1
    let gap = 130
    if bossAngry {
      gap = 85
    }
    if bossShot >= gap {
      bossShot = 0
      bossWind = 24
    }
    return 0
  }
  // the Warden: slow, spits and calls the dead
  if ai == 15 {
    if tick % 3 == 0 {
      moveEnemy(n, sign(dx), sign(dy))
    }
    bossShot += 1
    let gap = 110
    if bossAngry {
      gap = 75
    }
    if bossShot >= gap {
      bossShot = 0
      if bossAngry {
        aimAt(px, py, 16, 5, "#9be36b")
      } else {
        aimAt(px, py, 16, 3, "#9be36b")
      }
      tone 300 to 120 for 140ms
      if countKind(12) < 4 and random(1, 3) == 1 {
        spawnNear(12, ex[n] / 16 + random(-3, 3), ey[n] / 16 + 2)
      }
    }
    return 0
  }
  // the Ember King: rings of fire, and aimed bursts when angry
  if tick % 2 == 0 {
    moveEnemy(n, sign(dx), sign(dy))
  }
  bossShot += 1
  let gap = 120
  if bossAngry {
    gap = 70
  }
  if bossShot >= gap {
    bossShot = 0
    ring(px, py, bossAngry and tick % 2 == 0, "#ff5a1f")
    effect(14, px, py, 22, "#ff5a1f", 20, 180, 0, 0)
    if bossAngry {
      aimAt(px, py, 22, 3, "#ffd23f")
    }
    tone 500 to 180 for 120ms
    burst(px, py, 10, "#ff8a3d", 20)
  }
}

fn updateFireballs() {
  let n = 0
  while n < length(bx) {
    bx[n] += bvx[n]
    by[n] += bvy[n]
    let px = bx[n] / 10
    let py = by[n] / 10
    let gone = false
    if isWall(px / 16, py / 16) {
      gone = true
      burst(px, py, 5, bcol[n], 14)
    } else if overlap(hx, hy - 12, 10, 20, px - 3, py - 3, 6, 6) {
      hurtElem = kindElem(bossKind)
      hurtHero(1, px, py)
      gone = true
    }
    if gone {
      remove bx[n]
      remove by[n]
      remove bvx[n]
      remove bvy[n]
      remove bcol[n]
    } else {
      n += 1
    }
  }
}

// =====================================================================
//  Items, sparks, rooms
// =====================================================================
fn updateItems() {
  let n = 0
  while n < length(ix) {
    let took = false
    // loose coins and potions drift toward you when you're close
    let pullX = hx + 5 - ix[n]
    let pullY = hy + 2 - iy[n]
    if abs(pullX) + abs(pullY) < 44 and abs(pullX) + abs(pullY) > 4 and dying == 0 {
      if not blocked(ix[n] + sign(pullX) - 5, iy[n] - 2, 10, 8) {
        ix[n] += sign(pullX)
      }
      if not blocked(ix[n] - 5, iy[n] + sign(pullY) - 2, 10, 8) {
        iy[n] += sign(pullY)
      }
    }
    if abs(ix[n] - (hx + 5)) < 11 and abs(iy[n] - (hy + 2)) < 12 {
      if ikind[n] == 3 {
        add floor to shardFloors
        save "shards", shardFloors
        sound jingleKey
        burst(ix[n], iy[n], 16, "#9bd3ff", 20)
        effect(16, ix[n], iy[n], 30, "#9bd3ff", 30, 120, 0, 4)
        say("A MOON SHARD!\nIt hums with silver light. Vesper, back at\ncamp, will want to see this.")
        syncShards()
        took = true
      } else if ikind[n] == 1 {
        let worth = 1 + max(1, floor)
        if skin == 4 {
          worth += max(1, worth / 2)
        }
        gain(worth)
        sound sndCoin volume 60
        burst(ix[n], iy[n], 5, "#ffd23f", 12)
        effect(2, ix[n], iy[n] - 4, 10, "#ffd23f", 70, 20, 0, 9)
        took = true
      } else if hp < maxHp {
        hp = min(maxHp, hp + 2)
        sound sndHeal
        burst(ix[n], iy[n], 10, "#ff4d6d", 14)
        effect(9, hx + 5, hy - 6, 30, "#ff6b8a", 40, 90, 0, 6)
        drift(0, -5)
        took = true
      } else if inv[0] < invMax {
        inv[0] += 1
        sound sndBuy volume 60
        burst(ix[n], iy[n], 8, "#ff4d6d", 12)
        if not packTip {
          packTip = true
          say("Hearts full, so the potion goes in your pack.\nPress B to open it, or 1-5 to drink.")
        }
        took = true
      }
    }
    if took {
      remove ix[n]
      remove iy[n]
      remove ikind[n]
    } else {
      n += 1
    }
  }
  n = 0
  while n < length(chx) {
    if chOpen[n] > 0 and chOpen[n] < 20 {
      chOpen[n] += 1
    }
    n += 1
  }
}

fn updateSparks() {
  let n = 0
  while n < length(qx) {
    qx[n] += qvx[n]
    qy[n] += qvy[n]
    qvx[n] = qvx[n] * 9 / 10
    qvy[n] = qvy[n] * 9 / 10
    qlife[n] -= 1
    if qlife[n] <= 0 {
      remove qx[n]
      remove qy[n]
      remove qvx[n]
      remove qvy[n]
      remove qlife[n]
      remove qcol[n]
    } else {
      n += 1
    }
  }
}

// spikes start to rise: a warning clank if any are near the hero
fn spikeWarning() {
  if tick % 150 != 80 {
    return 0
  }
  let tx = (hx + 5) / 16
  let ty = (hy + 4) / 16
  for sy from ty - 5 to ty + 5 {
    for sx from tx - 8 to tx + 8 {
      if cell(sx, sy) == "^" {
        sound sndSpikes volume 45
        return 0
      }
    }
  }
}

fn checkRooms() {
  let tx = (hx + 5) / 16
  let ty = (hy + 4) / 16
  if floor == 1 and not seenSpikes and tx >= 21 and ty >= 33 {
    seenSpikes = true
    say("Spikes rise and fall in these halls.\nWatch their rhythm... or dash across.")
  }
  if not seenRest and cell(tx, ty - 1) == "u" {
    seenRest = true
    say("A fountain of moonwater. Press X beside it\nto heal and set your return point.")
  }
}

fn updateCamera() {
  let tx = constrain(hx + 5 - 160, 0, max(0, MW * 16 - 320))
  let ty = constrain(hy - 86, 0, max(0, MH * 16 - 180))
  if MW * 16 < 320 {
    tx = (MW * 16 - 320) / 2
  }
  if MH * 16 < 180 {
    ty = (MH * 16 - 180) / 2
  }
  let d = tx - camX
  if d != 0 {
    camX += sign(d) * max(1, abs(d) / 6)
  }
  d = ty - camY
  if d != 0 {
    camY += sign(d) * max(1, abs(d) / 6)
  }
  if shake > 0 {
    shake -= 1
  }
}

fn update() {
  // phones: the controls screen opens by itself the first time you play
  if touch and ctlSeen == 0 {
    ctlSeen = 1
    save "ctl", 1
    helpOpen = true
    return 0
  }
  if freeze > 0 {
    freeze -= 1
    return 0
  }
  playTime += 1
  updateHero()
  updateEnemies()
  updateFireballs()
  updateFlames()
  updateStars()
  updateUnderlings()
  updateItems()
  updateBombs()
  checkRooms()
  if tick % 60 == 0 {
    checkAch()
  }
  spikeWarning()
}

fn pickMusic() {
  if dying > 0 or mode == 2 or (mode == 3 and tick - winAt < 110) {
    music off
  } else if mode == 0 {
    music songTitle, bassTitle tempo 110
  } else if mode == 3 {
    music songWin, bassWin tempo 120
  } else if bossAwake and not bossDead {
    music songBoss, bassBoss tempo 180
  } else if floor == 0 {
    music songCamp, bassCamp tempo 120
  } else if floor == 1 {
    music songHalls, bassHalls tempo 140
  } else if floor == 2 {
    music songCrypt, bassCrypt tempo 100
  } else if floor == 3 {
    music songOssuary, bassOssuary tempo 96
  } else if floor == 4 {
    music songWarrens, bassWarrens tempo 150
  } else if floor == 5 {
    music songFurnace, bassFurnace tempo 170
  } else if floor == 6 {
    music songThrone, bassThrone tempo 160
  } else if floor == 7 {
    music songCrypt, bassCrypt tempo 92
  } else if floor == 8 {
    music songOssuary, bassOssuary tempo 112
  } else if floor == 9 {
    music songTitle, bassTitle tempo 100
  } else if floor == 10 {
    music songFurnace, bassFurnace tempo 150
  } else {
    music songThrone, bassThrone tempo 178
  }
}

// =====================================================================
//  Drawing
// =====================================================================
let bookCols = ["#b23a3a", "#2f6fb0", "#d9a93a", "#3f8f5a", "#8a4fb0", "#c9c3d6", "#d9783a"]

// a bookshelf set into the wall of the Sunken Archive
fn drawShelf(x, y, tx) {
  box x + 1, y + 1, 14, 14 color "#3a2418"
  box x + 2, y + 2, 12, 5 color "#1a0f0a"
  box x + 2, y + 9, 12, 5 color "#1a0f0a"
  let b = 0
  while b < 6 {
    let c = bookCols[(tx * 3 + b) % 7]
    let tall = 3 + (tx + b * 2) % 3
    box x + 2 + b * 2, y + 7 - tall, 2, tall color c
    let c2 = bookCols[(tx * 5 + b * 2 + 1) % 7]
    let tall2 = 3 + (tx * 2 + b) % 3
    box x + 2 + b * 2, y + 14 - tall2, 2, tall2 color c2
    b += 1
  }
  box x + 1, y + 7, 14, 2 color "#6a4426"
  box x + 1, y + 1, 14, 1 color "#6a4426"
}

fn drawCell(tx, ty) {
  if tx < 0 or ty < 0 or tx >= MW or ty >= MH {
    return 0
  }
  let i = ty * MW + tx
  let pic = look[i]
  let x = tx * 16
  let y = ty * 16
  if pic >= 1 and pic <= 3 {
    draw floorA at x, y frame pic - 1
  } else if pic >= 4 and pic <= 6 {
    draw floorB at x, y frame pic - 4
  } else if pic == 7 or pic == 8 {
    draw floorC at x, y frame pic - 7
  } else if pic == 10 {
    draw wallFace at x, y
    if floor == 7 and tx % 3 != 2 {
      drawShelf(x, y, tx)
    }
  } else if pic == 11 or pic == 12 {
    draw bannerRB at x, y frame pic - 11
  } else if pic == 13 or pic == 14 {
    draw bannerGY at x, y frame pic - 13
  } else if pic == 15 {
    draw fountain at x, y frame tick / 8
  } else if pic == 16 {
    draw lavaFall at x, y frame tick / 8
  } else if pic == 20 {
    draw wallTop at x, y
  } else if pic == 21 {
    draw fountainTop at x, y
  }
  // things on the floor
  let ch = grid[i]
  if ch == "^" {
    draw spikes at x, y frame spikeFrame()
  } else if ch == "u" {
    draw basin at x, y frame tick / 8
  } else if ch == "v" {
    draw lavaPool at x, y frame tick / 8
  } else if ch == "x" {
    draw skull at x, y
  } else if ch == "%" {
    box x + 7, y + 1, 1, 5 color "#00000099"
    box x + 5, y + 5, 3, 1 color "#00000099"
    box x + 4, y + 6, 1, 5 color "#00000099"
    box x + 8, y + 7, 4, 1 color "#00000099"
    box x + 11, y + 8, 1, 6 color "#00000099"
    if tick / 20 % 2 == 0 {
      box x + 6, y + 3, 1, 2 color "#d3bfa955"
    }
  }
  if bossDead and tx == ladX and ty == ladY {
    draw ladder at x, y
  }
  // stone edges around the walls
  let e = edge[i]
  if e > 0 {
    if e % 2 == 1 {
      box x + 13, y, 3, 16 color "#aa8d7a"
      box x + 15, y, 1, 16 color "#d3bfa9"
      box x + 12, y, 1, 16 color "#222222"
    }
    if e / 2 % 2 == 1 {
      box x, y, 3, 16 color "#aa8d7a"
      box x, y, 1, 16 color "#d3bfa9"
      box x + 3, y, 1, 16 color "#222222"
    }
    if e / 4 % 2 == 1 {
      box x, y, 16, 3 color "#aa8d7a"
      box x, y, 16, 1 color "#d3bfa9"
      box x, y + 3, 16, 1 color "#222222"
    }
  }
}

fn drawEnemy(n) {
  let k = ekind[n]
  let tall = kindTall[k]
  let w = enemyW(k)
  let h = enemyH(k)
  let sw = 16
  if isBoss(k) {
    sw = 32
  }
  let x = ex[n] + w / 2 - sw / 2
  let y = ey[n] + h - tall
  let f = (tick + n * 7) / 8
  let run = ekx[n] == 0 and (not isBoss(k) or bossAwake)
  let hit = ehurt[n] > 6
  let left = eleft[n]
  box ex[n], ey[n] + h - 2, w, 3 color "#00000055"
  if k == 1 {
    if run {
      draw goblinRun at x, y frame f flip left flash hit
    } else {
      draw goblinIdle at x, y frame f flip left flash hit
    }
  } else if k == 2 {
    if run {
      draw skelRun at x, y frame f flip left flash hit
    } else {
      draw skelIdle at x, y frame f flip left flash hit
    }
  } else if k == 3 {
    if run {
      draw orcRun at x, y frame f flip left flash hit
    } else {
      draw orcIdle at x, y frame f flip left flash hit
    }
  } else if k == 4 {
    if run {
      draw chortRun at x, y frame f flip left flash hit
    } else {
      draw chortIdle at x, y frame f flip left flash hit
    }
  } else if k == 6 {
    draw zombie at x, y frame f flip left flash hit
  } else if k == 7 {
    draw iceZombie at x, y frame f flip left flash hit
  } else if k == 8 {
    draw slime at x, y frame f flip left flash hit
  } else if k == 9 {
    if run {
      draw maskRun at x, y frame f flip left flash hit
    } else {
      draw maskIdle at x, y frame f flip left flash hit
    }
  } else if k == 10 {
    if run {
      draw shamanRun at x, y frame f flip left flash hit
    } else {
      draw shamanIdle at x, y frame f flip left flash hit
    }
  } else if k == 11 {
    draw necro at x, y frame f flip left flash hit
  } else if k == 12 {
    if run {
      draw tinyRun at x, y frame f flip left flash hit
    } else {
      draw tinyIdle at x, y frame f flip left flash hit
    }
  } else if k == 13 {
    if run {
      draw impRun at x, y frame f flip left flash hit
    } else {
      draw impIdle at x, y frame f flip left flash hit
    }
  } else if k == 14 {
    // Grukk glows white while winding up a charge
    let windup = bossWind > 0 and tick % 6 < 3
    if bossWind > 0 {
      draw fxGlow at ex[n] + 12 - 32, ey[n] - 10 - 32 tint "#ff4d4d" alpha 30 + (30 - bossWind) * 2 scale 90 glow
    }
    if run {
      draw ogreRun at x, y frame f flip left flash hit or windup
    } else {
      draw ogreIdle at x, y frame f flip left flash hit
    }
  } else if k == 15 {
    if run {
      draw wardenRun at x, y frame f flip left flash hit
    } else {
      draw wardenIdle at x, y frame f flip left flash hit
    }
  } else if k == 16 {
    // the new bosses are ordinary monsters drawn twice as big
    draw fxGlow at x - 16, y - 12 tint "#c77dff" alpha 25 scale 110 glow
    draw necro at x, y frame f flip left flash hit size 2
  } else if k == 17 {
    let rage = bossWind > 0 and tick % 6 < 3
    if bossWind > 0 {
      draw fxGlow at x - 16, y - 12 tint "#ff4d4d" alpha 30 + (30 - bossWind) * 2 scale 90 glow
    }
    if run {
      draw maskRun at x, y frame f flip left flash hit or rage size 2
    } else {
      draw maskIdle at x, y frame f flip left flash hit size 2
    }
  } else if k == 18 {
    // Ignis fades while she teleports
    let see = 100
    if bossWind > 12 {
      see = (bossWind - 12) * 8
    } else if bossWind > 0 {
      see = (12 - bossWind) * 8
    }
    draw fxGlow at x - 16, y - 8 tint "#ff5a1f" alpha see / 3 scale 100 glow
    if run {
      draw chortRun at x, y frame f flip left flash hit size 2 alpha see
    } else {
      draw chortIdle at x, y frame f flip left flash hit size 2 alpha see
    }
  } else if k == 19 {
    // Morwen: an orc shaman scholar in ink-blue robes, ringed by floating books
    draw shamanIdle at x, y frame f flip left flash hit size 2
    draw shamanIdle at x, y frame f flip left alpha 55 tint "#2a3fa8" size 2
    draw fxGlow at x - 16, y - 20 tint "#6fa8ff" alpha 22 scale 70 glow
    let bk = 0
    while bk < 4 {
      let bkOff = (tick * 2 + bk * 90) % 360
      let ox = 0
      let oy = 0
      if bkOff < 90 {
        ox = bkOff - 45
        oy = -34 - (45 - abs(bkOff - 45)) / 4
      } else if bkOff < 180 {
        ox = 45 - (bkOff - 90) / 2
        oy = -20 + (bkOff - 90) / 4
      } else if bkOff < 270 {
        ox = 45 - (bkOff - 180)
        oy = 4 + (45 - abs(bkOff - 225)) / 4
      } else {
        ox = -45 + (bkOff - 270) / 2
        oy = -10 - (bkOff - 270) / 3
      }
      let bc = bookCols[(bk * 2 + 1) % 7]
      let bx0 = x + 16 + ox
      let by0 = y + 18 + oy
      box bx0, by0, 6, 8 color bc
      box bx0, by0, 1, 8 color "#1a0f0a"
      box bx0 + 2, by0 + 2, 3, 1 color "#f4ecd0"
      box bx0 + 2, by0 + 4, 3, 1 color "#f4ecd0"
      bk += 1
    }
  } else if k == 20 {
    // the Bone Colossus: a bigger, bone-white ogre with antlers of bone
    let windup = bossWind > 0 and tick % 6 < 3
    if bossWind > 0 {
      draw fxGlow at ex[n] + 12 - 32, ey[n] - 10 - 32 tint "#e8e0c8" alpha 30 + (30 - bossWind) * 2 scale 90 glow
    }
    if run {
      draw ogreRun at x, y frame f flip left flash hit or windup scale 140
      draw ogreRun at x, y frame f flip left alpha 80 tint "#efe6cc" scale 140
    } else {
      draw ogreIdle at x, y frame f flip left flash hit scale 140
      draw ogreIdle at x, y frame f flip left alpha 80 tint "#efe6cc" scale 140
    }
    box x + 8, y - 4, 2, 9 color "#efe6cc"
    box x + 6, y - 6, 2, 4 color "#efe6cc"
    box x + 22, y - 4, 2, 9 color "#efe6cc"
    box x + 24, y - 6, 2, 4 color "#efe6cc"
  } else if k == 21 {
    // the Hollow Moon: a ghostly warden with a pale moon for a head
    let hover = (tick / 12) % 3
    draw fxGlow at x - 8, y - 38 tint "#bcd8ff" alpha 30 scale 100 glow
    drawMoon(x + 16, y - 6 - hover)
    box x + 8, y - 14 - hover, 4, 6 color "#8fa6c8"
    box x + 20, y - 14 - hover, 4, 6 color "#8fa6c8"
    if run {
      draw wardenRun at x, y frame f flip left flash hit alpha 70
      draw wardenRun at x, y frame f flip left alpha 55 tint "#bcd8ff"
    } else {
      draw wardenIdle at x, y frame f flip left flash hit alpha 70
      draw wardenIdle at x, y frame f flip left alpha 55 tint "#bcd8ff"
    }
  } else if k == 22 {
    // Warlord Zorn: a horned orc in black iron
    let rage = bossWind > 0 and tick % 6 < 3
    if bossWind > 0 {
      draw fxGlow at x - 16, y - 12 tint "#ff4d4d" alpha 30 + (30 - bossWind) * 2 scale 90 glow
    }
    if run {
      draw orcRun at x, y frame f flip left flash hit or rage size 2
      draw orcRun at x, y frame f flip left alpha 60 tint "#20182c" size 2
    } else {
      draw orcIdle at x, y frame f flip left flash hit size 2
      draw orcIdle at x, y frame f flip left alpha 60 tint "#20182c" size 2
    }
    box x + 6, y + 1, 3, 7 color "#cfc8b8"
    box x + 4, y - 3, 3, 5 color "#cfc8b8"
    box x + 23, y + 1, 3, 7 color "#cfc8b8"
    box x + 25, y - 3, 3, 5 color "#cfc8b8"
    box x + 11, y + 12, 3, 2 color "#ff4d4d"
    box x + 19, y + 12, 3, 2 color "#ff4d4d"
  } else if k == 23 {
    // the Cinder God: a spark that grew, a huge blue-white imp that fades while it jumps
    let see = 100
    if bossWind > 12 {
      see = (bossWind - 12) * 8
    } else if bossWind > 0 {
      see = (12 - bossWind) * 8
    }
    draw fxGlow at x - 24, y - 20 tint "#9bd3ff" alpha see / 3 scale 130 glow
    if run {
      draw impRun at x - 8, y - 12 frame f flip left flash hit alpha see size 3
      draw impRun at x - 8, y - 12 frame f flip left alpha see * 6 / 10 tint "#5fc8ff" size 3
    } else {
      draw impIdle at x - 8, y - 12 frame f flip left flash hit alpha see size 3
      draw impIdle at x - 8, y - 12 frame f flip left alpha see * 6 / 10 tint "#5fc8ff" size 3
    }
  } else if k == 24 {
    // a moon wisp bobs as it floats
    let bobY = (tick / 10 + n) % 3
    draw fxGlow at x - 24, y - 28 tint "#bcd8ff" alpha 14 scale 40 glow
    if run {
      draw angelRun at x, y - bobY frame f flip left flash hit
    } else {
      draw angelIdle at x, y - bobY frame f flip left flash hit
    }
  } else {
    if run {
      draw kingRun at x, y frame f flip left flash hit
    } else {
      draw kingIdle at x, y frame f flip left flash hit
    }
  }
}

// draws a weapon picture centred on (cx, cy), turned by ang degrees
fn drawWeapon(wid, cx, cy, ang) {
  let x = cx - wW[wid] / 2
  let y = cy - wH[wid] / 2
  if wid == 1 {
    draw rusty at x, y angle ang
  } else if wid == 2 {
    draw knightSword at x, y angle ang
  } else if wid == 3 {
    draw hammer at x, y angle ang
  } else if wid == 4 {
    draw goldSword at x, y angle ang
  } else if wid == 5 {
    draw staff at x, y angle ang
  } else if wid == 6 {
    // the Moonblade shines
    draw fxGlow at cx - 32, cy - 32 tint "#9bd3ff" alpha 14 scale 40 glow
    draw moonblade at x, y angle ang
  } else {
    // the Starfall Staff: a little star circles its tip
    draw fxGlow at cx - 32, cy - 32 tint "#c9a227" alpha 14 scale 36 glow
    draw starStaff at x, y angle ang
    let ox = cx + (tick / 3 % 9) - 4
    draw fxStar at ox - 16, cy - 16 - 10 tint "#fff4c2" angle tick * 8 scale 45 glow
  }
}

// draws a skin's body with its feet on (x + 8, y + 22)
fn drawBody(sk, x, y, f, run, left, see, white) {
  let top = y + 22 - skinTall[sk]
  if sk == 1 {
    if run {
      draw ladyRun at x, top frame f flip left alpha see flash white
    } else {
      draw ladyIdle at x, top frame f flip left alpha see flash white
    }
  } else if sk == 2 {
    if run {
      draw elfRun at x, top frame f flip left alpha see flash white
    } else {
      draw elfIdle at x, top frame f flip left alpha see flash white
    }
  } else if sk == 3 {
    if run {
      draw lizardRun at x, top frame f flip left alpha see flash white
    } else {
      draw lizardIdle at x, top frame f flip left alpha see flash white
    }
  } else if sk == 7 {
    draw fxGlow at x - 24, top - 22 tint "#7a3fb0" alpha see / 6 scale 60 glow
    draw necro at x, top frame f flip left alpha see flash white
  } else if sk == 4 {
    if run {
      draw sorcRun at x, top frame f flip left alpha see flash white
    } else {
      draw sorcIdle at x, top frame f flip left alpha see flash white
    }
    draw fxGlow at x - 24, top - 22 tint "#c77dff" alpha see / 5 scale 60 glow
  } else {
    if run {
      draw knightRun at x, top frame f flip left alpha see flash white
    } else {
      draw knightIdle at x, top frame f flip left alpha see flash white
    }
    if sk == 6 {
      // the Ember Knight: charred armour glowing from within
      if run {
        draw knightRun at x, top frame f flip left alpha see * 9 / 10 tint "#1e100c"
        draw knightRun at x, top frame f flip left alpha see / 4 + tick % 12 tint "#ff5a1f" glow
      } else {
        draw knightIdle at x, top frame f flip left alpha see * 9 / 10 tint "#1e100c"
        draw knightIdle at x, top frame f flip left alpha see / 4 + tick % 12 tint "#ff5a1f" glow
      }
      draw fxLight at x - 24, top - 21 tint "#ff6a1f" alpha see / 8 scale 70 glow
    }
    if sk == 5 {
      // the Celestial Knight: starlight armour
      if run {
        draw knightRun at x, top frame f flip left alpha see / 4 tint "#9bd3ff" glow
      } else {
        draw knightIdle at x, top frame f flip left alpha see / 4 tint "#9bd3ff" glow
      }
      draw fxLight at x - 24, top - 21 tint "#6fa8d6" alpha see / 8 scale 80 glow
    }
  }
}

fn drawHero() {
  let x = hx - 3
  let y = hy - 14
  let f = tick / 7
  let blink = hurt > 0 and tick % 6 < 3
  box hx, hy + 6, 10, 3 color "#00000055"
  // the Starfall Staff draws a turning rune circle under you
  if weapon == 7 and dying == 0 {
    draw fxCircle at hx + 5 - 32, hy + 6 - 32 tint "#c9a227" alpha 14 scale 40 angle tick * 2 glow
  }
  // Necromancers trail ghostly wisps
  if skin == 7 and moving and tick % 7 == 0 {
    effect(10, hx + 5 + random(-4, 4), hy + random(-6, 4), 20, "#9b6bd6", 30, 5, 0, 0)
    drift(0, -3)
  }
  if skin == 6 and moving and tick % 6 == 0 {
    burst(hx + 5 + random(-4, 4), hy - 4, 1, "#ff8a3d", 6)
  }
  if skin == 5 and moving and tick % 8 == 0 {
    effect(2, hx + 5 + random(-5, 5), hy + random(-12, 4), 18, "#e8f4ff", 60, 10, random(0, 90), 10)
  }
  if strT > 0 {
    draw fxLight at hx + 5 - 32, hy - 4 - 32 tint "#6bd36b" alpha 9 scale 60 glow
  }
  if goldT > 0 {
    draw fxLight at hx + 5 - 32, hy - 4 - 32 tint "#ffd23f" alpha 8 scale 55 glow
  }
  if dash > 0 {
    drawBody(skin, x - faceX * 8, y - faceY * 8, f, true, lookLeft, 35, false)
    drawBody(skin, x - faceX * 16, y - faceY * 16, f, true, lookLeft, 15, false)
  }
  if faceY < 0 {
    drawHeld()
  }
  if dying > 0 {
    drawBody(skin, x, y, 0, false, lookLeft, dying + 30, false)
  } else if blink {
    drawBody(skin, x, y, f, moving, lookLeft, 70, true)
  } else {
    drawBody(skin, x, y, f, moving, lookLeft, 100, false)
  }
  if faceY >= 0 {
    drawHeld()
  }
}

fn drawHeld() {
  if dying > 0 {
    return 0
  }
  let cx = hx + 5
  let cy = hy - 4
  let half = wH[weapon] / 2
  if swing == 0 {
    // resting at the side
    if lookLeft {
      drawWeapon(weapon, cx - 8, cy - half + 7, -20)
    } else {
      drawWeapon(weapon, cx + 8, cy - half + 7, 20)
    }
    return 0
  }
  let base = 180
  if faceX > 0 {
    base = 90
  } else if faceX < 0 {
    base = 270
  } else if faceY < 0 {
    base = 0
  }
  let total = wLen[weapon]
  let sweep = (total - swing) * 140 / total - 70
  if weapon == 5 {
    sweep = 0
  }
  let reach = half + 2
  let ox = faceX * reach
  let oy = faceY * reach
  if faceX == 0 and faceY == 0 {
    oy = reach
  }
  if weapon == 6 {
    let ghostX = cx + ox - 6
    let ghostY = cy + oy - 15
    draw moonblade at ghostX, ghostY angle base + sweep - 25 tint "#9bd3ff" alpha 22
    draw moonblade at ghostX, ghostY angle base + sweep - 50 tint "#9bd3ff" alpha 10
  }
  drawWeapon(weapon, cx + ox, cy + oy, base + sweep)
}

// a rug on the floor that marks out one part of the camp
fn rug(tx, ty, w, h, color) {
  box tx * 16 - 3, ty * 16 - 3, w * 16 + 6, h * 16 + 6 color "#00000040"
  box tx * 16 - 2, ty * 16 - 2, w * 16 + 4, h * 16 + 4 color color
  box tx * 16, ty * 16, w * 16, h * 16 color "#00000030"
}

// a cobbled path over the cells from (x1, y1) to (x2, y2)
fn path(x1, y1, x2, y2) {
  for ty from y1 to y2 {
    for tx from x1 to x2 {
      let x = tx * 16
      let y = ty * 16
      box x, y, 16, 16 color "#4a3e3a"
      box x + 1, y + 1, 6, 6 color "#64554e"
      box x + 9, y + 1, 6, 6 color "#5b4d47"
      box x + 1, y + 9, 6, 6 color "#5b4d47"
      box x + 9, y + 9, 6, 6 color "#64554e"
    }
  }
}

// the camp's floor: paths, rugs and signs (drawn under everyone)
fn drawCampFloor() {
  // paths from the start to every corner of the camp
  path(17, 8, 19, 15)
  path(10, 8, 23, 9)
  path(20, 14, 22, 15)
  // the ladder sits on top of the path
  draw fxLight at ladX * 16 + 8 - 32, ladY * 16 + 8 - 32 tint "#9bd3ff" alpha 18 scale 90 glow
  draw ladder at ladX * 16, ladY * 16
  // a rug for each part of the camp
  rug(2, 5, 8, 4, "#3b2a24")
  rug(13, 3, 11, 5, "#2c2a40")
  rug(24, 4, 11, 11, "#24303a")
  rug(2, 9, 8, 7, "#3a2530")
  rug(8, 18, 21, 5, "#2a2a30")
  write "CURIOS SHOP" at 18 * 16 + 8, 18 * 16 + 4 centered color "#c9c3d6"
  write "CURIOS" at 18 * 16 + 8, 15 * 16 + 8 centered color "#9a8fb0"
  write "SUPPLIES" at 6 * 16, 5 * 16 + 4 centered color "#c9a27e"
  write "VAULT" at 18 * 16 + 8, 3 * 16 + 4 centered color "#ffd23f"
  write "WARDROBE" at 29 * 16 + 8, 4 * 16 + 4 centered color "#9bd3ff"
  write "ARMOURY" at 6 * 16, 9 * 16 + 4 centered color "#c9a27e"
  write "WAY DOWN" at 22 * 16 + 8, 13 * 16 + 4 centered color "#9a8fb0"
  // the campfire
  let fx0 = 14 * 16 + 8
  let fy0 = 12 * 16 + 8
  draw fxLight at fx0 - 32, fy0 - 32 tint "#ff8a3d" alpha 22 + tick / 5 % 5 scale 170 glow
  box fx0 - 7, fy0 + 2, 14, 3 color "#5a3a22"
  box fx0 - 5, fy0 - 1, 3, 7 color "#6e4a2c"
  box fx0 + 2, fy0 - 1, 3, 7 color "#6e4a2c"
  draw fxFire at fx0 - 16, fy0 - 20 tint "#ff8a3d" alpha 85 scale 55 angle tick * 3 % 20 - 10 glow
  draw fxFlame at fx0 - 16, fy0 - 22 tint "#ffd23f" alpha 70 scale 45 glow
  if tick % 9 == 0 {
    burst(fx0 + random(-3, 3), fy0 - 8, 1, "#ffb34a", 6)
  }
}


// ---------- little pictures for the new items ----------
fn gearIcon(item) {
  if item == 11 {
    return 3
  }
  if item == 12 {
    return 4
  }
  if item == 13 {
    return 5
  }
  return item
}

fn drawBottle(x, y, col, sf) {
  box x + 6, y + 1, 4, 3 color "#c9c3d6" + sf
  box x + 5, y + 4, 6, 1 color "#c9c3d6" + sf
  box x + 4, y + 5, 8, 9 color col + sf
  box x + 5, y + 6, 2, 5 color "#ffffff" + "55"
  box x + 4, y + 14, 8, 1 color "#00000066"
}

fn drawIcon(it, x, y, dim) {
  let sf = ""
  let bright = 100
  if dim {
    sf = "44"
    bright = 35
  }
  if it == 0 {
    draw flask at x, y alpha bright
  } else if it == 1 {
    draw flaskG at x, y alpha bright
  } else if it == 2 {
    draw flaskY at x, y alpha bright
  } else if it == 3 {
    drawBottle(x, y, "#4fd1ff", sf)
  } else if it == 4 {
    drawBottle(x, y, "#b57bff", sf)
  } else if it == 5 {
    box x + 3, y + 7, 11, 7 color "#1a1a22" + sf
    box x + 5, y + 5, 7, 11 color "#1a1a22" + sf
    box x + 5, y + 7, 2, 2 color "#8a8aa0" + sf
    box x + 10, y + 3, 2, 3 color "#aa8d7a" + sf
    if tick / 5 % 2 == 0 {
      box x + 10, y + 1, 3, 2 color "#ffd23f" + sf
    } else {
      box x + 11, y + 1, 2, 2 color "#ff6a1f" + sf
    }
  } else if it >= 17 {
    let bc = enchCol[it - 17]
    box x + 3, y + 2, 11, 13 color "#2a2036" + sf
    box x + 4, y + 3, 9, 11 color bc + sf
    box x + 3, y + 2, 2, 13 color "#00000066"
    box x + 6, y + 5, 5, 1 color "#ffffff" + "99"
    box x + 6, y + 8, 5, 1 color "#ffffff" + "99"
    box x + 6, y + 11, 3, 1 color "#ffffff" + "99"
  } else if it == 14 {
    box x + 2, y + 8, 12, 5 color "#8a8f99" + sf
    box x + 2, y + 8, 12, 1 color "#c0c5cf" + sf
    box x + 3, y + 12, 10, 1 color "#5a5f69" + sf
    box x + 11, y + 3, 1, 4 color "#ffd23f" + sf
    box x + 10, y + 4, 3, 1 color "#ffd23f" + sf
  } else if it == 15 {
    box x + 5, y + 3, 3, 3 color "#4ade80" + sf
    box x + 8, y + 3, 3, 3 color "#4ade80" + sf
    box x + 5, y + 6, 3, 3 color "#4ade80" + sf
    box x + 8, y + 6, 3, 3 color "#4ade80" + sf
    box x + 7, y + 5, 2, 2 color "#bbf7d0" + sf
    box x + 7, y + 9, 2, 5 color "#2f8f4a" + sf
  } else {
    box x + 5, y + 3, 6, 3 color "#f5efe0" + sf
    box x + 6, y + 6, 4, 4 color "#f5efe0" + sf
    box x + 7, y + 10, 2, 3 color "#d8cfb8" + sf
    box x + 7, y + 13, 2, 2 color "#e11d48" + sf
  }
}

// ---------- bombs ----------
fn placeBomb() {
  add hx + 5 + faceX * 10 to bmx
  add hy + 2 + faceY * 8 to bmy
  add 70 to bmt
  sound sndNope volume 40
}

fn breakWall(i) {
  grid[i] = "."
  look[i] = 1
  edge[i] = 0
  let bxp = (i % MW) * 16 + 8
  let byp = (i / MW) * 16 + 8
  burst(bxp, byp, 22, "#aa8d7a", 26)
  burst(bxp, byp, 10, "#6b5b55", 18)
  repeat 4 {
    puff(bxp + random(-6, 6), byp + random(-6, 6), "#8a7c86")
  }
  sound sndSlam volume 60
  shake = max(shake, 10)
}

fn explodeBomb(bxp, byp) {
  stats[3] += 1
  sound sndSlam
  shake = 16
  burst(bxp, byp, 40, "#ff8a3d", 40)
  burst(bxp, byp, 24, "#ffd23f", 30)
  effect(14, bxp, byp, 30, "#ffb34a", 60, 240, 0, 0)
  effect(16, bxp, byp, 24, "#fff4c2", 60, 160, 0, 4)
  let e2 = 0
  while e2 < length(ex) {
    let k = ekind[e2]
    let far = abs(ex[e2] + enemyW(k) / 2 - bxp) + abs(ey[e2] + enemyH(k) / 2 - byp)
    if far < 56 {
      ehp[e2] -= 8
      ehurt[e2] = 12
      if isBoss(k) {
        bossAwake = true
      }
      burst(ex[e2] + enemyW(k) / 2, ey[e2] + enemyH(k) / 2, 6, "#ff8a3d", 14)
    }
    e2 += 1
  }
  // cracked walls
  let i = 0
  while i < length(grid) {
    if grid[i] == "%" {
      let dx = abs((i % MW) * 16 + 8 - bxp)
      let dy = abs((i / MW) * 16 + 8 - byp)
      if dx + dy < 60 {
        breakWall(i)
        if not contains(secFound, floor) {
          showToast("A hidden room!")
        }
      }
    }
    i += 1
  }
}

fn updateBombs() {
  let n = 0
  while n < length(bmt) {
    bmt[n] -= 1
    if bmt[n] <= 0 {
      let ox = bmx[n]
      let oy = bmy[n]
      remove bmx[n]
      remove bmy[n]
      remove bmt[n]
      explodeBomb(ox, oy)
    } else {
      n += 1
    }
  }
}

fn drawBombs() {
  let n = 0
  while n < length(bmt) {
    let x = bmx[n]
    let y = bmy[n]
    box x - 4, y + 4, 9, 2 color "#00000055"
    box x - 4, y - 2, 9, 7 color "#1a1a22"
    box x - 3, y - 4, 7, 11 color "#1a1a22"
    box x - 2, y - 2, 2, 2 color "#8a8aa0"
    box x + 2, y - 7, 2, 3 color "#aa8d7a"
    if bmt[n] / 4 % 2 == 0 {
      box x + 2, y - 10, 3, 3 color "#ffd23f"
    } else {
      box x + 3, y - 9, 2, 2 color "#ff6a1f"
    }
    if bmt[n] < 20 and bmt[n] / 3 % 2 == 0 {
      box x - 4, y - 2, 9, 7 color "#ffffff88"
    }
    n += 1
  }
}

// ---------- secret rooms: one cracked wall per floor, hiding a chest ----------
let secFound = []

fn placeSecret() {
  secX = -1
  secY = -1
  if floor == 0 or contains(secFound, floor) {
    return 0
  }
  let cands = []
  let ty = 3
  while ty < MH - 2 {
    let tx = 2
    while tx < MW - 2 {
      let i = ty * MW + tx
      if grid[i] == "#" and grid[i + MW] == "." and grid[i - MW] == "#" and grid[i - 2 * MW] == "#" and grid[i - 1] == "#" and grid[i + 1] == "#" and grid[i - MW - 1] == "#" and grid[i - MW + 1] == "#" {
        if grid[i + MW - 1] != "^" and grid[i + MW + 1] != "^" and grid[i + MW] != "^" {
          add i to cands
        }
      }
      tx += 1
    }
    ty += 1
  }
  if length(cands) == 0 {
    return 0
  }
  let pick = cands[(floor * 37 + 11) % length(cands)]
  grid[pick] = "%"
  grid[pick - MW] = "C"
  secX = pick % MW
  secY = pick / MW
  add secX to chx
  add secY - 1 to chy
  add 4 to chWhat
  add 0 to chOpen
}

// ---------- achievements ----------
fn achOwned() {
  return owned
}

fn achTest(a) {
  if a == 0 {
    return stats[0] >= 1
  } else if a == 1 {
    return stats[0] >= 100
  } else if a == 2 {
    return stats[6] >= 1
  } else if a == 3 {
    return won == 1
  } else if a == 4 {
    return trueEnd == 1
  } else if a == 5 {
    return deepest >= 11
  } else if a == 6 {
    return stats[2] >= 1000
  } else if a == 7 {
    return stats[3] >= 10
  } else if a == 8 {
    return stats[4] >= 1
  } else if a == 9 {
    return stats[4] >= 5
  } else if a == 10 {
    return length(owned) >= 5
  } else if a == 11 {
    return length(skinsOwned) >= 4
  } else if a == 12 {
    return stats[7] >= 20
  } else if a == 13 {
    return smithLv >= 3
  } else if a == 14 {
    return hasCharm == 1 and hasFang == 1
  } else if a == 15 {
    return stats[1] >= 10
  }
  let q = 0
  while q < length(qState) {
    if qState[q] != 3 {
      return false
    }
    q += 1
  }
  return true
}

fn checkAch() {
  let a = 0
  while a < length(achName) {
    if ach[a] == 0 and achTest(a) {
      ach[a] = 1
      showToast("ACHIEVEMENT: " + achName[a])
      sound jingleTreasure volume 70
      save "ach", ach
    }
    a += 1
  }
}

fn achCount() {
  let c = 0
  for each v in ach {
    c += v
  }
  return c
}

fn drawAch() {
  box 0, 0, 320, 180 color "#0b0912"
  write "ACHIEVEMENTS  " + achCount() + "/" + length(achName) at 160, 3 centered color "#e8f4ff" shadow
  let a = 0
  while a < length(achName) {
    let y = 15 + a * 9
    if a % 2 == 0 {
      box 8, y - 1, 304, 9 color "#15101e"
    }
    if ach[a] == 1 {
      box 8, y - 1, 2, 9 color "#ffd23f"
      write achName[a] at 14 + 0, y color "#ffd23f"
      write achInfo[a] at 124, y color "#c9c3d6"
    } else {
      write achName[a] at 14, y color "#8a7f9a"
      write achInfo[a] at 124, y color "#6a6280"
    }
    a += 1
  }
  if touch {
    write "SWORD: back" at 160, 170 centered color "#9a8fb0"
  } else {
    write "X / ESC: back" at 160, 170 centered color "#9a8fb0"
  }
}

fn drawStats() {
  box 0, 0, 320, 180 color "#0b0912"
  write "STATS" at 160, 8 centered color "#e8f4ff" shadow
  let names = ["Monsters defeated", "Times fallen", "Gold earned", "Bombs used", "Secret rooms found", "Chests opened", "Bosses beaten", "Potions drunk", "Deepest floor", "Achievements", "This run"]
  let vals = [stats[0], stats[1], stats[2], stats[3], stats[4], stats[5], stats[6], stats[7], deepest, achCount() + "/" + length(achName), clock(playTime)]
  let r = 0
  while r < length(names) {
    let y = 24 + r * 11
    box 60, y - 1, 200, 10 color "#1c1626"
    write names[r] at 66, y color "#c9c3d6"
    write "" + vals[r] at 254 - length("" + vals[r]) * 6, y color "#ffd23f"
    r += 1
  }
  if bestTime > 0 {
    write "Best clear: " + clock(bestTime) at 160, 150 centered color "#7ee787"
  }
  if touch {
    write "SWORD: back" at 160, 166 centered color "#9a8fb0"
  } else {
    write "X / ESC: back" at 160, 166 centered color "#9a8fb0"
  }
}

fn drawShop() {
  // the mage, behind the vault
  box mageX * 16 + 2, mageY * 16 + 12, 12, 3 color "#00000055"
  draw mage at mageX * 16, mageY * 16 - 6 frame tick / 9 flipped
  if vaultOpen() {
    write "*" at mageX * 16 + 8, mageY * 16 - 14 - (tick / 14) % 2 centered color "#b57bff" shadow
  }
  let n = 0
  let near = -1
  while n < length(shx) {
    let x = shx[n] * 16
    let y = shy[n] * 16
    let item = shItem[n]
    let bob = (tick / 16 + n) % 2
    let sold = (item >= 17 and ench[item - 17] >= 3) or (item >= 3 and item <= 8 and contains(owned, item - 1)) or (item == 14 and smithLv >= 3) or (item == 15 and hasCharm == 1) or (item == 16 and hasFang == 1)
    // a stone pedestal (the vault's have a gold trim)
    box x + 1, y + 6, 14, 10 color "#6b5b55"
    let locked = ((item == 7 or item == 8) or item >= 17) and not vaultOpen()
    if item == 7 or item == 8 {
      box x + 1, y + 6, 14, 2 color "#c9a227"
      box x + 1, y + 15, 14, 1 color "#c9a227"
      if not sold and not locked {
        let beam = "#9bd3ff"
        if item == 8 {
          beam = "#ffd23f"
        }
        draw fxLight at x + 8 - 32, y - 4 - 32 tint beam alpha 16 + tick / 6 % 6 scale 70 glow
      }
    } else {
      box x + 1, y + 6, 14, 2 color "#aa8d7a"
    }
    box x + 3, y + 16, 10, 2 color "#00000055"
    if locked {
      // a padlock
      box x + 5, y - 6, 6, 5 color "#8a7a6a"
      box x + 6, y - 5, 4, 4 color "#100c14"
      box x + 3, y - 2, 10, 8 color "#c9a227"
      box x + 7, y + 1, 2, 3 color "#5a4a2a"
    } else if item == 1 {
      draw flask at x, y - 8 - bob
    } else if item == 2 {
      draw heart at x, y - 8 - bob
    } else if item == 9 {
      draw flaskG at x, y - 8 - bob
    } else if item == 10 {
      draw flaskY at x, y - 8 - bob
    } else if item >= 11 {
      drawIcon(gearIcon(item), x, y - 8 - bob, false)
    } else {
      drawWeapon(item - 1, x + 8, y - 4 - bob, 0)
    }
    if locked {
      write "FLOOR " + vaultFloor at x + 8, y + 20 centered color "#8a7a6a" shadow
    } else if sold {
      box x + 6, y + 21, 4, 4 color "#7ee787"
    } else if item >= 17 {
      write "L" + (ench[item - 17] + 1) + " " + enchCost(item - 17) at x + 8, y + 20 centered color "#ffd23f" shadow
    } else {
      write "" + shopCost[item] at x + 8, y + 20 centered color "#ffd23f" shadow
    }
    if abs(x + 8 - (hx + 5)) < 14 and abs(y + 8 - (hy + 4)) < 24 {
      near = item
    }
    n += 1
  }
  shopNear = near
  // the wardrobe
  let near2 = -1
  n = 0
  while n < length(skx) {
    let x = skx[n] * 16
    let y = sky[n] * 16
    let sk = skIdx[n]
    box x - 1, y + 10, 18, 6 color "#3a2f3a"
    box x - 1, y + 10, 18, 1 color "#aa8d7a"
    if sk == skin {
      box x - 1, y + 15, 18, 1 color "#7ee787"
    }
    let veiled = (sk == 5 or sk == 7) and not vaultOpen() and not contains(skinsOwned, sk)
    if veiled {
      draw knightIdle at x, y - 10 tint "#0b0912" alpha 85
    } else {
      drawBody(sk, x, y - 10, tick / 9 + n, false, false, 100, false)
    }
    if veiled {
      write "???" at x + 8, y + 18 centered color "#8a7a6a" shadow
    } else if sk == skin {
      write "WORN" at x + 8, y + 18 centered color "#7ee787" shadow
    } else if contains(skinsOwned, sk) {
      box x + 6, y + 19, 4, 4 color "#7ee787"
    } else {
      write "" + skinCost[sk] at x + 8, y + 18 centered color "#ffd23f" shadow
    }
    if abs(x + 8 - (hx + 5)) < 14 and abs(y + 8 - (hy + 4)) < 24 {
      near2 = sk
    }
    n += 1
  }
  skinNear = near2
  if questsOpen() {
    drawNpcs()
  }
}

fn drawNpcs() {
  let n = 0
  while n < npcCount() {
    let x = npcX[n] * 16
    let y = npcY[n] * 16
    box x + 2, y + 12, 12, 3 color "#00000055"
    // they face the fire
    let faceFire = npcX[n] > 14
    if npcSkin[n] == 99 {
      draw skelIdle at x, y - 4 frame tick / 9 + n * 3 flip faceFire
    } else {
      drawBody(npcSkin[n], x, y - 10, tick / 9 + n * 3, false, faceFire, 100, false)
    }
    write npcName[n] at x + 8, y + 20 centered color "#c9c3d6" shadow
    // a mark over their heads: ! has work, ! in green is ready to hand in
    let q = npcQuest(n)
    if q == 6 and deepest < 7 {
      q = -1
    }
    if q >= 0 and (qState[q] == 0 or qState[q] == 2) {
      let col = "#ffd23f"
      if qState[q] == 2 {
        col = "#7ee787"
      }
      write "!" at x + 8, y - 24 - (tick / 12) % 2 centered color col shadow
    }
    n += 1
  }
}

fn drawShopInfo() {
  // on phones the panel moves to the top, away from the buttons
  let oy = 0
  if touch {
    oy = -108
  }
  if (skinNear == 5 or skinNear == 7) and not vaultOpen() and not contains(skinsOwned, skinNear) and length(msgs) == 0 {
    box 34, 144 + oy, 282, 28 color "#0b0912"
    box 34, 144 + oy, 282, 1 color "#6b5b55"
    write "??? - sealed" at 175, 149 + oy centered color "#8a7a6a"
    write "Reach floor " + vaultFloor + " to reveal it." at 175, 160 + oy centered color "#c9c3d6"
    return 0
  }
  if skinNear >= 0 and length(msgs) == 0 {
    box 34, 144 + oy, 282, 28 color "#0b0912"
    box 34, 144 + oy, 282, 1 color "#6b5b55"
    let what = skinName[skinNear] + " - " + skinCost[skinNear] + " gold   (X to buy)"
    if skinNear == 6 {
      what = "Ember Knight - secret   (X to wear)"
    }
    if skinNear == skin {
      what = skinName[skinNear] + " - you're wearing it"
    } else if contains(skinsOwned, skinNear) {
      what = skinName[skinNear] + " - yours   (X to wear)"
    }
    write what at 175, 149 + oy centered color "#ffd23f"
    write skinInfo[skinNear] at 175, 160 + oy centered color "#c9c3d6"
    return 0
  }
  if shopNear < 0 or length(msgs) > 0 {
    return 0
  }
  box 34, 144 + oy, 282, 28 color "#0b0912"
  box 34, 144 + oy, 282, 1 color "#6b5b55"
  let info = "Restores 2 hearts."
  if (shopNear == 7 or shopNear == 8) and not vaultOpen() {
    write "Sealed treasure" at 175, 149 + oy centered color "#8a7a6a"
    write "The vault opens once you reach floor " + vaultFloor + "." at 175, 160 + oy centered color "#c9c3d6"
    return 0
  }
  if shopNear >= 3 and shopNear <= 8 and contains(owned, shopNear - 1) {
    write shopName[shopNear] + " - yours   (C to switch)" at 175, 149 + oy centered color "#7ee787"
    write wInfo[shopNear - 1] at 175, 160 + oy centered color "#c9c3d6"
    return 0
  }
  if shopNear >= 17 and not vaultOpen() {
    write "Sealed altar" at 175, 149 + oy centered color "#8a7a6a"
    write "It wakes once you reach floor " + vaultFloor + "." at 175, 160 + oy centered color "#c9c3d6"
    return 0
  }
  if shopNear >= 17 and ench[shopNear - 17] >= 3 {
    write shopName[shopNear] + " - level 3 (max)" at 175, 149 + oy centered color "#7ee787"
    write enchInfo[shopNear - 17] at 175, 160 + oy centered color "#c9c3d6"
    return 0
  }
  if (shopNear == 14 and smithLv >= 3) or (shopNear == 15 and hasCharm == 1) or (shopNear == 16 and hasFang == 1) {
    write shopName[shopNear] + " - yours" at 175, 149 + oy centered color "#7ee787"
    write gearInfo[shopNear - 14] at 175, 160 + oy centered color "#c9c3d6"
    return 0
  }
  if shopNear == 2 {
    info = "One more heart, for good."
  } else if shopNear >= 17 {
    info = enchInfo[shopNear - 17]
  } else if shopNear >= 14 {
    info = gearInfo[shopNear - 14]
    if shopNear == 14 {
      info = info + " (" + smithLv + "/3)"
    }
  } else if shopNear >= 9 {
    info = invInfo[potionSlot(shopNear)]
  } else if shopNear == 1 {
    info = "Restores 2 hearts. Drink it from your pack (B)."
  } else if shopNear >= 3 {
    info = wInfo[shopNear - 1]
  }
  if shopNear >= 17 {
    write shopName[shopNear] + " Lv" + (ench[shopNear - 17] + 1) + " - " + enchCost(shopNear - 17) + " gold   (X)" at 175, 149 + oy centered color "#ffd23f"
  } else {
    write shopName[shopNear] + " - " + shopCost[shopNear] + " gold   (X to buy)" at 175, 149 + oy centered color "#ffd23f"
  }
  write info at 175, 160 + oy centered color "#c9c3d6"
}

fn drawWorld() {
  paint "#100c14"
  let sx = 0
  let sy = 0
  if shake > 0 and setShake > 0 {
    sx = random(-2, 2) * min(shake, 6) / 3
    sy = random(-2, 2) * min(shake, 6) / 3
    if setShake == 1 {
      sx = sx / 2
      sy = sy / 2
    }
  }
  camera camX + sx, camY + sy
  let t0x = camX / 16 - 1
  let t0y = camY / 16 - 1
  for ty from t0y to t0y + 13 {
    for tx from t0x to t0x + 22 {
      drawCell(tx, ty)
    }
  }
  drawLights()
  if floor == 0 {
    drawCampFloor()
    drawShop()
  }
  drawBombs()
  // the way down shimmers once the boss is gone
  if bossDead and floor > 0 {
    let lx = ladX * 16 + 8
    let ly = ladY * 16 + 8
    draw fxLight at lx - 32, ly - 32 tint "#9bd3ff" alpha 45 scale 120 glow
    draw fxVortex at lx - 32, ly - 32 tint "#9bd3ff" alpha 55 scale 60 angle tick * 4 glow
  }
  let n = 0
  while n < length(drx) {
    if drOpen[n] {
      draw doorOpen at drx[n] * 16, dry[n] * 16 - 16
    } else {
      draw doorShut at drx[n] * 16, dry[n] * 16 - 16
    }
    n += 1
  }
  n = 0
  while n < length(chx) {
    draw chestFull at chx[n] * 16, chy[n] * 16 frame min(2, chOpen[n] / 4)
    n += 1
  }
  n = 0
  while n < length(ix) {
    let bob = (tick / 10 + n) % 4
    if bob == 3 {
      bob = 1
    }
    if ikind[n] == 1 {
      draw coin at ix[n] - 4, iy[n] - 6 - bob frame tick / 6 + n
    } else if ikind[n] == 3 {
      draw fxLight at ix[n] - 32, iy[n] - 32 tint "#9bd3ff" alpha 40 scale 55 glow
      draw fxStar at ix[n] - 16, iy[n] - 16 - bob tint "#e8f4ff" angle tick * 4 scale 60 glow
    } else {
      draw flask at ix[n] - 8, iy[n] - 12 - bob
    }
    n += 1
  }
  // monsters behind the hero, the hero, then monsters in front
  n = 0
  while n < length(ex) {
    if ey[n] + enemyH(ekind[n]) <= hy + 8 {
      drawEnemy(n)
    }
    n += 1
  }
  drawUnderlings()
  drawHero()
  n = 0
  while n < length(ex) {
    if ey[n] + enemyH(ekind[n]) > hy + 8 {
      drawEnemy(n)
    }
    n += 1
  }
  // fireballs and flames
  n = 0
  while n < length(bx) {
    let px = bx[n] / 10
    let py = by[n] / 10
    draw fxGlow at px - 32, py - 32 tint bcol[n] alpha 55 scale 35 glow
    box px - 3, py - 3, 6, 6 color bcol[n]
    box px - 1, py - 2, 3, 3 color "#fff4d0"
    n += 1
  }
  n = 0
  while n < length(fx) {
    let px = fx[n] / 10
    let py = fy[n] / 10
    let fangDeg = 0
    if fvx[n] > 0 {
      fangDeg = 90
    } else if fvx[n] < 0 {
      fangDeg = 270
    } else if fvy[n] > 0 {
      fangDeg = 180
    }
    if fkind[n] == 1 {
      draw fxGlow at px - 32, py - 32 tint "#ff8a3d" alpha 60 scale 45 glow
      draw fxFlame at px - 16, py - 16 tint "#ffb34a" angle fangDeg + 180 scale 80 glow
    } else if fkind[n] == 4 {
      // a comet star: twinkles, then fades out
      let starA = min(100, flife[n] * 4)
      draw fxGlow at px - 32, py - 32 tint "#6fa8d6" alpha starA / 3 scale 30 glow
      draw fxStar at px - 16, py - 16 tint "#e8f4ff" angle tick * 8 alpha starA scale 30 + flife[n] glow
    } else if fkind[n] == 2 {
      draw fxGlow at px - 32, py - 32 tint "#ffd23f" alpha 45 scale 25 glow
      draw fxStar at px - 16, py - 16 tint "#fff4c2" angle tick * 12 scale 60 glow
    } else {
      draw fxSlash at px - 16, py - 16 tint "#9bd3ff" angle fhitAngle(n) alpha 70 scale 170 glow
    }
    n += 1
  }
  n = 0
  while n < length(qx) {
    let size = 2
    if qlife[n] < 8 {
      size = 1
    }
    box qx[n] / 10, qy[n] / 10, size, size color qcol[n]
    n += 1
  }
  // falling stars
  n = 0
  while n < length(orbX) {
    let px = orbX[n] / 10
    let py = orbY[n] / 10
    draw fxLight at px - 32, py - 32 tint "#c9a227" alpha 30 scale 70 glow
    draw fxStar at px - 16, py - 16 tint "#fff4c2" angle tick * 9 scale 100 glow
    n += 1
  }
  drawEffects()
  camera 0, 0
}

fn drawVignette() {
  if floorMood[floor] != "" {
    box 0, 0, 320, 180 color floorMood[floor]
  }
  let k = 0
  while k < 6 {
    box 0, k * 3, 320, 3 color "#0000001a"
    box 0, 177 - k * 3, 320, 3 color "#0000001a"
    box k * 3, 0, 3, 180 color "#0000001a"
    box 317 - k * 3, 0, 3, 180 color "#0000001a"
    k += 1
  }
}

fn drawKey(x, y) {
  box x, y + 2, 5, 5 color "#ffd23f"
  box x + 1, y + 3, 3, 3 color "#100c14"
  box x + 5, y + 4, 7, 2 color "#ffd23f"
  box x + 9, y + 6, 2, 2 color "#ffd23f"
  box x + 11, y + 6, 1, 2 color "#ffd23f"
}

fn bossTitle() {
  if bossKind == 14 {
    return "GRUKK THE GATEKEEPER"
  }
  if bossKind == 15 {
    return "THE ROTTING WARDEN"
  }
  if bossKind == 16 {
    return "VAEL, THE NECROMANCER LORD"
  }
  if bossKind == 17 {
    return "WARLORD KRAG"
  }
  if bossKind == 18 {
    return "IGNIS, THE CHORT QUEEN"
  }
  if bossKind == 19 {
    return "ARCHIVIST MORWEN"
  }
  if bossKind == 20 {
    return "THE BONE COLOSSUS"
  }
  if bossKind == 21 {
    return "THE HOLLOW MOON"
  }
  if bossKind == 22 {
    return "WARLORD ZORN"
  }
  if bossKind == 23 {
    return "THE CINDER GOD"
  }
  return "THE EMBER KING"
}

// =====================================================================
//  Codes: press C on the title screen. Each code works once.
// =====================================================================
let typingCode = false

fn enterCode() {
  if typingCode {
    return 0
  }
  typingCode = true
  let code = upper(ask "Enter a code:")
  typingCode = false
  if code == "" {
    return 0
  }
  if code == "EXPORT" {
    # __mwBox('export');
    return 0
  }
  if code == "IMPORT" {
    # __mwBox('import');
    return 0
  }
  if contains(codesUsed, code) {
    sound sndNope
    say("You've already used that code.")
    return 0
  }
  let ok = true
  if code == "NECROMANCER" {
    unlockSkin(7)
    say("CODE ACCEPTED: NECROMANCER!\nYou're wearing it now. Press V in the\ndungeon to raise the dead.")
  } else if code == "STARLIGHT" {
    unlockSkin(5)
    say("CODE ACCEPTED: CELESTIAL KNIGHT!\nThe stars are yours.")
  } else if code == "EMBERS" {
    unlockSkin(6)
    say("CODE ACCEPTED: EMBER KNIGHT!\nWho needs a campfire anyway?")
  } else if code == "GOLDRUSH" {
    bank += 500
    save "bank", bank
    if length(save0) > 0 {
      save0[2] = save0[2] + 500
      save "moonwell", save0
    }
    say("CODE ACCEPTED: +500 GOLD!\nIt'll be in your purse on your journey.")
  } else if code == "LASTKNIGHT" {
    won = 1
    save "won", 1
    say("CODE ACCEPTED: THE LAST KNIGHT!\nThree travellers wait at your Rest Camp.")
  } else if code == "DEEPDIVE" {
    deepest = max(deepest, vaultFloor)
    save "deepest", deepest
    say("CODE ACCEPTED: THE VAULT IS OPEN!\nThe mage's treasures await at the camp.")
  } else {
    ok = false
    sound sndNope
    say("That code doesn't seem to work.")
  }
  if ok {
    add code to codesUsed
    save "codes", codesUsed
    sound jingleTreasure
    whiteT = 4
  }
}

fn unlockSkin(n) {
  if not contains(skinsOwned, n) {
    add n to skinsOwned
    save "skins", skinsOwned
  }
  skin = n
  save "skin", skin
}

fn drawSummonHud() {
  if floor == 0 or skin != 7 {
    return 0
  }
  let sy = 122
  if touch {
    sy = 40
  }
  box 4, sy, 26, 26 color "#05040a99"
  box 4, sy, 26, 1 color "#46607a"
  if summonCool > 0 {
    draw skelIdle at 9, sy + 4 alpha 35 tint "#5f8fc0"
    let fill = summonCool * 25 / summonWait
    box 4, sy + 26 - fill, 26, fill color "#05040a88"
  } else {
    draw skelIdle at 9, sy + 4 frame tick / 9
    draw skelIdle at 9, sy + 4 frame tick / 9 alpha 30 tint "#9bd3ff" glow
  }
  write "V" at 25, sy + 18 color "#9a8fb0"
}

// the potions you carry, with a bar for the ones working right now
fn drawPackHud() {
  let x = 4
  let sl = 0
  while sl < 6 {
    let active = (sl == 1 and strT > 0) or (sl == 2 and goldT > 0) or (sl == 3 and swiftT > 0) or (sl == 4 and wardN > 0)
    if inv[sl] > 0 or active {
      drawIcon(sl, x, 18, false)
      if inv[sl] > 0 {
        write "x" + inv[sl] at x + 15, 26 shadow
      }
      if active {
        let left = strT * 16 / 3600
        let col = "#7be07b"
        if sl == 2 {
          left = goldT * 16 / 3600
          col = "#ffd23f"
        } else if sl == 3 {
          left = swiftT * 16 / 1800
          col = "#4fd1ff"
        } else if sl == 4 {
          left = wardN * 16 / 3
          col = "#b57bff"
        }
        box x, 34, 16, 2 color "#00000099"
        box x, 34, left, 2 color col
      }
      x += 30
      if inv[sl] >= 10 {
        x += 6
      }
    }
    sl += 1
  }
}

fn drawHud() {
  drawSummonHud()
  drawPackHud()
  // the quest you're on, and a note when one is ready
  if floor > 0 and questsOpen() and not (touch and bossAwake and not bossDead) {
    let q = 0
    while q < length(qName) {
      if qState[q] == 1 {
        let line = qName[q] + " " + qProg[q] + "/" + qNeed[q]
        write line at 316 - length(line) * 6, 30 color "#ffd23f" shadow
        q = 99
      } else if qState[q] == 2 and q < 90 {
        let line = qName[q] + ": done!"
        write line at 316 - length(line) * 6, 30 color "#7ee787" shadow
        q = 99
      }
      q += 1
    }
  }
  if toastT > 0 {
    toastT -= 1
    let ty = 46
    if touch {
      ty = 52
    }
    box 160 - length(toast) * 3 - 6, ty - 3, length(toast) * 6 + 12, 13 color "#05040acc"
    write toast at 160, ty centered color "#7ee787" shadow
  }
  let k = 0
  while k < maxHp / 2 {
    let v = hp - k * 2
    let pic = 2
    if v >= 2 {
      pic = 0
    } else if v == 1 {
      pic = 1
    }
    draw heart at 4 + k * 14, 3 frame pic
    k += 1
  }
  draw coin at 266, 7 frame tick / 6
  write "x" + coins at 277, 7 shadow
  if keys > 0 {
    drawKey(238, 4)
    write "" + keys at 252, 7 color "#ffd23f" shadow
  }
  // the weapon in hand (on phones: top middle, clear of the buttons)
  let wx = 4
  let wy = 150
  if touch {
    wx = 147
    wy = 2
  }
  box wx, wy, 26, 26 color "#05040a99"
  box wx, wy, 26, 1 color "#6b5b55"
  drawWeapon(weapon, wx + 13, wy + 13, 45)
  let bossBar = bossAwake and not bossDead and length(msgs) == 0
  if weaponShow > 0 and not bossBar and shopNear < 0 and skinNear < 0 {
    if touch {
      write wName[weapon] at 160, 32 centered color "#e8f4ff" shadow
    } else {
      write wName[weapon] at 34, 160 color "#e8f4ff" shadow
      if length(owned) > 1 {
        write "C: switch" at 34, 169 color "#9a8fb0"
      }
    }
  }
  if floor > 0 {
    if touch {
      write "FLOOR " + floor at 274, 20 color "#5d5470"
    } else {
      write "FLOOR " + floor at 274, 170 color "#5d5470"
    }
  } else {
    drawShopInfo()
  }
  // the boss's health bar
  if bossBar {
    let by0 = 158
    if touch {
      by0 = 34
    }
    let n = 0
    while n < length(ex) {
      if isBoss(ekind[n]) {
        write bossTitle() at 160, by0 centered color "#ffb38a" shadow
        box 79, by0 + 9, 162, 7 color "#000000aa"
        box 80, by0 + 10, 160, 5 color "#3a1518"
        box 80, by0 + 10, ehp[n] * 160 / bossMax, 5 color "#ff5a1f"
        box 80, by0 + 10, ehp[n] * 160 / bossMax, 1 color "#ffb38a"
      }
      n += 1
    }
  }
}

fn drawTalk() {
  let words = msgs[0]
  if tick % 2 == 0 and shown < length(words) {
    shown += 1
    if shown % 3 == 0 {
      sound sndTick volume 30
    }
  }
  // on phones the box sits at the top, so the buttons never cover it
  let ty = 124
  if touch {
    ty = 24
  }
  box 8, ty, 304, 50 color "#05040aee"
  box 8, ty, 304, 1 color "#d3bfa9"
  box 8, ty + 49, 304, 1 color "#d3bfa9"
  box 8, ty, 1, 50 color "#d3bfa9"
  box 311, ty, 1, 50 color "#d3bfa9"
  write part(words, 0, shown) at 18, ty + 8 shadow
  if shown >= length(words) and tick / 20 % 2 == 0 {
    box 298, ty + 40, 6, 2 color "#ffd23f"
    box 299, ty + 42, 4, 1 color "#ffd23f"
    box 300, ty + 43, 2, 1 color "#ffd23f"
  }
}

// the controls, for when you forget them (P)
fn drawHelp() {
  if touch {
    drawHelpPhone()
    return 0
  }
  box 0, 0, 320, 180 color "#000000aa"
  box 40, 18, 240, 144 color "#0b0912f2"
  box 40, 18, 240, 1 color "#d3bfa9"
  box 40, 161, 240, 1 color "#d3bfa9"
  box 40, 18, 1, 144 color "#d3bfa9"
  box 279, 18, 1, 144 color "#d3bfa9"
  write "CONTROLS" at 160, 26 centered color "#e8f4ff" shadow
  let names = ["MOVE", "SWING / USE", "DASH", "WEAPON", "POTION PACK", "DRINK", "BOMB", "SUMMON", "MUSIC / HELP"]
  let keysText = ["arrows / WASD", "X or space", "Z or shift", "C or Q", "B", "1 2 3 4 5", "G", "V (Necromancer)", "M / P"]
  let r = 0
  while r < length(names) {
    write names[r] at 54, 42 + r * 12 color "#ffd23f"
    write keysText[r] at 150, 42 + r * 12 color "#c9c3d6"
    r += 1
  }
  write "Press P to close" at 160, 151 centered color "#9a8fb0"
}

// the phone controls screen: each button's picture, name and use
fn drawHelpPhone() {
  box 0, 0, 320, 180 color "#000000b0"
  box 24, 10, 272, 134 color "#0b0912f4"
  box 24, 10, 272, 1 color "#d3bfa9"
  box 24, 143, 272, 1 color "#d3bfa9"
  box 24, 10, 1, 134 color "#d3bfa9"
  box 295, 10, 1, 134 color "#d3bfa9"
  write "CONTROLS" at 160, 16 centered color "#e8f4ff" shadow
  let names = ["STICK", "SWORD", "DASH", "SWITCH", "PACK", "SUMMON"]
  let uses = ["walk, pick a pack slot", "attack, talk, open, buy, climb", "burst forward, dodge hits", "swap weapon (title: code)", "open pack, use potions and bombs", "skeletons (Necromancer look)"]
  let r = 0
  while r < 6 {
    let ry = 27 + r * 16
    box 32, ry - 2, 256, 15 color "#15101e"
    if r == 0 {
      draw pStick at 34 - 120, ry - 122 scale 6
    } else if r == 1 {
      draw pSword at 34 - 41, ry - 41 scale 14
    } else if r == 2 {
      draw pDash at 34 - 41, ry - 41 scale 14
    } else if r == 3 {
      draw pSwitch at 34 - 41, ry - 41 scale 14
    } else if r == 4 {
      draw pPack at 34 - 41, ry - 41 scale 14
    } else {
      draw pSummon at 34 - 41, ry - 41 scale 14
    }
    write names[r] at 54, ry + 3 color "#ffd23f"
    write uses[r] at 98, ry + 3 color "#c9c3d6"
    r += 1
  }
  write "SWORD: close   (reopen: PACK, SWITCH)" at 160, 128 centered color "#9a8fb0"
}

// the pack: three slots, one potion kind each
fn drawInv() {
  box 0, 0, 320, 180 color "#00000088"
  box 40, 30, 240, 120 color "#0b0912f2"
  box 40, 30, 240, 1 color "#d3bfa9"
  box 40, 149, 240, 1 color "#d3bfa9"
  box 40, 30, 1, 120 color "#d3bfa9"
  box 279, 30, 1, 120 color "#d3bfa9"
  write "POTION PACK" at 160, 38 centered color "#e8f4ff" shadow
  let sl = 0
  while sl < 6 {
    let cx = 70 + sl * 36
    box cx - 16, 52, 32, 36 color "#1c1626"
    let edgeCol = "#6b5b55"
    if sl == invSel {
      edgeCol = "#ffd23f"
    }
    box cx - 16, 52, 32, 1 color edgeCol
    box cx - 16, 87, 32, 1 color edgeCol
    box cx - 16, 52, 1, 36 color edgeCol
    box cx + 15, 52, 1, 36 color edgeCol
    drawIcon(sl, cx - 8, 62, inv[sl] == 0)
    write "x" + inv[sl] at cx, 94 centered color "#ffd23f" shadow
    let keyName = "" + (sl + 1)
    if sl == 5 {
      keyName = "G"
    }
    write keyName at cx - 12, 56 color "#6b5b55"
    sl += 1
  }
  write invName[invSel] at 160, 108 centered color "#e8f4ff" shadow
  write invInfo[invSel] at 160, 119 centered color "#c9c3d6"
  if invNote != "" {
    write invNote at 160, 134 centered color "#ff8a8a"
  } else {
    if touch {
      write "SWORD: use   PACK: close   SWITCH: menu" at 160, 134 centered color "#9a8fb0"
    } else {
      write "X: use    B: close" at 160, 134 centered color "#9a8fb0"
    }
  }
}

fn drawMoon(cx, cy) {
  let r = 0
  while r < length(moonW) {
    let w = moonW[r]
    box cx - w, cy - 18 + r, w * 2, 1 color "#e8f4ff"
    r += 1
  }
  box cx - 8, cy - 6, 5, 4 color "#c9dbea"
  box cx + 4, cy + 3, 7, 5 color "#c9dbea"
  box cx - 2, cy + 9, 4, 3 color "#c9dbea"
}

fn clock(frames) {
  let secs = frames / 60
  let mins = secs / 60
  secs = secs % 60
  if secs < 10 {
    return mins + ":0" + secs
  }
  return mins + ":" + secs
}

fn titleScreen() {
  // the first floor slowly drifts past behind the title
  camX = 120 + (tick / 3) % 400
  camY = 260
  drawWorld()
  box 0, 0, 320, 180 color "#0b0814bb"
  drawMoon(160, 36)
  write "MOONWELL" at 160, 64 size 4 centered color "#e8f4ff" shadow
  write "a dungeon crawler written in Volt" at 160, 102 centered color "#9a8fb0"
  if length(save0) > 0 {
    if tick / 30 % 2 == 0 {
      if touch {
        write "SWORD  CONTINUE - " + floorNames[save0[0]] at 160, 124 centered color "#ffd23f" shadow
      } else {
        write "X  CONTINUE - " + floorNames[save0[0]] at 160, 124 centered color "#ffd23f" shadow
      }
    }
    if touch {
      write "DASH  start a new journey" at 160, 138 centered color "#c9c3d6" shadow
    } else {
      write "N  start a new journey" at 160, 138 centered color "#c9c3d6" shadow
    }
  } else if tick / 30 % 2 == 0 {
    if touch {
      write "TAP SWORD TO BEGIN" at 160, 128 centered color "#ffd23f" shadow
    } else {
      write "PRESS X TO BEGIN" at 160, 128 centered color "#ffd23f" shadow
    }
  }
  if bestTime > 0 {
    write "best time " + clock(bestTime) at 160, 154 centered color "#7ee787"
  }
  if bank > 0 and length(save0) == 0 {
    write "treasury: " + bank + " gold" at 160, 144 centered color "#ffd23f"
  }
  if touch {
    write "SWITCH: code   PACK: settings" at 130, 168 centered color "#9a8fb0"
  } else {
    write "C: code   O: settings   P: help   M: mute" at 160, 168 centered color "#5d5470"
  }
}

fn endScreen() {
  box 0, 0, 320, 180 color "#000000aa"
  if mode == 2 {
    write "YOU FELL" at 160, 62 size 3 centered color "#ff4d6d" shadow
    write "Press X to rise again" at 160, 104 centered shadow
  } else if epilogue == 1 {
    if tick % 4 == 0 {
      burst(random(0, 320) + camX, random(0, 180) + camY, 1, "#ffb34a", 8)
    }
    drawMoon(160, 34)
    write "THE EMBER KING HAS FALLEN" at 160, 66 size 2 centered color "#ffd23f" shadow
    write "Silver light creeps back into the halls..." at 160, 90 centered color "#e8f4ff" shadow
    write "...but it flickers. Something stirs far below." at 160, 102 centered color "#c9c3d6" shadow
    write "Gold: " + coins + "     Time: " + clock(playTime) at 160, 120 centered color "#ffd23f" shadow
    write "Press X to return to camp" at 160, 140 centered shadow
  } else {
    if tick % 4 == 0 {
      burst(random(0, 320) + camX, random(0, 180) + camY, 1, "#e8f4ff", 8)
    }
    drawMoon(160, 34)
    write "THE MOONWELL WAKES" at 160, 70 size 2 centered color "#e8f4ff" shadow
    write "Gold: " + coins + "     Time: " + clock(playTime) at 160, 98 centered color "#ffd23f" shadow
    if playTime == bestTime {
      write "A new best time!" at 160, 110 centered color "#7ee787" shadow
    }
    write "Your gold is kept for your next journey." at 160, 116 centered color "#c9c3d6" shadow
    write "Thanks for playing!   Press X" at 160, 130 centered shadow
  }
}

// =====================================================================
//  Start up, keys and the main loop
// =====================================================================
// the moon on the title screen: a circle, one row at a time
for r from -18 to 18 {
  let w = 0
  while (w + 1) * (w + 1) + r * r <= 324 {
    w += 1
  }
  add w to moonW
}
save0 = saved("moonwell", [])
bestTime = saved("best", 0)
bank = saved("bank", 0)
skinsOwned = saved("skins", [0])
skin = saved("skin", 0)
deepest = saved("deepest", 1)
codesUsed = saved("codes", [])
won = saved("won", 0)
let qSaved = saved("quests", [])
if length(qSaved) >= 12 and length(qSaved) % 2 == 0 {
  let qHalf = length(qSaved) / 2
  let qi = 0
  while qi < qHalf {
    qState[qi] = qSaved[qi]
    qProg[qi] = qSaved[qi + qHalf]
    qi += 1
  }
}
shardFloors = saved("shards", [])
trueEnd = saved("true", 0)
secFound = saved("secrets", [])
stats = saved("stats", stats)
while length(stats) < 8 {
  add 0 to stats
}
ach = saved("ach", [])
while length(ach) < length(achName) {
  add 0 to ach
}
ctlSeen = saved("ctl", 0)
let setSaved = saved("set", [])
if length(setSaved) == 4 {
  setMusic = setSaved[0]
  setSfx = setSaved[1]
  setShake = setSaved[2]
  setLefty = setSaved[3]
}
touch = touchscreen()
# window.__ctlDone = () => { ctlEditing = false; };
applySettings()
floor = 1
buildLevel()

when key "x" pressed {
  pressX()
}
when key "space" pressed {
  pressX()
}
when key "enter" pressed {
  pressX()
}
when key "z" pressed {
  pressZ()
}
when key "shift" pressed {
  pressZ()
}
when key "c" pressed {
  if mode == 0 and length(msgs) == 0 {
    enterCode()
  } else if touch and invOpen {
    invOpen = false
    openSettings()
  } else {
    switchWeapon()
  }
}
when key "v" pressed {
  summon()
}
when key "b" pressed {
  toggleInv()
}
when key "i" pressed {
  toggleInv()
}
when key "escape" pressed {
  if enchOpen {
    closeEnch()
  } else if setOpen {
    closeSettings()
  } else if achOpen or statsOpen {
    achOpen = false
    statsOpen = false
  } else if invOpen or helpOpen {
    invOpen = false
    helpOpen = false
  } else {
    openSettings()
  }
}
when key "o" pressed {
  if setOpen {
    closeSettings()
  } else {
    openSettings()
  }
}
when key "up" pressed {
  if enchOpen {
    enchMove(-1)
  } else if setOpen {
    setMove(-1)
  }
}
when key "down" pressed {
  if enchOpen {
    enchMove(1)
  } else if setOpen {
    setMove(1)
  }
}
when key "w" pressed {
  if enchOpen {
    enchMove(-1)
  } else if setOpen {
    setMove(-1)
  }
}
when key "s" pressed {
  if enchOpen {
    enchMove(1)
  } else if setOpen {
    setMove(1)
  }
}
when key "p" pressed {
  toggleHelp()
}
when key "h" pressed {
  toggleHelp()
}
when key "left" pressed {
  invMove(-1)
}
when key "right" pressed {
  invMove(1)
}
when key "a" pressed {
  invMove(-1)
}
when key "d" pressed {
  invMove(1)
}
when key "1" pressed {
  usePotion(0)
}
when key "2" pressed {
  usePotion(1)
}
when key "3" pressed {
  usePotion(2)
}
when key "4" pressed {
  usePotion(3)
}
when key "5" pressed {
  usePotion(4)
}
when key "g" pressed {
  usePotion(5)
}
when key "q" pressed {
  switchWeapon()
}
when key "m" pressed {
  muted = not muted
  if muted {
    volume 0
  } else {
    volume 100
  }
}
when key "n" pressed {
  if mode == 0 and length(msgs) == 0 {
    newJourney()
  }
}

every frame {
  tick += 1
  pickMusic()
  if mode == 0 {
    titleScreen()
  } else {
    if cutT > 0 {
      playCut()
    } else if mode == 1 and length(msgs) == 0 and not invOpen and not helpOpen and not setOpen and not achOpen and not statsOpen and not ctlEditing and not enchOpen {
      update()
    }
    updateSparks()
    updateEffects()
    if whiteT > 0 {
      whiteT -= 1
    }
    updateCamera()
    drawWorld()
    drawVignette()
    drawHud()
    if cutT > 0 {
      drawCut()
    }
    if invOpen and mode == 1 and length(msgs) == 0 {
      drawInv()
    }
    if mode >= 2 and length(msgs) == 0 {
      endScreen()
    }
    if whiteT > 0 {
      box 0, 0, 320, 180 color "#fff4d0" + fadeHex[whiteT / 3]
    }
    if fadeIn > 0 {
      box 0, 0, 320, 180 color "#000000" + fadeHex[fadeIn / 2]
      fadeIn -= 1
    }
  }
  if helpOpen {
    drawHelp()
  }
  if setOpen {
    drawSettings()
  }
  if enchOpen {
    drawEnch()
  }
  if achOpen {
    drawAch()
  }
  if statsOpen {
    drawStats()
  }
  if length(msgs) > 0 {
    drawTalk()
  }
}

// =====================================================================
//  Setting up a floor
// =====================================================================
fn cell(tx, ty) {
  if tx < 0 or ty < 0 or tx >= MW or ty >= MH {
    return "#"
  }
  return grid[ty * MW + tx]
}

fn isWall(tx, ty) {
  return contains("#bfr%", cell(tx, ty))
}

fn solidCell(tx, ty) {
  return contains("#bfr%uvCDKqy12345678", cell(tx, ty))
}

fn isBoss(k) {
  return k == 5 or (k >= 14 and k <= 23)
}

// the new bosses move and fight like an older boss
fn bossAi(k) {
  if k == 19 {
    return 16
  }
  if k == 20 {
    return 14
  }
  if k == 21 {
    return 15
  }
  if k == 22 {
    return 17
  }
  if k == 23 {
    return 18
  }
  return k
}

fn spawnEnemy(kind, tx, ty) {
  let w = 12
  let h = 8
  if isBoss(kind) {
    w = 24
    h = 14
  }
  add tx * 16 + 8 - w / 2 to ex
  add ty * 16 + 14 - h to ey
  add kind to ekind
  if isBoss(kind) {
    add kindLife[kind] to ehp
  } else {
    add kindLife[kind] + (floor - 1) / 2 to ehp
  }
  add 0 to ehurt
  add 0 to ekx
  add 0 to eky
  add random(0, 60) to etimer
  add 0 to edx
  add 0 to edy
  add false to eleft
  add ty * MW + tx to ehome
  add random(40, 140) to eshot
}

fn spawnNear(kind, tx, ty) {
  if not solidCell(tx, ty) and cell(tx, ty) != "^" {
    spawnEnemy(kind, tx, ty)
    burst(tx * 16 + 8, ty * 16 + 8, 10, "#c77dff", 14)
    effect(16, tx * 16 + 8, ty * 16 + 8, 26, "#c77dff", 20, 90, 0, -6)
  }
}


// ============================== small helpers ============================
fn cosA(k) {
  return cosT[k % 24]
}

fn sinA(k) {
  return cosT[(k + 18) % 24]
}

fn comp(c, speed) {
  return sign(c) * (abs(c) * speed / 100)
}

fn sdiv(a, b) {
  return sign(a) * (abs(a) / b)
}

// distance, close enough for gameplay (an octagon, not a circle)
fn aimDist(dx, dy) {
  let ax = abs(dx)
  let ay = abs(dy)
  return max(ax, ay) + min(ax, ay) / 2
}

fn inputX() {
  let v = 0
  if held("left") or held("a") {
    v -= 1
  }
  if held("right") or held("d") {
    v += 1
  }
  return v
}

fn inputY() {
  let v = 0
  if held("up") or held("w") {
    v -= 1
  }
  if held("down") or held("s") {
    v += 1
  }
  return v
}

fn burst(px, py, count, color, speed) {
  if length(qx) > 260 {
    return 0
  }
  repeat count {
    add px * 10 to qx
    add py * 10 to qy
    add random(0 - speed, speed) to qvx
    add random(0 - speed, speed) to qvy
    add random(12, 28) to ql
    add color to qc
  }
}

fn addFx(kind, x, y) {
  add x to gX
  add y to gY
  add kind to gK
  add 0 to gT
}

fn popText(px, py, words, color) {
  add px to tX
  add py to tY
  add words to tS
  add 30 to tL
  add color to tC
}

fn shake(m, t) {
  shakeM = max(shakeM, m)
  shakeT = max(shakeT, t)
}

fn setBanner(a, b, t) {
  bannerA = a
  bannerB = b
  bannerT = t
}

// ============================== the room =================================
fn cellAt(tx, ty) {
  if tx < 0 or ty < 0 or tx >= 20 or ty >= 10 {
    return 1
  }
  return cells[ty * 20 + tx]
}

fn solidCell(tx, ty) {
  let c = cellAt(tx, ty)
  if c == 0 {
    return false
  }
  if c == 4 {
    return not gateOpen
  }
  return true
}

// is a box (in pixels) touching anything solid?
fn blocked(px, py, w, h) {
  if px < 0 or py < 0 {
    return true
  }
  let x1 = px / 16
  let y1 = py / 16
  let x2 = (px + w - 1) / 16
  let y2 = (py + h - 1) / 16
  return solidCell(x1, y1) or solidCell(x2, y1) or solidCell(x1, y2) or solidCell(x2, y2)
}

fn buildRoom() {
  cells = []
  let y = 0
  while y < 10 {
    let x = 0
    while x < 20 {
      let v = 0
      if x == 0 or y == 0 or x == 19 or y == 9 {
        v = 1
      }
      if x == 19 and (y == 4 or y == 5) {
        v = 4
      }
      add v to cells
      x += 1
    }
    y += 1
  }
  // scatter obstacles. Each one needs empty tiles all around it, so they
  // never touch each other or the walls and can't wall anything in.
  let want = 3 + random(0, 4)
  if room == 5 {
    want = 2
  }
  if room == 4 {
    want = 0
  }
  let tries = 0
  while want > 0 and tries < 120 {
    tries += 1
    let ox = random(2, 17)
    let oy = random(2, 7)
    let free = true
    if (ox <= 4 or ox >= 15) and oy >= 3 and oy <= 6 {
      free = false
    }
    for ddy from 0 - 1 to 1 {
      for ddx from 0 - 1 to 1 {
        if cellAt(ox + ddx, oy + ddy) != 0 {
          free = false
        }
      }
    }
    if free {
      cells[oy * 20 + ox] = 2
      want -= 1
    }
  }
}

fn clearEnemies() {
  eK = []
  eX = []
  eY = []
  eHp = []
  eMax = []
  eT = []
  eS = []
  eA = []
  eNx = []
  eVX = []
  eVY = []
  eHit = []
  eIm = []
  eSp = []
  eFace = []
}

fn clearShots() {
  pX = []
  pY = []
  pVX = []
  pVY = []
  pDmg = []
  pKind = []
  pLife = []
  pOwn = []
  pPierce = []
}

fn clearLoot() {
  oX = []
  oY = []
  oK = []
  oL = []
}

fn enterRoom() {
  clearEnemies()
  clearShots()
  clearLoot()
  buildRoom()
  hx = 260
  hy = 680
  aimX = 1
  aimY = 0
  faceLeft = false
  dashT = 0
  atkT = 0
  hitT = 60
  shield = cardLv[6]
  gateOpen = false
  cleared = false
  lullT = 0
  clearT = 0
  bossSlain = false
  bossRage = false
  bossWipe = false
  wavesLeft = 0
  if room == 1 {
    setBanner("FLOOR " + text(depth), floorNames[depth - 1], 150)
  }
  if room == 5 {
    startBoss()
    setBanner(bossNames[depth - 1], "Guardian of the floor", 150)
  } else if room == 4 {
    mode = 5
    shopSold = [0, 0, 0]
    shopIdx = 0
  } else {
    wavesLeft = 1 + room / 2
  }
}

fn nextRoom() {
  room += 1
  if room > 5 {
    room = 1
    depth += 1
    hp = min(hp + 3, maxHp)
    sound jingleFloor volume 80
  } else {
    sound sndDoor volume 60
  }
  enterRoom()
  playMusic()
}

fn clearRoom() {
  cleared = true
  clearT = 40
  if room == 5 {
    clearT = 80
  }
  sound sndDoor volume 40
  popText(150, 56, "CLEAR!", "#ffd23f")
}

fn afterClear() {
  roomsDone += 1
  rollCards()
}

fn updateRoom() {
  if clearT > 0 {
    clearT -= 1
    if clearT == 0 {
      afterClear()
    }
  }
  if not cleared and room != 4 {
    if length(eK) == 0 {
      lullT += 1
      if lullT > 36 {
        lullT = 0
        if wavesLeft > 0 {
          spawnWave()
          wavesLeft -= 1
        } else {
          clearRoom()
        }
      }
    } else {
      lullT = 0
    }
  }
  if gateOpen and hx / 10 + 10 >= 316 {
    nextRoom()
  }
}

// ============================== enemies ==================================
fn ew(k) {
  if k == 0 or k == 4 or k == 5 or k == 7 {
    return 12
  }
  if k == 20 {
    return 22
  }
  if k == 21 {
    return 18
  }
  if k >= 22 {
    return 24
  }
  return 10
}

fn eh(k) {
  if k == 1 {
    return 8
  }
  if k == 0 or k == 4 or k == 5 or k == 7 {
    return 12
  }
  if k >= 20 {
    return 14
  }
  return 10
}

fn mobHp(k) {
  let extra = (depth - 1) / 2
  if k == 0 {
    return 3 + extra
  }
  if k == 1 {
    return 2 + extra
  }
  if k == 2 {
    return 4 + extra
  }
  if k == 3 {
    return 3 + extra
  }
  if k == 4 {
    return 9 + extra * 2
  }
  if k == 5 {
    return 6 + extra
  }
  if k == 6 {
    return 5 + extra
  }
  if k == 7 {
    return 5 + extra
  }
  if k == 20 {
    return 40
  }
  if k == 21 {
    return 46
  }
  if k == 22 {
    return 64
  }
  return 96
}

fn eDmg(k) {
  if k == 4 or k == 5 or k >= 20 {
    return 2
  }
  return 1
}

fn pickKind(d) {
  let r = random(1, 100)
  if d == 1 {
    if r <= 40 {
      return 0
    }
    if r <= 75 {
      return 1
    }
    return 2
  }
  if d == 2 {
    if r <= 20 {
      return 1
    }
    if r <= 45 {
      return 2
    }
    if r <= 70 {
      return 3
    }
    if r <= 90 {
      return 4
    }
    return 5
  }
  if d == 3 {
    if r <= 15 {
      return 2
    }
    if r <= 35 {
      return 3
    }
    if r <= 50 {
      return 4
    }
    if r <= 75 {
      return 5
    }
    return 6
  }
  if r <= 15 {
    return 3
  }
  if r <= 35 {
    return 5
  }
  if r <= 55 {
    return 6
  }
  if r <= 80 {
    return 7
  }
  return 4
}

fn addEnemy(k, px, py, spawnT) {
  add k to eK
  add px * 10 to eX
  add py * 10 to eY
  add mobHp(k) to eHp
  add mobHp(k) to eMax
  add random(0, 40) to eT
  add 0 to eS
  add 0 to eA
  add 0 to eNx
  add 0 to eVX
  add 0 to eVY
  add 0 to eHit
  add 0 to eIm
  add spawnT to eSp
  add 0 to eFace
}

fn removeEnemy(i) {
  remove eK[i]
  remove eX[i]
  remove eY[i]
  remove eHp[i]
  remove eMax[i]
  remove eT[i]
  remove eS[i]
  remove eA[i]
  remove eNx[i]
  remove eVX[i]
  remove eVY[i]
  remove eHit[i]
  remove eIm[i]
  remove eSp[i]
  remove eFace[i]
}

fn spawnRandom(k, spawnT) {
  let tries = 0
  let px = 150
  let py = 70
  let good = false
  while tries < 30 and not good {
    tries += 1
    px = random(2, 17) * 16 + 2
    py = random(2, 7) * 16 + 3
    good = not blocked(px, py, ew(k), eh(k))
    if good {
      let d = aimDist(px + 5 - (hx / 10 + 5), py + 4 - (hy / 10 + 4))
      if d < 70 {
        good = false
      }
    }
  }
  if not good {
    px = 150
    py = 70
  }
  addEnemy(k, px, py, spawnT)
}

fn spawnWave() {
  let n = 2 + (depth + 1) / 2 + random(0, 1) + room / 3
  n = min(n, 7)
  repeat n {
    spawnRandom(pickKind(depth), 36)
  }
  sound sndTick volume 50
}

fn startBoss() {
  let k = 19 + depth
  addEnemy(k, 215, 66, 55)
  let b = length(eK) - 1
  eT[b] = 0
  playMusic()
}

// ============================== shots ====================================
fn shoot(px, py, vx, vy, dmg, kind, life) {
  add px * 10 to pX
  add py * 10 to pY
  add vx to pVX
  add vy to pVY
  add dmg to pDmg
  add kind to pKind
  add life to pLife
  add 0 to pOwn
  add 0 to pPierce
}

fn shootAt(px, py, tx, ty, speed, dmg, kind) {
  let dx = tx - px
  let dy = ty - py
  let d = aimDist(dx, dy)
  if d == 0 {
    dy = 1
    d = 1
  }
  shoot(px, py, sign(dx) * (abs(dx) * speed / d), sign(dy) * (abs(dy) * speed / d), dmg, kind, 220)
}

fn shootRing(px, py, n, speed, startK, dmg, kind) {
  let s = 0
  while s < n {
    let k = startK + s * 24 / n
    shoot(px, py, comp(cosA(k), speed), comp(sinA(k), speed), dmg, kind, 260)
    s += 1
  }
}

fn removeShot(i) {
  remove pX[i]
  remove pY[i]
  remove pVX[i]
  remove pVY[i]
  remove pDmg[i]
  remove pKind[i]
  remove pLife[i]
  remove pOwn[i]
  remove pPierce[i]
}

fn updateShots() {
  let i = length(pX) - 1
  while i >= 0 {
    pX[i] += pVX[i]
    pY[i] += pVY[i]
    pLife[i] -= 1
    let cx = pX[i] / 10
    let cy = pY[i] / 10
    let gone = pLife[i] <= 0
    if blocked(cx - 1, cy - 1, 2, 2) {
      gone = true
      burst(cx, cy, 3, "#ffffff", 4)
    }
    if not gone and pOwn[i] == 0 {
      if abs(cx - (hx / 10 + 5)) < 6 and abs(cy - (hy / 10 + 4)) < 6 {
        if hurtPlayer(pDmg[i]) == 1 {
          gone = true
        }
      }
    }
    if not gone and pOwn[i] == 1 {
      let j = length(eK) - 1
      while j >= 0 {
        if j < length(eK) {
          let k = eK[j]
          let ecx = eX[j] / 10 + ew(k) / 2
          let ecy = eY[j] / 10 + eh(k) / 2
          if eSp[j] == 0 and eIm[j] == 0 and abs(cx - ecx) < ew(k) / 2 + 3 and abs(cy - ecy) < eh(k) / 2 + 3 {
            hurtEnemy(j, pDmg[i], sign(pVX[i]) * 25, sign(pVY[i]) * 25)
            if j < length(eK) {
              eIm[j] = 10
            }
            pPierce[i] -= 1
            burst(cx, cy, 6, "#7be0ff", 8)
            if pPierce[i] < 0 {
              gone = true
              j = 0
            }
          }
        }
        j -= 1
      }
    }
    if pOwn[i] == 1 and pLife[i] % 2 == 0 {
      burst(cx, cy, 1, "#7be0ff", 2)
    }
    if gone {
      removeShot(i)
    }
    i -= 1
  }
}

// ============================== loot =====================================
fn addPickup(px, py, kind) {
  add px * 10 to oX
  add py * 10 to oY
  add kind to oK
  add 0 to oL
}

fn dropLoot(cx, cy) {
  let r = random(1, 100)
  let n = 0
  if r <= 60 {
    n = 1
  }
  if r <= 20 {
    n = 2
  }
  if cardLv[7] > 0 and random(1, 100) <= 35 * cardLv[7] {
    n += 1
  }
  repeat n {
    addPickup(cx + random(-6, 6), cy + random(-4, 4), 0)
  }
  if random(1, 100) <= 6 {
    addPickup(cx, cy, 1)
  }
}

fn updatePickups() {
  let pcx = hx / 10 + 5
  let pcy = hy / 10 + 4
  let i = length(oX) - 1
  while i >= 0 {
    oL[i] += 1
    let cx = oX[i] / 10
    let cy = oY[i] / 10
    let dx = pcx - cx
    let dy = pcy - cy
    let d = aimDist(dx, dy)
    let got = false
    if oK[i] == 0 and d < 46 and oL[i] > 14 {
      oX[i] += sign(dx) * (abs(dx) * 32 / max(d, 1))
      oY[i] += sign(dy) * (abs(dy) * 32 / max(d, 1))
    }
    if d < 9 and oL[i] > 8 {
      if oK[i] == 0 {
        coins += 1
        sound sndCoin volume 30
        got = true
      } else if hp < maxHp {
        hp = min(hp + 2, maxHp)
        sound sndHeal volume 50
        addFx(2, pcx, pcy)
        popText(pcx, pcy - 12, "+1 heart", "#ff9ab0")
        got = true
      }
    }
    if got {
      remove oX[i]
      remove oY[i]
      remove oK[i]
      remove oL[i]
    }
    i -= 1
  }
}

// ============================== damage ===================================
fn slashDmg() {
  let d = 2 + cardLv[0] + metaM + heroSlash
  if cardLv[4] > 0 and hp * 2 <= maxHp {
    d += 1 + cardLv[4]
  }
  return max(1, d)
}

fn boltDmg() {
  return 3 + cardLv[1] + heroBoltDmg + metaM / 2
}

fn hurtEnemy(i, dmg, kx, ky) {
  if i >= length(eK) {
    return 0
  }
  if eSp[i] > 0 {
    return 0
  }
  let k = eK[i]
  let cx = eX[i] / 10 + ew(k) / 2
  let cy = eY[i] / 10 + eh(k) / 2
  eHp[i] -= dmg
  eHit[i] = 6
  if k < 20 {
    eVX[i] = kx
    eVY[i] = ky
  }
  freeze = max(freeze, 1)
  if k >= 20 {
    sound sndHeavy volume 35
  } else {
    sound sndHit volume 45
  }
  popText(cx, cy - 10, text(dmg), "#ffffff")
  addFx(0, cx, cy)
  burst(cx, cy, 3, "#ffffff", 6)
  if eHp[i] <= 0 {
    killEnemy(i)
  }
  return 1
}

fn killEnemy(i) {
  let k = eK[i]
  let cx = eX[i] / 10 + ew(k) / 2
  let cy = eY[i] / 10 + eh(k) / 2
  burst(cx, cy, 12, "#ffb34a", 10)
  addFx(1, cx, cy)
  burst(cx, cy, 6, "#ffffff", 6)
  kills += 1
  freeze = 3
  if k >= 20 {
    bossDown(cx, cy)
    removeEnemy(i)
    return 0
  }
  dropLoot(cx, cy)
  if cardLv[10] > 0 and hp < maxHp and kills % max(3, 10 - cardLv[10] * 2) == 0 {
    hp += 1
    popText(cx, cy - 10, "+HP", "#7ee787")
    addFx(2, hx / 10 + 5, hy / 10 + 4)
  }
  removeEnemy(i)
}

fn bossDown(cx, cy) {
  bossKills += 1
  bossSlain = true
  bossWipe = true
  shake(6, 40)
  sound jingleBoss volume 90
  burst(cx, cy, 40, "#ffd23f", 16)
  burst(cx, cy, 24, "#ff4d6d", 12)
  repeat 8 {
    addPickup(cx + random(-18, 18), cy + random(-10, 10), 0)
  }
  addPickup(cx - 10, cy + 6, 1)
  addPickup(cx + 10, cy + 6, 1)
}

// a ring of lightning from the Thunder Seal blessing
fn doChain(cx, cy) {
  let left = 2 + cardLv[5]
  let dmg = 2 + cardLv[5]
  let j = length(eK) - 1
  while j >= 0 and left > 0 {
    if j < length(eK) {
      let k = eK[j]
      let ecx = eX[j] / 10 + ew(k) / 2
      let ecy = eY[j] / 10 + eh(k) / 2
      if eSp[j] == 0 and aimDist(ecx - cx, ecy - cy) < 80 {
        burst(ecx, ecy, 6, "#ffe66d", 9)
        popText(ecx, ecy - 16, "ZAP", "#ffe66d")
        hurtEnemy(j, dmg, 0, 0)
        left -= 1
      }
    }
    j -= 1
  }
}

fn hurtPlayer(dmg) {
  if hitT > 0 or dashT > 0 or mode != 1 {
    return 0
  }
  let pcx = hx / 10 + 5
  let pcy = hy / 10 + 4
  if shield > 0 {
    shield -= 1
    hitT = 45
    sound sndNope volume 50
    burst(pcx, pcy, 10, "#9bd3ff", 9)
    popText(pcx, pcy - 14, "BLOCK", "#9bd3ff")
    return 1
  }
  hp -= dmg
  hitT = 60
  redT = 8
  freeze = 4
  shake(3, 10)
  sound sndHurt volume 70
  burst(pcx, pcy, 10, "#ff4d6d", 9)
  if hp <= 0 {
    dieNow()
  }
  return 1
}

// ============================== the hero =================================
fn movePlayer(vx, vy) {
  if vx != 0 and not blocked((hx + vx) / 10, hy / 10, 10, 8) {
    hx += vx
  }
  if vy != 0 and not blocked(hx / 10, (hy + vy) / 10, 10, 8) {
    hy += vy
  }
}

fn slashAngle() {
  if aimX == 0 and aimY == 1 {
    return 0
  }
  if aimX == 1 and aimY == 1 {
    return 315
  }
  if aimX == 1 and aimY == 0 {
    return 270
  }
  if aimX == 1 and aimY == 0 - 1 {
    return 225
  }
  if aimX == 0 and aimY == 0 - 1 {
    return 180
  }
  if aimX == 0 - 1 and aimY == 0 - 1 {
    return 135
  }
  if aimX == 0 - 1 and aimY == 0 {
    return 90
  }
  return 45
}

fn applySlash() {
  let cx = hx / 10 + 5 + aimX * 13
  let cy = hy / 10 + 4 + aimY * 13
  let dmg = slashDmg()
  let any = false
  let j = length(eK) - 1
  while j >= 0 {
    if j < length(eK) {
      let k = eK[j]
      let ecx = eX[j] / 10 + ew(k) / 2
      let ecy = eY[j] / 10 + eh(k) / 2
      if abs(ecx - cx) < ew(k) / 2 + 14 and abs(ecy - cy) < eh(k) / 2 + 14 {
        if hurtEnemy(j, dmg, aimX * 45, aimY * 45) == 1 {
          any = true
        }
      }
    }
    j -= 1
  }
  // a slash also cuts enemy shots out of the air
  let s = length(pX) - 1
  while s >= 0 {
    if pOwn[s] == 0 and abs(pX[s] / 10 - cx) < 16 and abs(pY[s] / 10 - cy) < 16 {
      burst(pX[s] / 10, pY[s] / 10, 4, "#ffffff", 6)
      removeShot(s)
    }
    s -= 1
  }
  if any {
    slashN += 1
    if cardLv[5] > 0 and slashN % 4 == 0 {
      doChain(hx / 10 + 5, hy / 10 + 4)
    }
  }
}

fn castBolt() {
  bolts -= 1
  boltCool = 14
  let cnt = 1 + cardLv[11]
  let vx = aimX * 28
  let vy = aimY * 28
  if aimX != 0 and aimY != 0 {
    vx = aimX * 20
    vy = aimY * 20
  }
  let n = 0
  while n < cnt {
    let spread = (n * 2 - (cnt - 1)) * 4   // sideways gap between twin bolts
    let sx = hx / 10 + 5 + (0 - aimY) * spread + aimX * 6
    let sy = hy / 10 + 4 + aimX * spread + aimY * 6
    shoot(sx, sy, vx, vy, boltDmg(), 2, 55)
    let last = length(pOwn) - 1
    pOwn[last] = 1
    pPierce[last] = cardLv[1]
    n += 1
  }
  sound sndSwitch volume 55
}

fn doDash() {
  if mode != 1 or paused or dashCool > 0 or dashT > 0 {
    return 0
  }
  let ix = inputX()
  let iy = inputY()
  if ix == 0 and iy == 0 {
    ix = aimX
    iy = aimY
  }
  dashX = ix
  dashY = iy
  dashT = 8
  dashCool = max(18, heroDashCd - cardLv[2] * 14)
  sound sndDash volume 60
  addFx(1, hx / 10 + 5, hy / 10 + 8)
}

fn updatePlayer() {
  if hitT > 0 {
    hitT -= 1
  }
  if atkCool > 0 {
    atkCool -= 1
  }
  if dashCool > 0 {
    dashCool -= 1
  }
  if boltCool > 0 {
    boltCool -= 1
  }
  if bolts < maxBolts {
    boltT += 1
    if boltT >= 100 {
      bolts += 1
      boltT = 0
    }
  }
  let ix = inputX()
  let iy = inputY()
  moving = ix != 0 or iy != 0
  if moving {
    aimX = ix
    aimY = iy
    if ix < 0 {
      faceLeft = true
    }
    if ix > 0 {
      faceLeft = false
    }
  }
  let spd = heroSpeed + cardLv[9] * 3
  if atkT > 0 {
    spd = spd * 2 / 3
  }
  if dashT > 0 {
    dashT -= 1
    let ds = 40
    if dashX != 0 and dashY != 0 {
      ds = 29
    }
    movePlayer(dashX * ds, dashY * ds)
    burst(hx / 10 + 5, hy / 10 + 4, 1, "#9bd3ff", 2)
  } else {
    let vx = ix * spd
    let vy = iy * spd
    if ix != 0 and iy != 0 {
      vx = sdiv(vx * 3, 4)
      vy = sdiv(vy * 3, 4)
    }
    movePlayer(vx, vy)
  }
  if (held("z") or held("space")) and atkCool == 0 and atkT == 0 and dashT == 0 {
    atkT = 12
    atkCool = max(7, 16 - cardLv[12] * 3)
    atkHit = false
    sound sndSwing volume 55
  }
  if atkT > 0 {
    atkT -= 1
    if atkT == 7 and not atkHit {
      atkHit = true
      applySlash()
    }
  }
  if held("x") and bolts > 0 and boltCool == 0 and dashT == 0 {
    castBolt()
  }
  // the fox spirits that orbit you
  if cardLv[8] > 0 {
    let o = 0
    while o < cardLv[8] {
      let a = tick / 3 + o * 24 / cardLv[8]
      let ox = hx / 10 + 5 + comp(cosA(a), 24)
      let oy = hy / 10 + 4 + comp(sinA(a), 24)
      let j = length(eK) - 1
      while j >= 0 {
        if j < length(eK) {
          let k = eK[j]
          let ecx = eX[j] / 10 + ew(k) / 2
          let ecy = eY[j] / 10 + eh(k) / 2
          if eSp[j] == 0 and eIm[j] == 0 and abs(ecx - ox) < ew(k) / 2 + 6 and abs(ecy - oy) < eh(k) / 2 + 6 {
            hurtEnemy(j, 1 + cardLv[8], 0, 0)
            if j < length(eK) {
              eIm[j] = 14
            }
          }
        }
        j -= 1
      }
      o += 1
    }
  }
}

// ============================== enemy brains =============================
fn moveEnemy(i, vx, vy) {
  let k = eK[i]
  let w = ew(k)
  let h = eh(k)
  if vx != 0 and not blocked((eX[i] + vx) / 10, eY[i] / 10, w, h) {
    eX[i] += vx
  }
  if vy != 0 and not blocked(eX[i] / 10, (eY[i] + vy) / 10, w, h) {
    eY[i] += vy
  }
}

fn moveToward(i, dx, dy, dist, speed) {
  if dist == 0 {
    return 0
  }
  moveEnemy(i, sign(dx) * (abs(dx) * speed / dist), sign(dy) * (abs(dy) * speed / dist))
}

fn applyKnock(i) {
  if eK[i] < 20 and (eVX[i] != 0 or eVY[i] != 0) {
    moveEnemy(i, eVX[i], eVY[i])
    eVX[i] = sdiv(eVX[i] * 3, 4)
    eVY[i] = sdiv(eVY[i] * 3, 4)
  }
}

fn touchPlayer(i) {
  let k = eK[i]
  if k == 5 and eS[i] == 3 {
    return 0
  }
  let w = ew(k)
  let h = eh(k)
  let dx = abs(eX[i] / 10 + w / 2 - (hx / 10 + 5))
  let dy = abs(eY[i] / 10 + h / 2 - (hy / 10 + 4))
  if dx < (w + 8) / 2 and dy < (h + 6) / 2 {
    hurtPlayer(eDmg(k))
  }
}

fn updateMob(i) {
  let k = eK[i]
  let cx = eX[i] / 10 + ew(k) / 2
  let cy = eY[i] / 10 + eh(k) / 2
  let pcx = hx / 10 + 5
  let pcy = hy / 10 + 4
  let dx = pcx - cx
  let dy = pcy - cy
  let dist = aimDist(dx, dy)
  eT[i] += 1
  let t = eT[i]
  if dx < 0 {
    eFace[i] = 1
  }
  if dx > 0 {
    eFace[i] = 0
  }
  if k == 0 {
    // slime: hops toward you
    if t % 50 < 26 {
      moveToward(i, dx, dy, dist, 10)
    }
  } else if k == 1 {
    // goblin: fast, weaves side to side
    if t % 40 < 28 {
      moveToward(i, dx, dy, dist, 14)
    } else {
      moveToward(i, dy, 0 - dx, dist, 12)
    }
  } else if k == 2 {
    moveToward(i, dx, dy, dist, 9)
  } else if k == 4 {
    moveToward(i, dx, dy, dist, 5)
  } else if k == 3 or k == 6 {
    // imp and shaman: keep their distance and throw magic
    if dist < 60 {
      moveToward(i, 0 - dx, 0 - dy, dist, 9)
    } else if dist > 110 {
      moveToward(i, dx, dy, dist, 8)
    } else if (t / 70) % 2 == 0 {
      moveToward(i, dy, 0 - dx, dist, 7)
    } else {
      moveToward(i, 0 - dy, dx, dist, 7)
    }
    let cycle = 110
    if k == 6 {
      cycle = 140
    }
    let ph = t % cycle
    if ph == cycle - 18 {
      eHit[i] = 14
    }
    if ph == cycle - 2 {
      if k == 3 {
        shootAt(cx, cy, pcx, pcy, 17, 1, 0)
      } else {
        let d2 = max(dist, 1)
        let ux = sign(0 - dy) * (abs(dy) * 34 / d2)
        let uy = sign(dx) * (abs(dx) * 34 / d2)
        shootAt(cx, cy, pcx, pcy, 16, 1, 0)
        shootAt(cx, cy, pcx + ux, pcy + uy, 16, 1, 0)
        shootAt(cx, cy, pcx - ux, pcy - uy, 16, 1, 0)
      }
    }
  } else if k == 5 {
    // orc: winds up, then charges in a straight line
    let s = eS[i]
    if s == 0 {
      moveToward(i, dx, dy, dist, 6)
      if t > 70 and dist < 110 {
        eS[i] = 1
        eT[i] = 0
      }
    } else if s == 1 {
      eHit[i] = 2
      if t >= 26 {
        eS[i] = 2
        eT[i] = 0
        eA[i] = sign(dx) * (abs(dx) * 40 / max(dist, 1))
        eNx[i] = sign(dy) * (abs(dy) * 40 / max(dist, 1))
      }
    } else if s == 2 {
      moveEnemy(i, eA[i], eNx[i])
      if t >= 22 {
        eS[i] = 3
        eT[i] = 0
      }
    } else {
      if t >= 50 {
        eS[i] = 0
        eT[i] = 0
      }
    }
  } else if k == 7 {
    // angel: drifts around and drops rings of light
    moveEnemy(i, comp(cosA(t / 7 % 24), 9), comp(sinA(t / 10 % 24), 7))
    if t % 150 == 138 {
      eHit[i] = 12
    }
    if t % 150 == 149 {
      shootRing(cx, cy, 8, 11, (t / 10) % 24, 1, 0)
    }
  }
}

// ============================== bosses ===================================
fn bossMove(i, k, dx, dy, dist) {
  if k == 20 {
    moveToward(i, dx, dy, dist, 9)
  } else if k == 21 {
    if dist < 85 {
      moveToward(i, 0 - dx, 0 - dy, dist, 8)
    } else if dist > 140 {
      moveToward(i, dx, dy, dist, 6)
    } else {
      moveToward(i, dy, 0 - dx, dist, 5)
    }
  } else if k == 22 {
    moveToward(i, dx, dy, dist, 5)
  } else {
    moveToward(i, dx, dy, dist, 8)
  }
}

fn bossChoose(i) {
  let k = eK[i]
  let n = eA[i]
  eA[i] += 1
  let pick = 4
  if k == 20 {
    pick = 2
    if n % 4 == 2 {
      pick = 5
    }
  } else if k == 21 {
    pick = 4
    if n % 4 == 2 {
      pick = 7
    }
    if n % 4 == 3 {
      pick = 5
    }
  } else if k == 22 {
    pick = 5
    if n % 3 == 1 {
      pick = 4
    }
    if n % 3 == 2 {
      pick = 6
    }
  } else {
    pick = 2
    if n % 5 == 1 {
      pick = 6
    }
    if n % 5 == 2 {
      pick = 4
    }
    if n % 5 == 3 {
      pick = 5
    }
    if n % 5 == 4 {
      pick = 7
    }
  }
  eNx[i] = pick
  eS[i] = 1
  eT[i] = 0
}

fn bossTeleport(i) {
  let k = eK[i]
  burst(eX[i] / 10 + 9, eY[i] / 10 + 6, 14, "#c77dff", 10)
  let tries = 0
  let px = 215
  let py = 66
  let good = false
  while tries < 30 and not good {
    tries += 1
    px = random(2, 16) * 16
    py = random(2, 7) * 16
    good = not blocked(px, py, ew(k), eh(k)) and aimDist(px - hx / 10, py - hy / 10) > 80
  }
  eX[i] = px * 10
  eY[i] = py * 10
  eSp[i] = 22
  eS[i] = 3
  eT[i] = 10
}

fn bossStart(i, st) {
  let k = eK[i]
  let cx = eX[i] / 10 + ew(k) / 2
  let cy = eY[i] / 10 + eh(k) / 2
  let pcx = hx / 10 + 5
  let pcy = hy / 10 + 4
  let dx = pcx - cx
  let dy = pcy - cy
  let dist = max(aimDist(dx, dy), 1)
  let enr = eHp[i] * 2 < eMax[i]
  eS[i] = st
  eT[i] = 0
  if st == 2 {
    eVX[i] = sign(dx) * (abs(dx) * 42 / dist)
    eVY[i] = sign(dy) * (abs(dy) * 42 / dist)
  } else if st == 4 {
    let n = 3
    if enr {
      n = 5
    }
    let ux = sign(0 - dy) * (abs(dy) * 100 / dist)
    let uy = sign(dx) * (abs(dx) * 100 / dist)
    let s = 0
    while s < n {
      let spread = (s * 2 - (n - 1)) * 20
      shootAt(cx, cy, pcx + ux * spread / 100, pcy + uy * spread / 100, 18, 1, 0)
      s += 1
    }
    sound sndHeavy volume 50
    eS[i] = 3
    eT[i] = 15
    if k == 21 {
      bossTeleport(i)
    }
  } else if st == 5 {
    let n = 12
    if enr {
      n = 16
    }
    shootRing(cx, cy, n, 13, random(0, 23), 1, 1)
    shake(3, 12)
    sound sndSlam volume 60
    eS[i] = 3
    eT[i] = 10
    if k == 21 {
      bossTeleport(i)
    }
  } else if st == 7 {
    if length(eK) < 6 {
      let mk = pickKind(depth)
      if k == 21 {
        mk = 2
      }
      spawnRandom(mk, 40)
      spawnRandom(mk, 40)
      sound sndSlam volume 40
    } else {
      shootRing(cx, cy, 12, 13, random(0, 23), 1, 1)
    }
    eS[i] = 3
    eT[i] = 0
  }
}

fn updateBoss(i) {
  let k = eK[i]
  let w = ew(k)
  let h = eh(k)
  let cx = eX[i] / 10 + w / 2
  let cy = eY[i] / 10 + h / 2
  let dx = hx / 10 + 5 - cx
  let dy = hy / 10 + 4 - cy
  let dist = aimDist(dx, dy)
  if dx < 0 {
    eFace[i] = 1
  }
  if dx > 0 {
    eFace[i] = 0
  }
  eT[i] += 1
  let enr = eHp[i] * 2 < eMax[i]
  if enr and not bossRage {
    bossRage = true
    shake(5, 30)
    sound sndSlam volume 70
    popText(cx, cy - 26, "ENRAGED!", "#ff4d6d")
    spawnRandom(pickKind(depth), 40)
    spawnRandom(pickKind(depth), 40)
  }
  let s = eS[i]
  if s == 0 {
    bossMove(i, k, dx, dy, dist)
    let idle = 55
    if enr {
      idle = 32
    }
    if eT[i] >= idle {
      bossChoose(i)
    }
  } else if s == 1 {
    eHit[i] = 2
    let wl = 30
    if enr {
      wl = 20
    }
    if eT[i] >= wl {
      bossStart(i, eNx[i])
    }
  } else if s == 2 {
    let nx = eX[i] + eVX[i]
    let ny = eY[i] + eVY[i]
    let wall = false
    if blocked(nx / 10, eY[i] / 10, w, h) {
      wall = true
    } else {
      eX[i] = nx
    }
    if blocked(eX[i] / 10, ny / 10, w, h) {
      wall = true
    } else {
      eY[i] = ny
    }
    if tick % 4 == 0 {
      burst(cx, cy + 6, 1, "#c9b99a", 4)
    }
    if wall or eT[i] >= 45 {
      if wall {
        shake(5, 16)
        sound sndSlam volume 70
        shootRing(cx, cy, 8, 12, random(0, 23), 1, 0)
      }
      eS[i] = 3
      eT[i] = 0
    }
  } else if s == 3 {
    let rl = 45
    if enr {
      rl = 28
    }
    if eT[i] >= rl {
      eS[i] = 0
      eT[i] = 0
    }
  } else if s == 6 {
    if eT[i] % 5 == 0 {
      let a = eT[i] / 5 * 2
      shoot(cx, cy, comp(cosA(a), 14), comp(sinA(a), 14), 1, 0, 240)
      shoot(cx, cy, comp(cosA(a + 12), 14), comp(sinA(a + 12), 14), 1, 0, 240)
      if enr {
        shoot(cx, cy, comp(cosA(a + 6), 14), comp(sinA(a + 6), 14), 1, 0, 240)
        shoot(cx, cy, comp(cosA(a + 18), 14), comp(sinA(a + 18), 14), 1, 0, 240)
      }
    }
    if eT[i] >= 72 {
      eS[i] = 3
      eT[i] = 0
    }
  }
}

fn updateEnemies() {
  let i = 0
  while i < length(eK) {
    if eHit[i] > 0 {
      eHit[i] -= 1
    }
    if eIm[i] > 0 {
      eIm[i] -= 1
    }
    if eSp[i] > 0 {
      eSp[i] -= 1
    } else {
      if eK[i] >= 20 {
        updateBoss(i)
      } else {
        updateMob(i)
      }
      applyKnock(i)
      touchPlayer(i)
    }
    i += 1
  }
}

// ============================== cards and shop ===========================
fn resetCards() {
  cardLv = []
  repeat 14 {
    add 0 to cardLv
  }
}

fn rollCards() {
  offer = []
  let guard = 0
  while length(offer) < 3 and guard < 300 {
    guard += 1
    let c = random(0, 13)
    if cardLv[c] < cardMaxL[c] and not contains(offer, c) {
      add c to offer
    }
  }
  while length(offer) < 3 {
    add 13 to offer
  }
  pickIdx = 1
  mode = 2
  sound jingleCard volume 60
}

fn applyCard(c) {
  cardLv[c] += 1
  if c == 3 {
    maxHp += 2
    hp = min(hp + 2, maxHp)
  } else if c == 13 {
    hp = min(hp + 4, maxHp)
  } else if c == 6 {
    shield += 1
  }
}

fn giveRandomCard() {
  let guard = 0
  let c = 13
  while guard < 200 {
    guard += 1
    c = random(0, 12)
    if cardLv[c] < cardMaxL[c] {
      guard = 999
    }
  }
  applyCard(c)
  popText(hx / 10 + 5, hy / 10 - 12, cardNames[c], cardCols[c])
}

fn pickCard(n) {
  applyCard(offer[n])
  sound sndBuy volume 60
  burst(160, 90, 24, cardCols[offer[n]], 12)
  mode = 1
  if room == 5 and depth == 4 {
    winRun()
  } else {
    gateOpen = true
    sound sndDoor volume 50
  }
}

fn shopPrice(n) {
  if n == 0 {
    return 4 + depth * 2
  }
  if n == 1 {
    return 10 + depth * 3
  }
  return 14 + depth * 4
}

fn buyShop(n) {
  if n == 3 {
    mode = 1
    gateOpen = true
    sound sndDoor volume 50
    return 0
  }
  if shopSold[n] == 1 or coins < shopPrice(n) {
    sound sndNope volume 50
    return 0
  }
  coins -= shopPrice(n)
  shopSold[n] = 1
  sound sndBuy volume 70
  if n == 0 {
    hp = min(hp + 4, maxHp)
  } else if n == 1 {
    giveRandomCard()
  } else {
    maxHp += 2
    hp = min(hp + 2, maxHp)
  }
}

// ============================== runs =====================================
fn loadMeta() {
  shards = saved("yd_shards", 0)
  bestRooms = saved("yd_best", 0)
  wins = saved("yd_wins", 0)
  let m = saved("yd_meta", [0, 0, 0])
  if length(m) >= 3 {
    metaV = m[0]
    metaM = m[1]
    metaF = m[2]
  }
}

fn saveMeta() {
  save "yd_shards", shards
  save "yd_best", bestRooms
  save "yd_wins", wins
  save "yd_meta", [metaV, metaM, metaF]
}

fn startRun() {
  resetCards()
  depth = 1
  room = 1
  kills = 0
  roomsDone = 0
  bossKills = 0
  coins = metaF * 6
  hintT = 600
  slashN = 0
  heroSlash = 0
  heroBoltDmg = 0
  heroSpeed = 15
  heroDashCd = 55
  maxHp = 10
  maxBolts = 3
  if hero == 1 {
    maxHp = 8
    heroSpeed = 18
    heroDashCd = 38
  }
  if hero == 2 {
    maxHp = 8
    heroSlash = 0 - 1
    heroBoltDmg = 2
    maxBolts = 5
  }
  maxHp += metaV * 2
  hp = maxHp
  bolts = maxBolts
  boltT = 0
  dashCool = 0
  qx = []
  qy = []
  qvx = []
  qvy = []
  ql = []
  qc = []
  tX = []
  tY = []
  tS = []
  tL = []
  tC = []
  gX = []
  gY = []
  gK = []
  gT = []
  mode = 1
  paused = false
  enterRoom()
  playMusic()
}

fn bankRun(won) {
  gainShards = roomsDone + kills / 6 + bossKills * 8
  if won {
    gainShards += 15
  }
  shards += gainShards
  newBest = false
  if roomsDone > bestRooms {
    bestRooms = roomsDone
    newBest = true
  }
  saveMeta()
}

fn dieNow() {
  mode = 3
  deadT = 0
  music off
  sound jingleFallen volume 80
  bankRun(false)
}

fn winRun() {
  mode = 6
  winT = 0
  wins += 1
  bankRun(true)
  playMusic()
}

fn playMusic() {
  if not musicOn {
    music off
  } else if mode == 0 or mode == 4 {
    music songTitle, bassTitle tempo 110
  } else if mode == 6 {
    music songWin, bassWin tempo 120
  } else if mode == 3 {
    music off
  } else if room == 5 {
    music songBoss, bassBoss tempo 170
  } else if depth == 1 {
    music songOne, bassOne tempo 100
  } else if depth == 2 {
    music songTwo, bassTwo tempo 110
  } else if depth == 3 {
    music songThree, bassThree tempo 120
  } else {
    music songFour, bassFour tempo 130
  }
}

// ============================== effects ==================================
fn updateFx() {
  let i = length(qx) - 1
  while i >= 0 {
    qx[i] += qvx[i]
    qy[i] += qvy[i]
    qvx[i] = sdiv(qvx[i] * 9, 10)
    qvy[i] = sdiv(qvy[i] * 9, 10)
    ql[i] -= 1
    if ql[i] <= 0 {
      remove qx[i]
      remove qy[i]
      remove qvx[i]
      remove qvy[i]
      remove ql[i]
      remove qc[i]
    }
    i -= 1
  }
  let g = length(gX) - 1
  while g >= 0 {
    gT[g] += 1
    if gT[g] >= 16 {
      remove gX[g]
      remove gY[g]
      remove gK[g]
      remove gT[g]
    }
    g -= 1
  }
  let n = length(tX) - 1
  while n >= 0 {
    tL[n] -= 1
    if tick % 3 == 0 {
      tY[n] -= 1
    }
    if tL[n] <= 0 {
      remove tX[n]
      remove tY[n]
      remove tS[n]
      remove tL[n]
      remove tC[n]
    }
    n -= 1
  }
}

fn updateGame() {
  updatePlayer()
  updateEnemies()
  updateShots()
  updatePickups()
  updateRoom()
  updateFx()
  if shakeT > 0 {
    shakeT -= 1
    if shakeT == 0 {
      shakeM = 0
    }
  }
  if redT > 0 {
    redT -= 1
  }
  if bannerT > 0 {
    bannerT -= 1
  }
  if hintT > 0 {
    hintT -= 1
  }
  if bossWipe {
    bossWipe = false
    clearEnemies()
    clearShots()
  }
}

// ============================== drawing ==================================
// text: a smooth hi-res pixel font (art/font.png) drawn with the same layout as write
# let __fs = null;
# window.__say = function (t, x, y, c, fl) {
#   const sz = Math.max(1, fl >> 2), center = fl & 1, shadow = fl & 2;
#   if (!__fs) __fs = __sprite(fontPic, 0, 0, 12, 16, 95);
#   const col = c == null ? '#fff' : String(c);
#   String(t).split('\n').forEach((ln, row) => {
#     let px = Math.round(x);
#     if (center) px -= Math.floor((ln.length * 6 - 1) * sz / 2);
#     const py = Math.round(y) + row * 9 * sz;
#     for (let i = 0; i < ln.length; i++) {
#       let k = ln.charCodeAt(i) - 32;
#       if (k < 0 || k > 94) k = 31;
#       if (!k) continue;
#       const gx = px + i * 6 * sz - 6 + 3 * sz, gy = py - 8 + 4 * sz;
#       if (shadow) __draw(__fs, gx + sz, gy + sz, k, false, 0, 1, null, false, '#000', false, 50 * sz);
#       __draw(__fs, gx, gy, k, false, 0, 1, null, false, col, false, 50 * sz);
#     }
#   });
# };
fn say(msg, x, y, col, fl) {
  # window.__say(msg, x, y, col, fl)
}

// the three heroes come from a hi-res pack: 80x80 frames drawn at scale 50, so one
// picture pixel is one real screen pixel (the screen is 640x360, the game thinks in 320x180)
let hIdleN = [6, 6, 8]
let hRunN = [8, 8, 8]
let hAtkN = [6, 6, 10]
let hHurtN = [3, 3, 2]
let hDeadN = [6, 6, 10]

// fx, fy = where the feet touch the ground. st: 0 idle, 1 run, 2 slash, 3 hurt, 4 down.
// big = 1 draws it twice as large (title and end screens)
fn drawHeroAt(h, fx, fy, st, lookL, a, big) {
  let sc = 50
  let y = fy - 60
  if big > 0 {
    sc = 100
    y = fy - 80
  }
  let x = fx - 40
  let f = 0
  if st == 0 {
    f = (tick / 7) % hIdleN[h]
    if h == 0 {
      draw h0Idle at x, y frame f flip lookL alpha a scale sc
    } else if h == 1 {
      draw h1Idle at x, y frame f flip lookL alpha a scale sc
    } else {
      draw h2Idle at x, y frame f flip lookL alpha a scale sc
    }
  } else if st == 1 {
    f = (tick / 4) % hRunN[h]
    if h == 0 {
      draw h0Run at x, y frame f flip lookL alpha a scale sc
    } else if h == 1 {
      draw h1Run at x, y frame f flip lookL alpha a scale sc
    } else {
      draw h2Run at x, y frame f flip lookL alpha a scale sc
    }
  } else if st == 2 {
    f = (12 - atkT) * hAtkN[h] / 12
    if f >= hAtkN[h] {
      f = hAtkN[h] - 1
    }
    if h == 0 {
      draw h0Atk at x, y frame f flip lookL alpha a scale sc
    } else if h == 1 {
      draw h1Atk at x, y frame f flip lookL alpha a scale sc
    } else {
      draw h2Atk at x, y frame f flip lookL alpha a scale sc
    }
  } else if st == 3 {
    f = (tick / 5) % hHurtN[h]
    if h == 0 {
      draw h0Hurt at x, y frame f flip lookL alpha a scale sc
    } else if h == 1 {
      draw h1Hurt at x, y frame f flip lookL alpha a scale sc
    } else {
      draw h2Hurt at x, y frame f flip lookL alpha a scale sc
    }
  } else {
    f = hDeadN[h] - 1
    if h == 0 {
      draw h0Dead at x, y frame f flip lookL alpha a scale sc
    } else if h == 1 {
      draw h1Dead at x, y frame f flip lookL alpha a scale sc
    } else {
      draw h2Dead at x, y frame f flip lookL alpha a scale sc
    }
  }
}

fn drawRoom() {
  let ty = 0
  while ty < 10 {
    let tx = 0
    while tx < 20 {
      let c = cells[ty * 20 + tx]
      let px = tx * 16
      let py = ty * 16
      if c == 1 {
        if ty == 0 {
          draw wallFace at px - 8, py - 8 scale 50
        } else {
          draw wallTop at px - 8, py - 8 scale 50
        }
      } else {
        let fv = (tx * 7 + ty * 13) % 3
        if depth == 2 {
          draw floorB at px - 8, py - 8 frame fv scale 50
        } else if depth == 4 {
          draw floorD at px - 8, py - 8 frame fv scale 50
        } else if depth == 3 {
          draw floorC at px - 8, py - 8 frame fv % 2 scale 50
        } else {
          draw floorA at px - 8, py - 8 frame fv scale 50
        }
        if c == 2 {
          if depth == 1 {
            draw crate at px - 8, py - 6 - 11 scale 50
          } else if depth == 2 {
            draw skull at px - 8, py - 8 scale 50
          } else if depth == 3 {
            draw basin at px - 8, py - 8 frame (tick / 12) % 3 scale 50
          } else {
            draw fountain at px - 8, py - 8 frame (tick / 12) % 3 scale 50
          }
        }
        if c == 4 and not gateOpen {
          box px + 3, py, 10, 16 color "#7a1f3d"
          box px + 5, py, 2, 16 color "#ff7aa2"
          box px + 9, py, 2, 16 color "#c0396b"
        }
      }
      tx += 1
    }
    ty += 1
  }
  // the door you came through, and a glowing portal once the way is open
  box 0, 64, 6, 32 color "#2b1840"
  box 0, 64, 2, 32 color "#6b3fa0"
  if gateOpen {
    draw fxVortex at 296 - 32, 80 - 32 tint "#ffd23f" alpha 65 scale 70 angle tick * 4 glow
  }
  // a faint colour wash gives every floor its own mood
  if depth == 1 {
    box 0, 0, 320, 160 color "#20ff8012"
  } else if depth == 2 {
    box 0, 0, 320, 160 color "#6040ff18"
  } else if depth == 3 {
    box 0, 0, 320, 160 color "#ff204018"
  } else {
    box 0, 0, 320, 160 color "#ffd23014"
  }
}

fn drawMob(i) {
  let k = eK[i]
  let w = ew(k)
  let h = eh(k)
  let cx = eX[i] / 10 + w / 2
  let by = eY[i] / 10 + h
  let f = (tick / 6 + i) % 4
  let fl = eHit[i] > 0
  let lk = eFace[i] == 1
  let a = 100
  if eSp[i] > 0 {
    a = 25 + (tick % 4) * 8
    draw mRing at cx - 36, by - 44 frame tick / 4 alpha 80 scale 50
  }
  box cx - w / 2, by - 2, w, 3 color "#00000050"
  if k == 0 {
    draw slime at cx - 8 - 8, by - 15 - 8 frame f flip lk flash fl alpha a scale 50
  } else if k == 1 {
    draw goblinRun at cx - 8 - 8, by - 11 - 5 frame f flip lk flash fl alpha a scale 50
  } else if k == 2 {
    draw e1Run at cx - 24, by - 36 frame tick / 4 + i flip lk flash fl alpha a scale 50
  } else if k == 3 {
    draw impRun at cx - 8 - 8, by - 15 - 8 frame f flip lk flash fl alpha a scale 50
  } else if k == 4 {
    draw e0Run at cx - 24, by - 36 frame tick / 4 + i flip lk flash fl alpha a scale 50
  } else if k == 5 {
    if eS[i] == 2 {
      draw orcRun at cx - 8 - 8, by - 19 - 10 frame f flip lk flash fl alpha a scale 50
    } else {
      draw orcIdle at cx - 8 - 8, by - 19 - 10 frame f flip lk flash fl alpha a scale 50
    }
  } else if k == 6 {
    draw e2Run at cx - 32, by - 48 frame tick / 4 + i flip lk flash fl alpha a scale 50
  } else if k == 7 {
    draw angelRun at cx - 8 - 8, by - 15 - 3 + (tick / 10) % 2 - 8 frame f flip lk flash fl alpha a scale 50
  } else if k == 20 {
    if eS[i] == 0 or eS[i] == 2 {
      draw ogreRun at cx - 16 - 16, by - 30 - 16 frame f flip lk flash fl alpha a scale 50
    } else {
      draw ogreIdle at cx - 16 - 16, by - 30 - 16 frame f flip lk flash fl alpha a scale 50
    }
  } else if k == 21 {
    draw necro at cx - 16, by - 38 frame f flip lk flash fl alpha a scale 100
  } else if k == 22 {
    if eS[i] == 0 {
      draw wardenRun at cx - 16 - 16, by - 32 - 17 frame f flip lk flash fl alpha a scale 50
    } else {
      draw wardenIdle at cx - 16 - 16, by - 32 - 17 frame f flip lk flash fl alpha a scale 50
    }
  } else {
    if eS[i] == 0 or eS[i] == 2 {
      draw kingRun at cx - 16 - 16, by - 34 - 18 frame f flip lk flash fl alpha a scale 50
    } else {
      draw kingIdle at cx - 16 - 16, by - 34 - 18 frame f flip lk flash fl alpha a scale 50
    }
  }
}

fn drawPlayer() {
  let pcx = hx / 10 + 5
  let by = hy / 10 + 8
  let a = 100
  if hitT > 0 and (tick / 3) % 2 == 0 {
    a = 35
  }
  box pcx - 5, by - 2, 10, 3 color "#00000050"
  let st = 0
  if hitT > 40 {
    st = 3
  } else if atkT > 0 {
    st = 2
  } else if moving or dashT > 0 {
    st = 1
  }
  drawHeroAt(hero, pcx, by, st, faceLeft, a, 0)
  if shield > 0 {
    draw fxCircle at pcx - 32, by - 11 - 32 tint "#9bd3ff" alpha 22 scale 45 angle tick * 2 glow
  }
  if atkT > 1 {
    let sx = pcx + aimX * 13
    let sy = hy / 10 + 4 + aimY * 13
    draw mSlash at sx - 36, sy - 36 frame min(5, max(2, 2 + (12 - atkT) / 3)) angle (1035 - slashAngle()) % 360 tint "#ffc2e0" alpha 85 scale 50
  }
  let o = 0
  while o < cardLv[8] {
    let ang = tick / 3 + o * 24 / cardLv[8]
    let ox = pcx + comp(cosA(ang), 24)
    let oy = hy / 10 + 4 + comp(sinA(ang), 24)
    box ox - 3, oy - 3, 6, 6 color "#ff9ad5"
    box ox - 1, oy - 1, 2, 2 color "#ffffff"
    draw fxGlow at ox - 32, oy - 32 tint "#ff9ad5" alpha 30 scale 30 glow
    o += 1
  }
}

fn drawActors() {
  let py = hy / 10 + 8
  let i = 0
  while i < length(eK) {
    if eY[i] / 10 + eh(eK[i]) <= py {
      drawMob(i)
    }
    i += 1
  }
  drawPlayer()
  i = 0
  while i < length(eK) {
    if eY[i] / 10 + eh(eK[i]) > py {
      drawMob(i)
    }
    i += 1
  }
}

fn drawLoot() {
  let i = 0
  while i < length(oX) {
    let px = oX[i] / 10
    let py = oY[i] / 10
    if oK[i] == 0 {
      draw coin at px - 4 - 4, py - 4 - 4 frame (tick / 6 + i) % 4 scale 50
    } else {
      draw heart at px - 8 - 8, py - 10 - (tick / 8) % 2 - 8 frame 0 scale 50
    }
    i += 1
  }
}

fn drawShots() {
  let i = 0
  while i < length(pX) {
    let px = pX[i] / 10
    let py = pY[i] / 10
    if pOwn[i] == 1 {
      box px - 3, py - 3, 6, 6 color "#7be0ff"
      box px - 1, py - 1, 2, 2 color "#ffffff"
    } else if pKind[i] == 1 {
      box px - 4, py - 4, 8, 8 color "#ff4d6d"
      box px - 2, py - 2, 4, 4 color "#ffe0e8"
    } else {
      box px - 3, py - 3, 6, 6 color "#ff6a3d"
      box px - 1, py - 1, 2, 2 color "#fff1b8"
    }
    i += 1
  }
}

fn drawFx() {
  let i = 0
  while i < length(gX) {
    let f = gT[i] / 2
    if gK[i] == 0 {
      draw mHit at gX[i] - 36, gY[i] - 36 frame f alpha 100 scale 50
    } else if gK[i] == 1 {
      draw mPuff at gX[i] - 36, gY[i] - 36 frame f tint "#ffe3c0" alpha 55 scale 50
    } else {
      draw mHeart at gX[i] - 36, gY[i] - 44 frame f alpha 100 scale 100
    }
    i += 1
  }
}

fn drawParticles() {
  let i = 0
  while i < length(qx) {
    box qx[i] / 10, qy[i] / 10, 2, 2 color qc[i]
    i += 1
  }
  let n = 0
  while n < length(tX) {
    say(tS[n], tX[n], tY[n], tC[n], 7)
    n += 1
  }
}

fn drawBossBar() {
  let i = 0
  while i < length(eK) {
    if eK[i] >= 20 {
      let name = bossNames[eK[i] - 20]
      say(name, 160, 141, "#ffd9e2", 7)
      draw uiBoss at 64 - 96, 153 - 8 scale 50
      box 69, 157, 182, 8 color "#05040a"
      box 70, 158, 180, 6 color "#3a0f1c"
      box 70, 158, 180 * max(eHp[i], 0) / eMax[i], 6 color "#ff4d6d"
    }
    i += 1
  }
}

fn drawHud() {
  draw uiHud at 0 - 160, 0 - 10 scale 50
  let nh = maxHp / 2
  let sp = min(14, 140 / nh)
  let k = 0
  while k < nh {
    let v = hp - k * 2
    let pic = 2
    if v >= 2 {
      pic = 0
    } else if v == 1 {
      pic = 1
    }
    draw uiHeart at 4 + k * sp - 6, 4 - 5 frame pic scale 50
    k += 1
  }
  draw coin at 156 - 4, 7 - 4 frame (tick / 6) % 4 scale 50
  say("x" + text(coins), 166, 7, "#ffe66d", 6)
  // spirit bolt charges
  let b = 0
  while b < maxBolts {
    if b < bolts {
      draw uiOrb at 200 + b * 7 - 3, 6 - 4 frame 0 scale 50
    } else {
      draw uiOrb at 200 + b * 7 - 3, 6 - 4 frame 1 scale 50
    }
    b += 1
  }
  // dash meter
  draw uiDash at 243 - 13, 7 - 3 scale 50
  box 244, 8, 22, 5 color "#1d1730"
  let dfill = 22
  if dashCool > 0 {
    dfill = 22 - 22 * dashCool / max(heroDashCd, 1)
  }
  box 244, 8, max(dfill, 0), 5 color "#9bd3ff"
  say("F" + text(depth) + "-" + text(room), 282, 7, "#d9d4e8", 6)
  if hintT > 0 and depth == 1 and room < 3 and mode == 1 {
    say("Z slash   X bolt   C dash", 160, 168, "#d9d4e8", 7)
  }
}

fn drawCards() {
  box 0, 0, 320, 180 color "#05040acc"
  say("CHOOSE A BLESSING", 160, 12, "#ffd23f", 11)
  let n = 0
  while n < 3 {
    let c = offer[n]
    let x0 = 16 + n * 100
    if n == pickIdx {
      draw uiCardSel at x0 - 3 - 49, 31 - 59 scale 50
    }
    draw uiCard at x0 - 46, 34 - 56 scale 50
    box x0 + 4, 38, 84, 14 color cardCols[c]
    say(cardNames[c], x0 + 46, 42, "#10101a", 5)
    say(cardDescs[c], x0 + 9, 62, "#d9d4e8", 4)
    if c != 13 {
      say("Lv " + text(cardLv[c]) + " > " + text(cardLv[c] + 1), x0 + 46, 128, cardCols[c], 5)
    } else {
      say("One time", x0 + 46, 128, cardCols[c], 5)
    }
    say(text(n + 1), x0 + 80, 134, "#8a84a3", 4)
    n += 1
  }
  say("arrows + Z   or press 1 2 3", 160, 160, "#8a84a3", 5)
}

fn drawShop() {
  box 0, 0, 320, 180 color "#05040acc"
  say("TRAVELING MERCHANT", 160, 10, "#ffd23f", 11)
  draw lizardIdle at 144, 36 frame (tick / 8) % 4 scale 100
  say("Spend your coins, traveler.", 160, 76, "#d9d4e8", 5)
  let n = 0
  while n < 4 {
    let x0 = 14 + n * 76
    if n == shopIdx {
      draw uiShopSel at x0 - 3 - 36, 87 - 31 scale 50
    }
    draw uiShop at x0 - 33, 90 - 28 scale 50
    if n == 0 {
      say("Rice Ball", x0 + 33, 95, "#ffb3c7", 5)
      say("Heal 4 HP", x0 + 33, 112, "#d9d4e8", 5)
    } else if n == 1 {
      say("New Card", x0 + 33, 95, "#c77dff", 5)
      say("A random\nblessing", x0 + 33, 110, "#d9d4e8", 5)
    } else if n == 2 {
      say("Sake Gourd", x0 + 33, 95, "#7ee787", 5)
      say("+2 max HP", x0 + 33, 112, "#d9d4e8", 5)
    } else {
      say("Leave", x0 + 33, 112, "#ff9ab0", 5)
    }
    if n < 3 {
      if shopSold[n] == 1 {
        say("SOLD", x0 + 33, 130, "#8a84a3", 5)
      } else {
        let pc = "#ffe66d"
        if coins < shopPrice(n) {
          pc = "#8a5a5a"
        }
        say(text(shopPrice(n)) + " coins", x0 + 33, 130, pc, 5)
      }
    }
    n += 1
  }
  say("You have " + text(coins) + " coins", 160, 158, "#ffe66d", 5)
  say("arrows + Z to buy", 160, 168, "#8a84a3", 5)
}

fn drawPause() {
  box 0, 22, 320, 158 color "#05040aa0"
  draw uiDlg at 10 - 150, 24 - 75 scale 50
  say("PAUSED", 160, 30, "#ffd23f", 11)
  say("Your blessings", 160, 50, "#d9d4e8", 5)
  let shown = 0
  let c = 0
  while c < 14 {
    if cardLv[c] > 0 {
      let col = shown / 7
      let row = shown % 7
      let label = cardNames[c]
      if c != 13 {
        label = label + " x" + text(cardLv[c])
      }
      say(label, 28 + col * 148, 66 + row * 12, cardCols[c], 4)
      shown += 1
    }
    c += 1
  }
  if shown == 0 {
    say("None yet. Clear a room to earn one.", 160, 90, "#8a84a3", 5)
  }
  say("P or Esc to continue   M music", 160, 168, "#8a84a3", 5)
}

fn drawTitle() {
  paint "#0d0a14"
  let n = 0
  while n < 26 {
    let px = (n * 53 + tick * (1 + n % 3) / 3) % 340 - 10
    let py = (n * 29 + tick * (1 + n % 2) / 2) % 190 - 5
    box px, py, 2, 2 color "#ff9ad5"
    n += 1
  }
  say("YOKAI", 160, 2, "#ff7aa2", 15)
  say("DESCENT", 160, 28, "#ffd23f", 15)
  drawHeroAt(hero, 160, 106, 0, false, 100, 1)
  say("<", 106, 82, "#d9d4e8", 8)
  say(">", 206, 82, "#d9d4e8", 8)
  draw uiTitleBox at 50 - 110, 108 - 23 scale 50
  say(heroNames[hero], 160, 114, "#ffd23f", 7)
  say(heroPerks[hero], 160, 126, "#d9d4e8", 5)
  say("Z descend    C shrine    M music", 160, 158, "#8a84a3", 5)
  say("Best: " + text(bestRooms) + " rooms   Victories: " + text(wins) + "   Shards: " + text(shards), 160, 169, "#7be0ff", 5)
}

fn drawShrine() {
  paint "#0d0a14"
  let n = 0
  while n < 14 {
    let px = (n * 71 + tick / 2) % 340 - 10
    let py = (n * 37 + tick) % 190 - 5
    box px, py, 2, 2 color "#ff9ad5"
    n += 1
  }
  say("SHRINE OF SPIRITS", 160, 12, "#ffd23f", 11)
  say("Spirit shards: " + text(shards), 160, 36, "#7be0ff", 5)
  let r = 0
  while r < 3 {
    let lv = metaV
    if r == 1 {
      lv = metaM
    } else if r == 2 {
      lv = metaF
    }
    let y0 = 54 + r * 34
    if r == shrineIdx {
      draw uiRowSel at 21 - 139, y0 - 4 - 16 scale 50
    }
    draw uiRow at 24 - 136, y0 - 1 - 13 scale 50
    say(metaNames[r], 32, y0 + 2, "#ffd9e2", 4)
    say(metaInfo[r], 32, y0 + 13, "#8a84a3", 4)
    let pip = 0
    while pip < 3 {
      if pip < lv {
        box 190 + pip * 12, y0 + 3, 9, 9 color "#c0396b"
      } else {
        box 190 + pip * 12, y0 + 3, 9, 9 color "#4a3a66"
      }
      pip += 1
    }
    if lv >= 3 {
      say("MAX", 270, y0 + 13, "#7ee787", 4)
    } else {
      let cost = (lv + 1) * metaBase[r]
      let cc = "#ffe66d"
      if shards < cost {
        cc = "#8a5a5a"
      }
      say(text(cost) + " shards", 238, y0 + 13, cc, 4)
    }
    r += 1
  }
  say("Up/Down pick   Z buy   X back", 160, 164, "#8a84a3", 5)
}

fn drawDead() {
  box 0, 0, 320, 180 color "#05040ad0"
  draw uiDlgTall at 10 - 150, 8 - 82 scale 50
  say("YOU HAVE FALLEN", 160, 26, "#ff4d6d", 11)
  drawHeroAt(hero, 252, 128, 4, false, 100, 0)
  say("Floor " + text(depth) + ", room " + text(room), 160, 52, "#d9d4e8", 5)
  say("Rooms cleared: " + text(roomsDone), 160, 70, "#d9d4e8", 5)
  say("Foes slain: " + text(kills), 160, 82, "#d9d4e8", 5)
  say("Bosses felled: " + text(bossKills), 160, 94, "#d9d4e8", 5)
  say("+" + text(gainShards) + " spirit shards", 160, 114, "#7be0ff", 5)
  if newBest {
    say("NEW BEST!", 160, 130, "#ffd23f", 7)
  }
}

fn drawWin() {
  paint "#0d0a14"
  let n = 0
  while n < 40 {
    let px = (n * 47 + tick * (1 + n % 3) / 2) % 330 - 5
    let py = (n * 31 + tick * (1 + n % 4)) % 190 - 5
    let cols = ["#ff9ad5", "#ffd23f", "#7be0ff", "#7ee787"]
    box px, py, 3, 3 color cols[n % 4]
    n += 1
  }
  draw uiDlgTall at 10 - 150, 8 - 82 scale 50
  say("THE ONI KING FALLS", 160, 22, "#ffd23f", 11)
  say("The way home is open at last.", 160, 46, "#d9d4e8", 5)
  drawHeroAt(hero, 160, 106, 0, false, 100, 1)
  say("Rooms cleared: " + text(roomsDone), 160, 112, "#d9d4e8", 5)
  say("Foes slain: " + text(kills), 160, 124, "#d9d4e8", 5)
  say("+" + text(gainShards) + " spirit shards", 160, 142, "#7be0ff", 5)
  say("Press Z", 160, 164, "#8a84a3", 5)
}

fn drawGame() {
  paint "#0b0912"
  let sx = 0
  let sy = 0
  if shakeT > 0 and shakeM > 0 {
    sx = random(0 - shakeM, shakeM)
    sy = random(0 - shakeM, shakeM)
  }
  camera sx, sy - 20
  drawRoom()
  drawLoot()
  drawActors()
  drawShots()
  drawFx()
  drawParticles()
  camera 0, 0
  drawBossBar()
  if redT > 0 {
    box 0, 20, 320, 160 color "#ff102030"
  }
  drawHud()
  if bannerT > 0 {
    draw uiBanner at 75 - 85, 50 - 21 scale 50
    say(bannerA, 160, 56, "#ffd23f", 11)
    say(bannerB, 160, 76, "#d9d4e8", 7)
  }
}

// ============================== input ====================================
fn pressOk() {
  if mode == 0 {
    startRun()
  } else if mode == 2 {
    pickCard(pickIdx)
  } else if mode == 3 {
    if deadT > 50 {
      mode = 0
      playMusic()
    }
  } else if mode == 4 {
    let lv = metaV
    if shrineIdx == 1 {
      lv = metaM
    } else if shrineIdx == 2 {
      lv = metaF
    }
    let cost = (lv + 1) * metaBase[shrineIdx]
    if lv < 3 and shards >= cost {
      shards -= cost
      if shrineIdx == 0 {
        metaV += 1
      } else if shrineIdx == 1 {
        metaM += 1
      } else {
        metaF += 1
      }
      sound sndBuy volume 70
      saveMeta()
    } else {
      sound sndNope volume 50
    }
  } else if mode == 5 {
    buyShop(shopIdx)
  } else if mode == 6 {
    if winT > 60 {
      mode = 0
      playMusic()
    }
  }
}

fn pressLeft() {
  if mode == 0 {
    hero = (hero + 2) % 3
    sound sndTick volume 40
  } else if mode == 2 {
    pickIdx = (pickIdx + 2) % 3
    sound sndTick volume 40
  } else if mode == 5 {
    shopIdx = (shopIdx + 3) % 4
    sound sndTick volume 40
  }
}

fn pressRight() {
  if mode == 0 {
    hero = (hero + 1) % 3
    sound sndTick volume 40
  } else if mode == 2 {
    pickIdx = (pickIdx + 1) % 3
    sound sndTick volume 40
  } else if mode == 5 {
    shopIdx = (shopIdx + 1) % 4
    sound sndTick volume 40
  }
}

fn pressUp() {
  if mode == 4 {
    shrineIdx = (shrineIdx + 2) % 3
    sound sndTick volume 40
  }
}

fn pressDown() {
  if mode == 4 {
    shrineIdx = (shrineIdx + 1) % 3
    sound sndTick volume 40
  }
}

fn pressC() {
  if mode == 0 {
    mode = 4
    shrineIdx = 0
    sound sndSwitch volume 50
  } else {
    doDash()
  }
}

fn pressBack() {
  if mode == 4 {
    mode = 0
    sound sndSwitch volume 50
  }
}

fn pressEsc() {
  if mode == 1 {
    paused = not paused
  } else if mode == 4 {
    mode = 0
  }
}

fn pressNum(n) {
  if mode == 2 {
    pickIdx = n
    pickCard(n)
  } else if mode == 5 {
    shopIdx = n
    buyShop(n)
  }
}

when key "z" pressed {
  pressOk()
}
when key "space" pressed {
  pressOk()
}
when key "enter" pressed {
  pressOk()
}
when key "left" pressed {
  pressLeft()
}
when key "a" pressed {
  pressLeft()
}
when key "right" pressed {
  pressRight()
}
when key "d" pressed {
  pressRight()
}
when key "up" pressed {
  pressUp()
}
when key "w" pressed {
  pressUp()
}
when key "down" pressed {
  pressDown()
}
when key "s" pressed {
  pressDown()
}
when key "c" pressed {
  pressC()
}
when key "shift" pressed {
  doDash()
}
when key "x" pressed {
  pressBack()
}
when key "escape" pressed {
  pressEsc()
}
when key "p" pressed {
  pressEsc()
}
when key "m" pressed {
  musicOn = not musicOn
  playMusic()
}
when key "1" pressed {
  pressNum(0)
}
when key "2" pressed {
  pressNum(1)
}
when key "3" pressed {
  pressNum(2)
}

// ============================== main loop ================================
loadMeta()
resetCards()
buildRoom()

every frame {
  tick += 1
  if mode == 0 {
    drawTitle()
  } else if mode == 4 {
    drawShrine()
  } else if mode == 6 {
    winT += 1
    updateFx()
    drawWin()
  } else {
    if mode == 1 and not paused {
      if freeze > 0 {
        freeze -= 1
      } else {
        updateGame()
      }
    }
    if mode == 3 {
      deadT += 1
      updateFx()
    }
    drawGame()
    if mode == 2 {
      drawCards()
    } else if mode == 5 {
      drawShop()
    } else if mode == 3 {
      if deadT > 40 {
        drawDead()
        say("Press Z", 160, 160, "#8a84a3", 5)
      }
    } else if paused {
      drawPause()
    }
  }
}

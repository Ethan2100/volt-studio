#js

// Decimals work in #python, #ruby, #js and #html (not yet on boards).
// Whole-number division still rounds down, same as always - only an
// expression that actually involves a decimal divides for real.

let price = 19.99
let share = price / 2
print "Splitting the bill: " + text(share) + " each"

let whole = 7 / 2
print "7 / 2 is still " + text(whole) + " (no decimal involved)"

let tax = price * 0.16
print "16% tax: " + text(tax)
